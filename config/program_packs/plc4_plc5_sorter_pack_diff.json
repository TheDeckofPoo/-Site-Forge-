      "id": "expand_tracking_paths",
      "rule": "FOR EACH tracking conveyor/path emit Track_Conv_UDT + TRK_Pointer + Track_Package search/transfer cluster + Lost_Package path",
      "explains": ["Track_Pointer 1→5", "Track_Package 2→14", "Track_Lost_Package 1→5", "Track_Conv_UDT 1→5"]
    },
    {
      "id": "expand_diverts",
      "rule": "FOR EACH divert instance in SorterModel.divert_instances emit Track_Divert_UDT + Track_Divert_AOI + Wave + RateLimit + LaneStatus map + OffsetFind shell",
      "explains": ["Track_Divert_Package 3→48", "Wave_Divert 1→16", "Divert_Rate_Limit 3→18", "Divert_Lane_Status 7→56", "Track_Offset_Find 5→24"],
      "forbidden": "hardcoded divert_count=32 or divert_count=16"
    },
    {
      "id": "expand_scan_groups",
      "rule": "FOR EACH scan/decision group emit Token_SCN* + Track_Group_SCN* + Scanner handshake tags",
