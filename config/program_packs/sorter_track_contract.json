    "tracking_paths": {
      "rule": "FOR EACH tracking conveyor/path emit Track_Conv_UDT + TRK_Pointer + Track_Package search/transfer instances",
      "never_hardcode": true
    },
    "induct_points": {
      "rule": "FOR EACH induct/decision point emit Track_Induct_UDT + token generate/update",
      "oracle_note": "Both PLC4/PLC5 finished oracles show a single primary induct UDT"
    },
    "scan_groups": {
      "rule": "FOR EACH scan/decision group emit Token_SCN* + Track_Group_SCN* + Scanner handshake tags",
      "oracle_note": "Both oracles show one primary Token_SCN / Track_Group pair"
    },
    "exit_paths": {
      "rule": "FOR EACH exit lost-detect path emit TRK_Lost_Package + WCS token latch pair"
    },
    "divert_instances": {
      "rule": "FOR EACH divert instance in SorterModel.divert_instances (IO/config approved) emit Track_Divert_UDT + AOI + Wave + RateLimit + LaneStatus + OffsetFind shell",
      "forbidden": [
        "hardcode 32",
        "hardcode 16",
        "blind emit one UDT per raw SrtZoneLane row without approval"
      ],
      "oracle_warning": "PLC5 RUN zone_lane_rows=32 but finished Track_Divert_UDT=16"
    }
  },
