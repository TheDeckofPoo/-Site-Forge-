#!/bin/sh
#
# Add a Column to each of the designated files
#
if test $# -lt 1
then
echo "**********************************************************"
echo "*                                                        *"
echo "*  Add a Column to Ascii Files                           *"
echo "*                                                        *"
echo "*  Useage: AddColumn CpuName                             *"
echo "*                                                        *"
echo "*  Example: AddColumn CP1                                *"
echo "*                                                        *"
echo "**********************************************************"
echo
exit
fi
###############################################################
#                                                             #
# Add a column to the Configio Menu, if needed                #
#                                                             #
###############################################################
MenuName="FORTNA/Configio"
FirstColumn="\"Bank\""
NotUsedString="0"

FileName="$MenuName.asc.$1"

if test -f $FileName
then
  FileFnd=1
else
  FileName="$MenuName.asc"
  if test -f $FileName
  then
    FileFnd=1
  else
    FileFnd=0
  fi
fi

if test FileFnd -eq 1
then
  #
  # Check if Menu already has enough columns
  #
  awk -F "[,~]" '{if ($1==firstcolumn) {exit(1);}
              else {exit(0);}
              }' firstcolumn="$FirstColumn" $FileName
  Rtn=$?

  if test $Rtn -eq 1
  then
	FileUpdate=1
  else
	FileUpdate=0
  fi
fi

if test FileUpdate -gt 0
then
  #
  # Add a column to File, it needs a Description Column
  #
  CommaPresent=`head -1 $FileName | grep "," | wc -l`
  TildePresent=`head -1 $FileName | grep "~" | wc -l`
  if test $CommaPresent -gt $TildePresent
  then
    HeaderSep=","
  else
    HeaderSep="~"
  fi
  (
  awk -F "~" '(x==0) {printf "\"Desc\"%s%s\n",headersep,$0;}
              (x==1) {printf "N/A~%s\n",$0;}
              ($2!=notusedstring && x>1 && NF>1) {printf "Row %d~%s\n",x-1,$0;}
 			  ($2==notusedstring && x>1 && NF>1) {printf " ~%s\n",$0;}
 			  (x>1 && NF<=1) {printf "%s\n",$0;}
			  {x=x+1}' notusedstring="$NotUsedString" headersep="$HeaderSep" $FileName
  ) > "$MenuName.tmp"
  #
  # Replace the old File with the new file
  #
  mv $FileName $FileName.old
  mv $MenuName.tmp $FileName
  echo
  echo $FileName updated
  echo 
else
  echo
  if test FileFnd -eq 1
  then
    echo $FileName file already updated
  else
    echo $FileName file not found
  fi
  echo 
fi
