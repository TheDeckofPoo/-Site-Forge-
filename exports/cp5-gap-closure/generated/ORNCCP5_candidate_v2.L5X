<Description>
<![CDATA[Additional PE on Conveyor Name (like Induct PE, Entry PE, Jam PE)]]>
</Description>
</Parameter>
<Parameter Name="I_Conv_Type" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[0 = Transport Conv with VFD
1 = Accum. Conv with VFD
2 = Transport Conv with MS
3 = Accum. Conv with MS]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
