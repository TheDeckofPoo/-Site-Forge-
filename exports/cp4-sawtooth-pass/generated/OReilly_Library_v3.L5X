<Routine Name="DeviceInfo" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[EQU(ReadIO,ReadIO)EQU(MaxDeviceRead,MaxDeviceRead)NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(StartReadingDeviceInfo)JMP(End_DeviceReading);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQU(ReadIO,1)[ONS(DeviceInfo_ONS1.1) MOV(0,IODevice_Status) ,Slow_IODeviceInfo(IODeviceInfo_AOI,P1000_VFD,GET_Firmware,GET_MACID,P1000_VFD.IP_Address,IODevice_Status) [XIC(IODeviceInfo_AOI.M_Firmware_Success) ,XIC(IODeviceInfo_AOI.M_Firmware_Failed) ] [XIC(IODeviceInfo_AOI.M_MACID_Success) ,XIC(IODeviceInfo_AOI.M_MACID_Failed) ] Slow_IODeviceCalc(IODeviceCalc_AOI,IODevice_Status,Firmware_Bytes,MACID_Bytes,P1000_VFD.MACId,P1000_VFD.Firmware) ADD(ReadIO,1,ReadIO) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(ReadIO,2)[ONS(DeviceInfo_ONS1.1) MOV(0,IODevice_Status) ,Slow_IODeviceInfo(IODeviceInfo_AOI,P2000_VFD,GET_Firmware,GET_MACID,P2000_VFD.IP_Address,IODevice_Status) [XIC(IODeviceInfo_AOI.M_Firmware_Success) ,XIC(IODeviceInfo_AOI.M_Firmware_Failed) ] [XIC(IODeviceInfo_AOI.M_MACID_Success) ,XIC(IODeviceInfo_AOI.M_MACID_Failed) ] Slow_IODeviceCalc(IODeviceCalc_AOI,IODevice_Status,Firmware_Bytes,MACID_Bytes,P2000_VFD.MACId,P2000_VFD.Firmware) ADD(ReadIO,2,ReadIO) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GRT(ReadIO,MaxDeviceRead)OTU(StartReadingDeviceInfo)MOV(1,ReadIO);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[LBL(End_DeviceReading)NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="GSV_Communication" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[/*--------------------------------------------------------------------------------------------------------]]>
</Line>
<Line Number="1">
<![CDATA[Get The Status Each VFD/FIO Module (1 Per Scan)]]>
</Line>
<Line Number="2">
<![CDATA[----------------------------------------------------------------------------------------------------------]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[----------------------------------------------------------------------------------------------------------]]>
</Line>
<Line Number="7">
<![CDATA[16#0000 -> 0000 (DINT)]]>
</Line>
<Line Number="8">
<![CDATA[Standby: the controller is powering up.]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[16#1000 -> 4096 (DINT)]]>
</Line>
<Line Number="13">
<![CDATA[Faulted: any of the MODULE object’s connections to the associated module fail. This value should not be used to determine if the module failed because the MODULE object leaves this state periodically when trying to reconnect to the module. Instead, test for Running state (16#4000). Check for FaultCode not equal to 0 to determine if a module is faulted. When Faulted, the FaultCode and FaultInfo attributes are valid until the fault condition is corrected.]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[16#2000 -> 8192 (DINT)]]>
</Line>
<Line Number="18">
<![CDATA[Validating: the MODULE object is verifying MODULE object integrity prior to establishing connections to the module.]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[16#3000 -> 12288 (DINT)]]>
</Line>
<Line Number="23">
<![CDATA[Connecting: the MODULE object is initiating connections to the module.]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[16#4000 -> 16384 (DINT)]]>
</Line>
<Line Number="28">
<![CDATA[Running: all connections to the module are established and data is successfully transferring.]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[16#5000 -> 20480 (DINT)]]>
</Line>
<Line Number="33">
<![CDATA[Shutting down: the MODULE object is in the process of shutting down all connections to the module.]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[16#6000 -> 24576 (DINT)]]>
</Line>
<Line Number="38">
<![CDATA[Inhibited: the MODULE object is inhibited (the inhibit bit in the Mode attribute is set).]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[16#7000 -> 28672 (DINT)]]>
</Line>
<Line Number="43">
<![CDATA[Waiting: the parent MODULE object upon which this MODULE object depends is not running]]>
</Line>
<Line Number="44">
<![CDATA[]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[16#9000 -> 36864 (DINT)]]>
</Line>
<Line Number="48">
<![CDATA[FirmwareUpdating: Firmware supervisor is attempting to flash the module.]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[16#A000 -> 40960 (DINT)]]>
</Line>
<Line Number="53">
<![CDATA[Configuring: Controller is downloading configuration to the module. Either ?forward open? or (ADC) download occur during this state.]]>
</Line>
<Line Number="54">
<![CDATA[     ]]>
</Line>
<Line Number="55">
<![CDATA[----------------------------------------------------------------------------------------------------------*/]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[GSV_Index[0] := (GSV_Index[0] MOD 2) + 1;    ]]>
</Line>
<Line Number="60">
<![CDATA[    ]]>
</Line>
<Line Number="61">
<![CDATA[CASE GSV_Index[0] OF]]>
</Line>
<Line Number="62">
<![CDATA[   	]]>
</Line>
<Line Number="63">
<![CDATA[1: GSV(Module,P1000_VFD,EntryStatus,P1000_VFD.Comm_Code);]]>
</Line>
<Line Number="64">
<![CDATA[2: GSV(Module,P2000_VFD,EntryStatus,P2000_VFD.Comm_Code);]]>
</Line>
<Line Number="65">
<![CDATA[	]]>
</Line>
<Line Number="66">
<![CDATA[END_CASE;    ]]>
</Line>
<Line Number="67">
<![CDATA[]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main_Routine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(GSV_Communication,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(System_Logic,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PS_Flt" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(MPS3000.I.Auxiliary_Forward) TON(MPS3000.Flt.PS_FltTmr,?,?) XIC(MPS3000.Flt.PS_FltTmr.DN) ,XIC(MPS3000.Flt.PS_Flt) XIO(MPS_Area.Reset) ]OTE(MPS3000.Flt.PS_Flt);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="RIO_Comm_Fault" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[#############################
EN2T Devices
######################################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
