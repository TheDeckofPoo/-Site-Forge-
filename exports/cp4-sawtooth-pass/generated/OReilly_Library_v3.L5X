</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_G1" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Used in calculating Gregorian Day Number (function of Year and F)]]>
</Description>
