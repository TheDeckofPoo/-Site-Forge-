<Rung Number="0" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Required Gap Values
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[MOV(P336_Min_Gap,P332_Min_Package_Gap);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Check length of the package at P332 Exit PE
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[XIO(PE332_P.I.PE_Clear)XIC(P332_Conv.Running)XIC(P336_Enc.PPI)ADD(P332_Package_Length,1,P332_Package_Length);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Transfer Package length to Prev Package and wait for next package to measure the length
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[XIC(PE332_P.I.PE_Clear)ONS(P332_Package_Length_ONS)MOV(P332_Package_Length,P332_Prev_Package_Length)MOV(0,P332_Package_Length);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Logic to make Gapping decision after looking the length of prevoius package. Gapping length includes Min Package Pitch and Min Package Gap
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[[XIC(Enable_P332_Pitch_Check) SUB(P332_Min_Package_Pitch,P332_Prev_Package_Length,P332_Gapping_Length) LES(P332_Gapping_Length,P332_Min_Package_Gap) MOV(P332_Min_Package_Gap,P332_Gapping_Length) ,XIO(Enable_P332_Pitch_Check) MOV(P332_Min_Package_Gap,P332_Gapping_Length) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[---------------------------------[]-----[]---------------------------------

Gapping Logic Start

---------------------------------[]-----[]---------------------------------]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Check Package at Exit PE of P332 Conveyor
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[[XIO(PE332_P.I.PE_Clear) ,XIC(P332_Box_Induct) ]NEQ(P332_Box_Cleared,1)OTE(P332_Box_Induct);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Check Package Cleared from Exit PE of P332 Conveyor
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[XIC(P332_Box_Induct)XIC(PE332_P.I.PE_Clear)MOV(1,P332_Box_Cleared);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Create required gap after Package cleared from Exit PE of P336 Conveyor
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[EQU(P332_Box_Cleared,1)XIC(P336_Enc.PPI)ADD(P332_Gapping_Counter,1,P332_Gapping_Counter)GEQ(P332_Gapping_Counter,P332_Gapping_Length)MOV(0,P332_Gapping_Counter)MOV(0,P332_Box_Cleared)OTE(P336_Box_Inducted);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
P336 Conveyor Run Hold
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[[EQU(1,P332_Box_Cleared) ,NEQ(P332_Gapping_Counter,0) ]XIO(PE332_P.I.PE_Clear)OTE(P332_Conv.PI.Run_Hold);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Gridlock_Prevent" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[************************************
First Scan Settings
************************************
]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[MOV(0,P336_System.GLP_Timer.ACC) MOV(0,P336_System.RecircCNT) MOV(0,P336_System.Max_RecircCNT) MOV(20,P336_System.Recirc_Max) ,MOV(0,P336_System.GLPFull_Enable) MOV(0,P336_System.GLPCoolDN_Timer.ACC) ,OTU(P336_System.GLP_Enable) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[************************************
GPL: Logic to count No. of boxes out of sorter in 30 seconds Next 2 Rung
************************************]]>
</Comment>
<Text>
<![CDATA[XIC(P336_Conv.Running)[XIO(PE336_J.PE_Clear) ,XIC(P336_System.GLP_Timer.TT) ,NEQ(P336_System.Max_RecircCNT,0) ]TON(P336_System.GLP_Timer,?,?)XIO(PE336_J.PE_Clear)ONS(P336_System.PE_ONS)ADD(P336_System.RecircCNT,1,P336_System.RecircCNT);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(P336_System.GLP_Timer.DN) GEQ(P336_System.RecircCNT,P336_System.Recirc_Max) MOV(1,P336_System.Max_RecircCNT) ,XIC(P336_System.GLP_Timer.DN) LES(P336_System.RecircCNT,P336_System.Recirc_Max) MOV(0,P336_System.Max_RecircCNT) ][RES(P336_System.GLP_Timer) ,MOV(0,P336_System.RecircCNT) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[************************************
GPL: Logic to check full condition
************************************]]>
</Comment>
<Text>
<![CDATA[XIO(Start_Rate_Test)[XIC(PE340_HF.Full) ONS(P336_GLP_On) MOV(1,P336_System.GLPFull_Enable) ,XIO(PE340_HF.Full) ONS(P336_GLP_Off) MOV(0,P336_System.GLPFull_Enable) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[************************************
GridLock Prevent Enable Logic
************************************]]>
</Comment>
<Text>
<![CDATA[[[NEQ(P336_System.GLPFull_Enable,0) ,NEQ(P336_System.Max_RecircCNT,0) ] ,EQU(P336_System.GLPFull_Enable,0) EQU(P336_System.Max_RecircCNT,0) TON(P336_System.GLPCoolDN_Timer,?,?) XIO(P336_System.GLPCoolDN_Timer.DN) ]OTE(P336_System.GLP_Enable);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[************************************
GPL: Bits for HMI 
************************************]]>
</Comment>
<Text>
<![CDATA[XIC(P336_System.GLPCoolDN_Timer.TT)OTE(P336_System.HMI.CoolDN_TmrActive);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NEQ(P336_System.Max_RecircCNT,0)OTE(P336_System.HMI.RecircMaxCnt_GLPEnable);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[NEQ(P336_System.GLPFull_Enable,0)OTE(P336_System.HMI.RecircFull_GLPEnable);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[************************************
GPL: Logic to check Grid Lock Condition
************************************]]>
</Comment>
<Text>
<![CDATA[XIO(P340_Conv.Release)XIO(P322_Conv.Release)XIC(PE340_F.Full)XIC(PE340_HF.Full)XIO(P336_Conv.Running)OTE(P336_System.System_InGridlock);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
