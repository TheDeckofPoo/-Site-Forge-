<Program Name="Main_Area_Area_Fast" TestEdits="false" MainRoutineName="Main_Routine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Conv_Fast" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
P1000_Conv Fast logic
(Transport Conv with VFD)
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[Fast_Conv(P1000_Conv_AOI.Fast,P1000_Conv,Conv_Area,Conv_Area_Safe,Next_Conv,PEExit_P,PEAdd_PE,P1000_Conv.Type,PConv_VFD,0,1,0,0,HMIColor,HMI_StatsClear);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
P3000_Conv Fast logic
(Accumulation Conv with MS)
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[Fast_Conv(P3000_Conv_AOI.Fast,P3000_Conv,Conv_Area,Conv_Area_Safe,Next_Conv,PEExit_P,PEAdd_PE,P3000_Conv.Type,NO_VFD,0,1,0,0,HMIColor,HMI_StatsClear);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
P2000_Conv Fast logic
(Accumulation Conv with VFD)
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[Fast_Conv(P2000_Conv_AOI.Fast,P2000_Conv,Conv_Area,Conv_Area_Safe,Next_Conv,PEExit_P,PEAdd_PE,P2000_Conv.Type,PConv_VFD,0,1,0,0,HMIColor,HMI_StatsClear);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
P4000_Conv Fast logic
(Transport Conv with MS)
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[Fast_Conv(P4000_Conv_AOI.Fast,P4000_Conv,Conv_Area,Conv_Area_Safe,Next_Conv,PEExit_P,PEAdd_PE,P4000_Conv.Type,NO_VFD,0,1,0,0,HMIColor,HMI_StatsClear);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Conv_Full" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
PE1000_F Full PELogic
Note: Some of the AOI values are coming from the Full_Init Routine from Slow Task
Standard Logic
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[Full_PE(PE1000_F_AOI,PE1000_F,PE_Conv,1,0,HMI_StatsClear);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
PE2000_F Full PELogic
Note: Some of the AOI values are coming from the Full_Init Routine from Slow Task
Disable Release Bit to check Full condition of the conveyor
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[Full_PE(PE2000_F_AOI,PE2000_F,PE_Conv,0,0,HMI_StatsClear);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Conv_PE" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
PE2000_P Debounce and Jam Logic
Standard Logic -> Jam Reset only when PE is Clear
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[PE_Logic(PE2000_P_AOI,PE2000_P,PE_Conv,PE_Area.PI.JamRst,0,0,0,PE2000_P_AOI.I_AutoClearTmr,HMI_StatsClear);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
PE1000_P Debounce and Jam Logic
DISABLED JAM Logic
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[PE_Logic(PE1000_P_AOI,PE1000_P,PE_Conv,PE_Area.PI.JamRst,1,0,0,PE1000_P_AOI.I_AutoClearTmr,HMI_StatsClear);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
PE3000_P Debounce and Jam Logic
Auto Clear Jam Enable Logic -> As soon as PE is clear, Jam will be Reset Automatically after the Auto Clear Timer is Done
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[PE_Logic(PE3000_P_AOI,PE3000_P,PE_Conv,PE_Area.PI.JamRst,0,0,1,PE3000_P_AOI.I_AutoClearTmr,HMI_StatsClear);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
PE4000_P Debounce and Jam Logic
Disable Exit PE Clear Jam Logic -> Jam Reset when reset button is pressed, it will not check PE condition.
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[PE_Logic(PE4000_P_AOI,PE4000_P,PE_Conv,PE_Area.PI.JamRst,0,1,0,PE4000_P_AOI.I_AutoClearTmr,HMI_StatsClear);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main_Routine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Conv_PE,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Conv_Full,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Conv_Fast,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(VFD_Control,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="VFD_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
P1000_VFD  AB525-VFD logic
Standard Logic -> WIthout E2P Card Install
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[AB_VFD525(P1000_VFD_AOI,VFD_Conv,P1000_VFD,P1000_VFD.HMI.FPM_at60hz,VFD_Conv.Spd,VFD_Conv.Reset,Enable_VFD_60Hz_Test_Speed,0,HMI_StatsClear,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
P2000_VFD  AB525-VFD logic
Standard Logic -> WIth E2P Card Install
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[AB_VFD525(P2000_VFD_AOI,VFD_Conv,P2000_VFD,P2000_VFD.HMI.FPM_at60hz,VFD_Conv.Spd,VFD_Conv.Reset,Enable_VFD_60Hz_Test_Speed,1,HMI_StatsClear,?);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
