</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[P336_SCN336.Enable_ScanData_Expire := 1; //Enable logic to discard scanner data after certain conveyor travel distance]]>
</Line>
<Line Number="11">
<![CDATA[P336_SCN336.ScanData_Expire_Limit := 10; //5; //Scanner data will be discarded after this conveyor travel distance (max = 50)]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[P336_SCN336.ConsecNoRead_Limit := 5; //10; //Trigger "Consective NoRead" alarm bit after this many no-read messages (max =50)]]>
</Line>
<Line Number="14">
<![CDATA[P336_SCN336.ConsecMultiRead_Limit := 5; //Trigger "Consective NoData" alarm bit after this many empty data messages (max =50)]]>
</Line>
<Line Number="15">
<![CDATA[P336_SCN336.ConsecNoData_Limit := 5; //Trigger "Consective NoData" alarm bit after this many empty data messages (max =50)]]>
</Line>
<Line Number="16">
<![CDATA[P336_SCN336.Enable_MultiRead_Detect := 1;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
