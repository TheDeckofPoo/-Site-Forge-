</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_G2" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Used in calculating Gregorian Day Number (function of Year and F)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
