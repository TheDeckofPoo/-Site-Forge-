<Routine Name="VFD_Input" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// P1000_VFD Inputs]]>
</Line>
<Line Number="1">
<![CDATA[P1000_VFD.VFDIn.Accelerating := P1000_VFD:I.Accelerating;]]>
</Line>
<Line Number="2">
<![CDATA[P1000_VFD.VFDIn.Active := P1000_VFD:I.Active;]]>
</Line>
<Line Number="3">
<![CDATA[P1000_VFD.VFDIn.ActualDir := P1000_VFD:I.ActualDir;]]>
</Line>
<Line Number="4">
<![CDATA[P1000_VFD.VFDIn.AtReference := P1000_VFD:I.AtReference;]]>
</Line>
<Line Number="5">
<![CDATA[P1000_VFD.VFDIn.CommandDir := P1000_VFD:I.CommandDir;]]>
</Line>
<Line Number="6">
<![CDATA[P1000_VFD.VFDIn.CommFreqCnt := P1000_VFD:I.CommFreqCnt;]]>
</Line>
<Line Number="7">
<![CDATA[P1000_VFD.VFDIn.CommLogicCnt := P1000_VFD:I.CommLogicCnt;]]>
</Line>
<Line Number="8">
<![CDATA[P1000_VFD.VFDIn.Decelerating := P1000_VFD:I.Decelerating;]]>
</Line>
<Line Number="9">
<![CDATA[P1000_VFD.VFDIn.DigIn1Active := P1000_VFD:I.DigIn1Active;]]>
</Line>
<Line Number="10">
<![CDATA[P1000_VFD.VFDIn.DigIn2Active := P1000_VFD:I.DigIn2Active;]]>
</Line>
