</Line>
<Line Number="13">
<![CDATA[P306_Conv_Track.CFG.Pointer_Start := 1; ]]>
</Line>
<Line Number="14">
<![CDATA[P306_Conv_Track.CFG.Pointer_End := P306_Conv_Track.CFG.Pointer_Start + P306_Conv_Track.CFG.FinalOffset + Init.Track_Length_Extra;   ]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
</STContent>
