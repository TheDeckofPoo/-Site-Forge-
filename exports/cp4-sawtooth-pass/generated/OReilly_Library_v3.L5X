<Routine Name="Custom_Message_Unload" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Helix_Custom_Primary_CNTRL.ER) ,XIC(S:FS) ][XIC(Helix_Custom_Primary.Error.Auto_Reset) OTE(Helix_Custom_Primary.Error.Reset) ,XIO(S:FS) ONS(Helix_Custom_Primary.Error.ONS) ADD(Helix_Custom_Primary.Log.Error_Count,1,Helix_Custom_Primary.Log.Error_Count) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Helix_Custom_Primary.Error.Reset) ,XIC(Helix_Custom_Primary.Error.Reset_Timer.TT) ][TON(Helix_Custom_Primary.Error.Reset_Timer,?,?) ,XIC(Helix_Custom_Primary.Error.Reset_Timer.DN) [OTU(Helix_Custom_Primary_CNTRL.ER) ,OTU(Helix_Custom_Primary_CNTRL.EN) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GRT(Helix_Custom_Primary.Control.Buffer_Size,Helix_Custom_Primary.Log.Buffer_Max)MOV(Helix_Custom_Primary.Control.Buffer_Size,Helix_Custom_Primary.Log.Buffer_Max);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[UID();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(Helix_Custom_Primary.Control.Empty)XIO(Helix_Custom_Primary.Control.Send)ADD(Helix_Custom_Primary.Log.Unload_Count,1,Helix_Custom_Primary.Log.Unload_Count);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(Helix_Custom_Primary.Control.Empty)XIO(Helix_Custom_Primary.Control.Send)COP(Helix_Custom_Primary.FIFO[Helix_Custom_Primary.Control.Front],Helix_Custom_Primary.Message,1);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(Helix_Custom_Primary.Control.Empty)XIO(Helix_Custom_Primary.Control.Send)ADD(Helix_Custom_Primary.Control.Front,1,Helix_Custom_Primary.Control.Front)AND(Helix_Custom_Primary.Control.Front,127,Helix_Custom_Primary.Control.Front)OTU(Helix_Custom_Primary.Control.Full);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(Helix_Custom_Primary.Control.Empty)XIO(Helix_Custom_Primary.Control.Send)SUB(Helix_Custom_Primary.Control.Buffer_Size,1,Helix_Custom_Primary.Control.Buffer_Size);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(Helix_Custom_Primary.Control.Empty)XIO(Helix_Custom_Primary.Control.Send)NEQ(Helix_Custom_Message_Type,Helix_Custom_Primary_CNTRL.RemoteElement)COP(Helix_Custom_Message_Type,Helix_Custom_Primary_CNTRL.RemoteElement,1);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(Helix_Custom_Primary.Control.Empty)XIO(Helix_Custom_Primary.Control.Send)[EQU(Helix_Custom_Primary.Control.Back,Helix_Custom_Primary.Control.Front) OTL(Helix_Custom_Primary.Control.Empty) ,OTU(Helix_Custom_Primary_CNTRL.EN) OTL(Helix_Custom_Primary.Control.Send) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[UIE();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(Helix_Custom_Primary_CNTRL.ER)XIC(Helix_Custom_Primary.Control.Send)[MSG(Helix_Custom_Primary_CNTRL) ,XIC(Helix_Custom_Primary_CNTRL.DN) ADD(Helix_Custom_Primary.Log.Message_Count,1,Helix_Custom_Primary.Log.Message_Count) OTU(Helix_Custom_Primary.Control.Send) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="DecisionConfirm_Message_Unload" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ ---------------------------------[]-----[]---------------------------------
Helix Communication Managment
DecisionConfirm Message FIFO Unload/Send
 ---------------------------------[]-----[]---------------------------------]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Log the number of errors, and reset if auto rest is on
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[[XIC(Helix_DecisionConfirm_Primary_CNTRL.ER) ,XIC(S:FS) ][XIC(Helix_DecisionConfirm_Primary.Error.Auto_Reset) OTE(Helix_DecisionConfirm_Primary.Error.Reset) ,XIO(S:FS) ONS(Helix_DecisionConfirm_Primary.Error.ONS) ADD(Helix_DecisionConfirm_Primary.Log.Error_Count,1,Helix_DecisionConfirm_Primary.Log.Error_Count) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Reset the messaging errors.
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[[XIC(Helix_DecisionConfirm_Primary.Error.Reset) ,XIC(Helix_DecisionConfirm_Primary.Error.Reset_Timer.TT) ][TON(Helix_DecisionConfirm_Primary.Error.Reset_Timer,?,?) ,XIC(Helix_DecisionConfirm_Primary.Error.Reset_Timer.DN) [OTU(Helix_DecisionConfirm_Primary_CNTRL.ER) ,OTU(Helix_DecisionConfirm_Primary_CNTRL.EN) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Log the maximum buffer size.
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[GRT(Helix_DecisionConfirm_Primary.Control.Buffer_Size,Helix_DecisionConfirm_Primary.Log.Buffer_Max)MOV(Helix_DecisionConfirm_Primary.Control.Buffer_Size,Helix_DecisionConfirm_Primary.Log.Buffer_Max);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Prevent the following code from being interupted.
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[UID();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Log the number of unloads from the FIFO.
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[XIO(Helix_DecisionConfirm_Primary.Control.Empty)XIO(Helix_DecisionConfirm_Primary.Control.Send)ADD(Helix_DecisionConfirm_Primary.Log.Unload_Count,1,Helix_DecisionConfirm_Primary.Log.Unload_Count);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Unload the message from the
 FIFO into the memory location that is
 used by the message instruction.
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[XIO(Helix_DecisionConfirm_Primary.Control.Empty)XIO(Helix_DecisionConfirm_Primary.Control.Send)COP(Helix_DecisionConfirm_Primary.FIFO[Helix_DecisionConfirm_Primary.Control.Front],Helix_DecisionConfirm_Primary.Message,1);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Increase the front of the queue 
to the next member of the FIFO.
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[XIO(Helix_DecisionConfirm_Primary.Control.Empty)XIO(Helix_DecisionConfirm_Primary.Control.Send)ADD(Helix_DecisionConfirm_Primary.Control.Front,1,Helix_DecisionConfirm_Primary.Control.Front)AND(Helix_DecisionConfirm_Primary.Control.Front,127,Helix_DecisionConfirm_Primary.Control.Front)OTU(Helix_DecisionConfirm_Primary.Control.Full);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Decrease the current buffer size
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[XIO(Helix_DecisionConfirm_Primary.Control.Empty)XIO(Helix_DecisionConfirm_Primary.Control.Send)SUB(Helix_DecisionConfirm_Primary.Control.Buffer_Size,1,Helix_DecisionConfirm_Primary.Control.Buffer_Size);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Set the message type if not the same
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[XIO(Helix_DecisionConfirm_Primary.Control.Empty)XIO(Helix_DecisionConfirm_Primary.Control.Send)NEQ(Helix_DecisionConfirm_Message_Type,Helix_DecisionConfirm_Primary_CNTRL.RemoteElement)COP(Helix_DecisionConfirm_Message_Type,Helix_DecisionConfirm_Primary_CNTRL.RemoteElement,1);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[·.·.·.·.·.·.·.·.·.·.·.·.·.·
Initialize sending the message
 and unenable the message control to
 ensure the message can be sent.
.·.·.·.·.·.·.·.·.·.·.·.·.·.]]>
</Comment>
<Text>
<![CDATA[XIO(Helix_DecisionConfirm_Primary.Control.Empty)XIO(Helix_DecisionConfirm_Primary.Control.Send)[OTU(Helix_DecisionConfirm_Primary_CNTRL.EN) OTL(Helix_DecisionConfirm_Primary.Control.Send) ,EQU(Helix_DecisionConfirm_Primary.Control.Back,Helix_DecisionConfirm_Primary.Control.Front) OTL(Helix_DecisionConfirm_Primary.Control.Empty) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[UIE();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[ ---------------------------------[]-----[]---------------------------------
MESSAGE SEND
·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·
The MSG Instruction needs to be configured as below
·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·.·
Configuration tab:
-Source Element needs to be the Message tag from the Helix Data Structure
