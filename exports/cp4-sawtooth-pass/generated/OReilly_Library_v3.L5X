<Rung Number="0" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~
P332  AB525-VFD logic
Standard Logic -> WIthout E2P Card Install
~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[AB_VFD525(P332_VFD_AOI,P332_Conv,P332_VFD,P332_VFD.HMI.FPM_at60hz,P332_Conv.Spd,P332_Conv.Reset,P332_VFD.HMI.Enable_60Hz,0,HMI_StatsClear,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[[XIC(P332_VFD:O.Start) ,XIC(P332_VFD:O.Jog) ] TOF(P332_Brk_OffDelay,?,?) XIC(P332_Brk_OffDelay.DN) ,XIC(P332_Brk_OffDelay.DN) ]OTE(P332_Conv_BrakeReleased);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
