<Routine Name="P105_SCN104_Induct" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[******************************************************************
P104 Virtual Encoder 
******************************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[Enc_Virtual_DistBased(P104_Enc_Virtual_AOI,1,Enc_Type0,P104_Conv.Spd,P104_Conv.Release,P104_Conv.Ready_To_Receive,0,0,1,DecantWork_Area.Reset,HMI_StatsClear,P104_Enc_Virtual);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[******************************************************************
P105 Induct Zone 
Induct PE is PE105_P1
******************************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[TRKzone_InductTokenGen(P105_Induct_AOI,1,0,P105_ConvSingulate.Token.ID,P105_Conv.Running,PE105_P1.PE_Clear,P105_Induct_Track,Track_Group_P105Induct);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[******************************************************************
Update Timestamp at Induct PE
******************************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[NEQ(P105_Induct_AOI.M_Token_Number_Current,P105_Induct_Token_Prev)COP(Empty_ASRS_Token,P105_ASRS_Inbound.Token[P105_Induct_AOI.M_Token_Number_Current],1)[COP(PLC.String_DTS,P105_ASRS_Inbound.Token[P105_Induct_AOI.M_Token_Number_Current].Found_TS,1) ,COP(PLC.String_DTS,P105_ConvSingulate.Token.Found_Timestamp,1) ,MOV(P105_Induct_AOI.M_Token_Number_Current,P104_SCN104.TokenNumber) ]MOV(P105_Induct_AOI.M_Token_Number_Current,P105_Induct_Token_Prev);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[GSV(Module,SCN104,EntryStatus,P104_SCN104.Comm_Code) NEQ(P104_SCN104.Comm_Code,16384) TON(P104_SCN104.CommLoss_Tmr,?,?) XIC(P104_SCN104.CommLoss_Tmr.DN) ,XIC(P104_SCN104.Flt.CommLoss) XIO(P104_Conv.Reset) ]OTE(P104_SCN104.Flt.CommLoss);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[NEQ(SCN104:I.Status.ResultID,P104_Scanner_Seq1_Pre)XIC(SCN104:I.Status.ResultsAvailable)[MOV(SCN104:I.Status.ResultLength,P104_Scanner_RawData_LEN) [GRT(P104_Scanner_RawData_LEN,82) MOV(82,P104_Scanner_RawData_LEN) ,LES(P104_Scanner_RawData_LEN,0) MOV(0,P104_Scanner_RawData_LEN) ] ,CPS(SCN104:I.ResultData[0],P104_Scanner_RawData_str.DATA[0],P104_Scanner_RawData_LEN) MOV(P104_Scanner_RawData_LEN,P104_Scanner_RawData_str.LEN) ,CPS(P104_Scanner_RawData_str,P104_SCN104.RawData,1) MOV(P104_Scanner_RawData_LEN,P104_SCN104.RawData.LEN) OTL(P104_SCN104.RawData_Available) ,ADD(1,P104_Scan_Raw_Data_History_Index,P104_Scan_Raw_Data_History_Index) GRT(P104_Scan_Raw_Data_History_Index,99) MOV(0,P104_Scan_Raw_Data_History_Index) ,COP(SCN104:I.ResultData[0],Raw_P104_Scanner_Data_History[P104_Scan_Raw_Data_History_Index].Raw_Data.DATA[0],SCN104:I.Status.ResultLength) MOV(SCN104:I.Status.ResultLength,Raw_P104_Scanner_Data_History[P104_Scan_Raw_Data_History_Index].Raw_Data.LEN) COP(PLC.String_DTS,Raw_P104_Scanner_Data_History[P104_Scan_Raw_Data_History_Index].Found_Timestamp,1) MOV(SCN104:I.Status.ResultID,Raw_P104_Scanner_Data_History[P104_Scan_Raw_Data_History_Index].Seq_Number) ,MOV(SCN104:I.Status.ResultID,P104_Scanner_Seq1_Pre) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(SCN104:I.Status.ResultsAvailable)TON(P104_Scanner_ResultsAvailable_Timer,?,?)XIC(P104_Scanner_ResultsAvailable_Timer.DN)OTE(SCN104:O.Control.ResultsAck);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[TRK_Scanner_TokenUpdate(SCN104_Token_Update_AOI,P104_SCN104,1,SCN104_TokenExpire_Input,0,P104_Enc_Virtual.PPI,P104_SCN104.TokenNumber,0,0,P105_ASRS_Inbound.Barcode,NO_Read,MultiRead,NO_Data,HMI_StatsClear,HMI_ScanStatsClear,HMI_LifeTime_ScanStatsClear,P104_Conv.Reset,P104_Scanner_Offset_Find,PE104_P.PE_Clear,P104_ScanOffsetArray,Reason_Code_SINT.Success,Reason_Code_SINT.Carton_Too_Long,Reason_Code_SINT.Induct_NoRead,Reason_Code_SINT.Lane_Full);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[******************************************************************
Ignition Interface
******************************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(SCN104_Token_Update_AOI.O_Send_WCS_Message)XIO(PE105_P1.PE_Clear)XIO(PE105_P2.PE_Clear)[COP(P105_ASRS_Inbound.Barcode,P105_ASRS_Inbound.Token[P104_SCN104.TokenNumber].Barcode,1) ,MOV(P104_SCN104.TokenNumber,P105_ASRS_Inbound.ID) MOV(P104_SCN104.TokenNumber,P104_TokenNumber_Last) ,MOV(P104_SCN104.TokenNumber,P105_ASRS_Inbound.Token[P104_SCN104.TokenNumber].ID) ,MOV(PLC.DINT_TS,P105_ASRS_Inbound.Token[P104_SCN104.TokenNumber].BinReady_TS) ][OTL(P105_ASRS_Inbound_DataSend) ,OTU(SCN104_Token_Update_AOI.O_Send_WCS_Message) ,OTL(P105_CartonData.CountUp) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(P105_ASRS_Inbound_DataSend)TON(P105_ASRS_Inbound_DataSend_TMR,?,?);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(P105_ASRS_Inbound_DataSend_TMR.DN)OTL(P105_ASRS_Inbound.BinReady)OTU(P105_ASRS_Inbound_DataSend);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(P105_ASRS_Inbound.BinReady)XIC(P105_ASRS_Inbound.BinReadyACK)TON(P105_ASRS_Inbound_StatusACK_Timer,?,?)XIC(P105_ASRS_Inbound_StatusACK_Timer.DN)[MOV(PLC.DINT_TS,P105_ASRS_Inbound.Token[P104_SCN104.TokenNumber].BinReadyACK_TS) ,COP(Empty_Barcode,P105_ASRS_Inbound.Barcode,1) ,MOV(0,P105_ASRS_Inbound.ID) ]OTU(P105_ASRS_Inbound.BinReady);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIO(PE105_P2.PE_Clear) ,XIO(PE105_P2.I.PE_Clear) ]OTE(P105_Conv.PI.Stop_Next);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIO(PE105_P1.PE_Clear)XIO(PE105_P2.PE_Clear)TON(SCN104_TokenExpire_TMR,?,?)XIC(SCN104_TokenExpire_TMR.DN)OTE(SCN104_TokenExpire_Input);]]>
</Text>
</Rung>
</RLLContent>
