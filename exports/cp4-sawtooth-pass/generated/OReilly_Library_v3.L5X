</Line>
<Line Number="13">
<![CDATA[P336_Conv_Track.CFG.Pointer_Start := 1; ]]>
</Line>
<Line Number="14">
<![CDATA[P336_Conv_Track.CFG.Pointer_End := P336_Conv_Track.CFG.Pointer_Start + P336_Conv_Track.CFG.FinalOffset + Init.Track_Length_Extra;   ]]>
