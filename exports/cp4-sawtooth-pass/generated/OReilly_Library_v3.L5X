<Routine Name="P206_Induct_Gapper" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Required Gap Values
Min Package Pitch:86 Pulses (Required 48 inches from Printer - In Start/stop acel/decl, 86 pulses are good to create proper pitch)
Min Package Gap: 14 Pulses
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[MOV(P204A2_Min_Gap,P204A2_Min_Package_Gap);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Check length of the package at P204A2 Exit PE
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[XIO(PE204_P2.I.PE_Clear)XIC(P204A2_Conv.Release)XIC(P206_Enc_Virtual.PPI)ADD(P204A2_Package_Length,1,P204A2_Package_Length);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Transfer Package length to Prev Package and wait for next package to measure the length
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[XIC(PE204_P2.I.PE_Clear)ONS(P204A2_Package_Length_ONS)MOV(P204A2_Package_Length,P204A2_Prev_Package_Length)MOV(0,P204A2_Package_Length);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Logic to make Gapping decision after looking the length of prevoius package. Gapping length includes Min Package Pitch and Min Package Gap
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[[XIC(Enable_P204A2_Pitch_Check) SUB(P332_Min_Package_Pitch,P204A2_Prev_Package_Length,P204A2_Gapping_Length) LES(P204A2_Gapping_Length,P204A2_Min_Package_Gap) MOV(P204A2_Min_Package_Gap,P204A2_Gapping_Length) ,XIO(Enable_P204A2_Pitch_Check) MOV(P204A2_Min_Package_Gap,P204A2_Gapping_Length) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[---------------------------------[]-----[]---------------------------------

Gapping Logic Start

---------------------------------[]-----[]---------------------------------]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Check Package at Exit PE of P204A2 Conveyor
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[[XIO(PE204_P2.I.PE_Clear) ,XIC(P204A2_Box_Induct) ]NEQ(P204A2_Box_Cleared,1)OTE(P204A2_Box_Induct);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Check Package Cleared from Exit PE of P204A2 Conveyor
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[XIC(P204A2_Box_Induct)XIC(PE204_P2.I.PE_Clear)MOV(1,P204A2_Box_Cleared);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
Create required gap after Package cleared from Exit PE of P204A2 Conveyor
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
<Text>
<![CDATA[EQU(P204A2_Box_Cleared,1)XIC(P206_Enc_Virtual.PPI)ADD(P204A2_Gapping_Counter,1,P204A2_Gapping_Counter)GEQ(P204A2_Gapping_Counter,P204A2_Gapping_Length)OTE(P204A2_Box_Inducted)MOV(0,P204A2_Gapping_Counter)MOV(0,P204A2_Box_Cleared);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(P208_ConvSingulate.Loading) XIO(P208_ConvSingulate.Loaded) ,XIC(P208_ConvSingulate.Loaded) XIO(P208_ConvSingulate.Discharge) ,XIO(PE206_P.I.PE_Clear) ]OTE(P208_Zone_Not_Ready);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[- - - - - - - - - - <> <> - - - - - - - - - -
P204A2 Conveyor Run Hold
- - - - - - - - - - <> <> - - - - - - - - - -]]>
</Comment>
