<![CDATA[[EQU(1,P204A2_Box_Cleared) ,NEQ(P204A2_Gapping_Counter,0) ,XIC(P208_Zone_Not_Ready) ,XIC(PE214_F.Full) ,XIC(PE1400_F.Full) ,XIC(P204A2_Induct_Hold) ]XIO(PE204_P2.I.PE_Clear)OTE(P204A2_Conv.PI.Stop_Next);]]>
