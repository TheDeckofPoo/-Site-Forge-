<![CDATA[XIC(P310_PSI_Data_Received)[ONS(P310_PSI_Data_Received_ONS) MOV(PLC.DINT_TS,Token_SCN310[P308_ConvSingulate.Token.ID].PSI_RespReceived_TS) ,XIC(P310_PSI_Interface.I.Cycle_Complete) MOV(P310_ConvSingulate.HMI.DestStraight,P308_ConvSingulate.Token.PSI_Destination) MOV(P310_ConvSingulate.HMI.DestStraight,Token_SCN310[P308_ConvSingulate.Token.ID].PSI_Destination) ,XIC(P310_PSI_Interface.I.Reject) MOV(P310_ConvSingulate.HMI.DestLeft,P308_ConvSingulate.Token.PSI_Destination) MOV(P310_ConvSingulate.HMI.DestLeft,Token_SCN310[P308_ConvSingulate.Token.ID].PSI_Destination) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[NEQ(P310_ConvSingulate.Token.ID,0) [EQU(P310_ConvSingulate.Token.PSI_Destination,P310_ConvSingulate.HMI.DestStraight) ,EQU(P310_ConvSingulate.Token.PSI_Destination,0) ] EQU(Token_SCN310[P310_ConvSingulate.Token.ID].Destination[0],0) [XIO(P310_Zone_WCS_Decision_Wait_Time.DN) EQU(P310_Zone_Destination,0) ,XIO(Enable_P310_Zone_WCS_ResponseTimeout) ] ,EQU(P310_Zone_Destination,0) ]OTE(P310_ConvSingulate.PI.Discharge_Hold);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(P310_ConvSingulate.Loaded)EQU(P310_Zone_Destination,0)[EQU(Token_SCN310[P310_ConvSingulate.Token.ID].PSI_Destination,P310_ConvSingulate.HMI.DestLeft) MOV(P310_ConvSingulate.HMI.DestLeft,P310_Zone_Destination) MOV(Reason_Code_SINT.PSI_Reject,Token_SCN310[P310_ConvSingulate.Token.ID].ReasonCode_SINT) ,NEQ(Token_SCN310[P310_ConvSingulate.Token.ID].PSI_Destination,P310_ConvSingulate.HMI.DestLeft) EQU(Token_SCN310[P310_ConvSingulate.Token.ID].PSI_Destination,P310_ConvSingulate.HMI.DestStraight) [NEQ(Token_SCN310[P310_ConvSingulate.Token.ID].Destination[0],0) MOV(Token_SCN310[P310_ConvSingulate.Token.ID].Destination[0],P310_Zone_Destination) ,XIC(Test_Bypass_WCS_at_P310) MOV(99,P310_Zone_Destination) ] ];]]>
</Text>
