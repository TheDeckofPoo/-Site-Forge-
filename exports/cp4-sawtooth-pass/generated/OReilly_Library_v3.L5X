</Comment>
<Text>
<![CDATA[XIC(P210_Enable_Sort_Force_to_Lane)NEQ(P208A_ConvSingulate.Token.ID,0)ONS(P210_Enable_Sort_Force_to_Lane_ONS)[MOV(P210_TransferManualDest[Fortna_says_go_here_P210],Token_SCN206[P208A_ConvSingulate.Token.ID].Destination[0]) ,XIC(P210_Enable_Test_Sort_Round_Robin) [ADD(Fortna_says_go_here_P210,1,Fortna_says_go_here_P210) ,GRT(Fortna_says_go_here_P210,P210_ConvSingulate_Destination_Max) MOV(P210_ConvSingulate_Destination_Min,Fortna_says_go_here_P210) ] ];]]>
