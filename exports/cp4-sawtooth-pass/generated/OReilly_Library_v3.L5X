<Text>
<![CDATA[XIO(Helix_Heartbeat_Primary.Control.Send)NEQ(Helix_Heartbeat_Message_Type,Helix_Heartbeat_Primary_CNTRL.RemoteElement)COP(Helix_Heartbeat_Message_Type,Helix_Heartbeat_Primary_CNTRL.RemoteElement,1);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(Helix_Heartbeat_Primary_CNTRL.ER)XIC(Helix_Heartbeat_Primary.Control.Send)[MSG(Helix_Heartbeat_Primary_CNTRL) ,XIC(Helix_Heartbeat_Primary_CNTRL.DN) ADD(Helix_Heartbeat_Primary.Log.Message_Count,1,Helix_Heartbeat_Primary.Log.Message_Count) [OTU(Helix_Heartbeat_Primary.Control.Send) ,RES(Helix_Heartbeat_MSG_Fault_TMR) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[****************************************************************************************
To raise an alarm when PLC can't send a heartbeat MSG to Helix
*******************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(Helix_Heartbeat_Primary.Control.Send)TON(Helix_Heartbeat_MSG_Fault_TMR,?,?)XIC(Helix_Heartbeat_MSG_Fault_TMR.DN)OTE(Helix_Heartbeat_MSG.Flt.CommLoss);]]>
</Text>
</Rung>
