<Text>
<![CDATA[TRK_SearchToken_WithPE(P336_Divert2_AOI.DC_PackageDetect,PE406_J2.PE_Clear,P336_Divert2.CFG.FinalOffset_DivertConf,P336_Divert2.DCPE_Stats,P336_Conv_Track,Track_File_SCN336,P336_Conv_Track.CFG.Early_SrchLim,P336_Conv_Track.CFG.Late_SrchLim,HMI_StatsClear,0)XIC(P336_Divert2_AOI.DC_PackageDetect.O_Token_Found_Ack)[TRK_DivertConfirm_RCUpdate(P336_Divert2_AOI.DC_RCUpdate,Token_SCN336[P336_Divert2_AOI.DC_PackageDetect.M_Token_Found],P336_Divert2,Reason_Code_SINT.Success,HMI_StatsClear) ,OTU(P336_Divert2_AOI.DC_PackageDetect.O_Token_Found_Ack) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[TRK_SearchToken_WithPE(P336_Divert3_AOI.DC_PackageDetect,PE412_J2.PE_Clear,P336_Divert3.CFG.FinalOffset_DivertConf,P336_Divert3.DCPE_Stats,P336_Conv_Track,Track_File_SCN336,P336_Conv_Track.CFG.Early_SrchLim,P336_Conv_Track.CFG.Late_SrchLim,HMI_StatsClear,0)XIC(P336_Divert3_AOI.DC_PackageDetect.O_Token_Found_Ack)[TRK_DivertConfirm_RCUpdate(P336_Divert3_AOI.DC_RCUpdate,Token_SCN336[P336_Divert3_AOI.DC_PackageDetect.M_Token_Found],P336_Divert3,Reason_Code_SINT.Success,HMI_StatsClear) ,OTU(P336_Divert3_AOI.DC_PackageDetect.O_Token_Found_Ack) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[TRK_SearchToken_WithPE(P336_Divert4_AOI.DC_PackageDetect,PE418_J2.PE_Clear,P336_Divert4.CFG.FinalOffset_DivertConf,P336_Divert4.DCPE_Stats,P336_Conv_Track,Track_File_SCN336,P336_Conv_Track.CFG.Early_SrchLim,P336_Conv_Track.CFG.Late_SrchLim,HMI_StatsClear,0)XIC(P336_Divert4_AOI.DC_PackageDetect.O_Token_Found_Ack)[TRK_DivertConfirm_RCUpdate(P336_Divert4_AOI.DC_RCUpdate,Token_SCN336[P336_Divert4_AOI.DC_PackageDetect.M_Token_Found],P336_Divert4,Reason_Code_SINT.Success,HMI_StatsClear) ,OTU(P336_Divert4_AOI.DC_PackageDetect.O_Token_Found_Ack) ];]]>
