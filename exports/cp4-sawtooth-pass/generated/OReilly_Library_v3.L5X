<Routine Name="WCS_MSG_Command" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*************************************'******'
P206-P210 Trasfer Message to Helix
*******************************************']]>
</Comment>
<Text>
<![CDATA[EQU(P208_ConvSingulate.Token.ID,0)ONS(P208_PackageUnloaded_ONS)[MOV(P208_Zone_AOI.M_Package_ID_Prev,P206_Induct_WCS_Token_Found) OTL(P206_Induct_Decision_Request_Helix) ,MOV(P206_Induct_WCS_Token_Found,P206_WCS_Resp_Token_ID) OTL(P206_Processing_WCS_Response_Time) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(P210_ConvSingulate.DivertedLane_ACK)ONS(P210_PackageDiverted_ONS)MOV(P210_Zone_AOI.M_Package_ID_Prev,P206_DivertConf_WCS_Token_Found)OTL(P206_Decision_Conf_Helix);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[*************************************'******'
Send P306 Induct Message to Helix
*******************************************']]>
</Comment>
<Text>
<![CDATA[XIC(SCL306_Token_Update_AOI.O_Send_WCS_Message)ONS(P306_P_PE_Rear_ONS)[MOV(P306_Induct_Track.Token_Number,P306_Induct_WCS_Token_Found) [OTL(P306_Induct_Decision_Request_Helix) ,OTL(P306_CartonData.CountUp) ] ,MOV(P306_Induct_WCS_Token_Found,P306_WCS_Resp_Token_ID) OTL(P306_Processing_WCS_Response_Time) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[*************************************'****'
To record P306 rsponse time from WCS
*****************************************']]>
</Comment>
<Text>
<![CDATA[TON(P306_WCS_Response_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(P306_Processing_WCS_Response_Time)[ONS(P306_MSG_Sent_to_WCS_ONS) MOV(P306_WCS_Resp_Token_ID,P306_WCS_Resp_Token_ID_Last) CLR(WCS_Response_Time_P306) RES(P306_WCS_Response_Timer) ,NEQ(Token_SCN306[P306_WCS_Resp_Token_ID].Destination[0],0) [MOV(WCS_Response_Timer_P306.ACC,WCS_Response_Time_P306) ,GRT(WCS_Response_Time_P306,0) GRT(WCS_Resp_Time_Interval_P306,0) DIV(WCS_Response_Time_P306,WCS_Resp_Time_Interval_P306,WCS_Time_History_Index_P306) LIM(0,WCS_Time_History_Index_P306,99) ADD(1,P306_WCS_Response_Time_History[WCS_Time_History_Index_P306],P306_WCS_Response_Time_History[WCS_Time_History_Index_P306]) ,GRT(WCS_Response_Time_P306,Max_WCS_Response_Time_P306) MOV(WCS_Response_Time_P306,Max_WCS_Response_Time_P306) ,GRT(WCS_Response_Time_P306,0) LES(WCS_Response_Time_P306,Min_WCS_Response_Time_P306) MOV(WCS_Response_Time_P306,Min_WCS_Response_Time_P306) ,OTU(P306_Processing_WCS_Response_Time) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(P306_Processing_WCS_Response_Time)GEQ(P306_WCS_Response_Timer.ACC,WCS_Response_Wait_Timeout_P306)[OTU(P306_Processing_WCS_Response_Time) OTL(P306_WCS_Response_Timed_Out) ,ADD(1,P306_Response_Timed_Out_CNT,P306_Response_Timed_Out_CNT) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(P306_Reset_WCS_Respoinse_Time_History)FLL(0,P306_WCS_Response_Time_History[0],100)OTU(P306_Reset_WCS_Respoinse_Time_History);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[*************************************'******'
Send P310 Transfer Message to Helix
*******************************************']]>
</Comment>
<Text>
<![CDATA[XIC(P310_ConvSingulate.Loaded)NEQ(Token_SCN310[P310_ConvSingulate.Token.ID].Barcode,Empty_Barcode)ONS(P310_PackageLoaded_ONS)MOV(P310_ConvSingulate.Token.ID,P310_Verify_WCS_Token)[OTL(P310_Verify_Decision_Request_Helix) ,OTL(P310_CartonData.CountUp) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(P310_ConvSingulate.DivertedLane_ACK)ONS(P310_PackageDiverted_ONS)MOV(P310_Zone_AOI.M_Package_ID_Prev,P310_TranfConfirm_WCS_Token)OTL(P310_Tranfer_Decision_Confirm_Helix);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[*************************************'******'******
Recording Helix Responce Time @P206
*******************************************'********]]>
</Comment>
<Text>
<![CDATA[TON(WCS_Response_Timer_P206,?,?);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(P206_Processing_WCS_Response_Time)[ONS(P206_MSG_Sent_to_WCS_ONS) MOV(P206_WCS_Resp_Token_ID,P206_WCS_Resp_Token_ID_Last) CLR(WCS_Response_Time_P206) RES(WCS_Response_Timer_P206) ,NEQ(Token_SCN206[P206_WCS_Resp_Token_ID].Destination[0],0) [MOV(WCS_Response_Timer_P206.ACC,WCS_Response_Time_P206) ,GRT(WCS_Response_Time_P206,0) GRT(WCS_Resp_Time_Interval_P206,0) DIV(WCS_Response_Time_P206,WCS_Resp_Time_Interval_P206,WCS_Time_History_Index_P206) LIM(0,WCS_Time_History_Index_P206,99) ADD(1,WCS_Response_Time_P206_History[WCS_Time_History_Index_P206],WCS_Response_Time_P206_History[WCS_Time_History_Index_P206]) ,GRT(WCS_Response_Time_P206,Max_WCS_Response_Time_P206) MOV(WCS_Response_Time_P206,Max_WCS_Response_Time_P206) ,GRT(WCS_Response_Time_P206,0) LES(WCS_Response_Time_P206,Min_WCS_Response_Time_P206) MOV(WCS_Response_Time_P206,Min_WCS_Response_Time_P206) ,OTU(P206_Processing_WCS_Response_Time) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(P206_Processing_WCS_Response_Time)GEQ(WCS_Response_Timer_P206.ACC,WCS_Response_Wait_Timeout_P206)[OTU(P206_Processing_WCS_Response_Time) OTL(WCS_Response_Timed_Out_P206) ,ADD(1,Response_Timed_Out_CNT_P206,Response_Timed_Out_CNT_P206) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Reset_WCS_Respoinse_Time_History_P206)FLL(0,WCS_Response_Time_P206_History[0],100)OTU(Reset_WCS_Respoinse_Time_History_P206);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
