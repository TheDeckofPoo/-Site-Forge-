<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[TRK_SearchToken_WithPE(P336_Divert1_AOI.DC_PackageDetect,PE400_J2.PE_Clear,P336_Divert1.CFG.FinalOffset_DivertConf,P336_Divert1.DCPE_Stats,P336_Conv_Track,Track_File_SCN336,P336_Conv_Track.CFG.Early_SrchLim,P336_Conv_Track.CFG.Late_SrchLim,HMI_StatsClear,0)XIC(P336_Divert1_AOI.DC_PackageDetect.O_Token_Found_Ack)[TRK_DivertConfirm_RCUpdate(P336_Divert1_AOI.DC_RCUpdate,Token_SCN336[P336_Divert1_AOI.DC_PackageDetect.M_Token_Found],P336_Divert1,Reason_Code_SINT.Success,HMI_StatsClear) ,OTU(P336_Divert1_AOI.DC_PackageDetect.O_Token_Found_Ack) ];]]>
