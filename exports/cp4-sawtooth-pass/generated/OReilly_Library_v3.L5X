<Routine Name="VFD_SpeedSet" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[/*Initialization Routine - Area Wide]]>
</Line>
<Line Number="1">
<![CDATA[		'All logical values that should be set on reboot of the processor.]]>
</Line>
<Line Number="2">
<![CDATA[		'Can be configured to reset from default values, configured values saved to memory, or HMI exported values.]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[ Do not add or update any values in this Routine]]>
</Line>
<Line Number="6">
<![CDATA[ These values can only be add or update while commissioning the system]]>
</Line>
<Line Number="7">
<![CDATA[*/]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[// Conveyor Speed]]>
</Line>
<Line Number="10">
<![CDATA[ ]]>
</Line>
<Line Number="11">
<![CDATA[//P1000_VFD Conveyor]]>
</Line>
<Line Number="12">
<![CDATA[P1000_VFD.HMI.FPM_at60hz := 100;]]>
</Line>
<Line Number="13">
<![CDATA[ ]]>
</Line>
<Line Number="14">
<![CDATA[//P2000_VFD Conveyor]]>
</Line>
<Line Number="15">
<![CDATA[P2000_VFD.HMI.FPM_at60hz := 100;]]>
</Line>
<Line Number="16">
<![CDATA[ ]]>
</Line>
</STContent>
</Routine>
</Routines>
