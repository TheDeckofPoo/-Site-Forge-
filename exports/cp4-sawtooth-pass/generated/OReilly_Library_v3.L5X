<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_F1" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
