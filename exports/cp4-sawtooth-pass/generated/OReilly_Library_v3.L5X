<Routine Name="HMI" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[/* HMI Color mapping ]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[		E-Stop Device Tripped:	 1 (Solid Red)]]>
</Line>
<Line Number="3">
<![CDATA[		E-Stop Ready to Reset:	 2 (Flashing Red)]]>
</Line>
<Line Number="4">
<![CDATA[		Faulted:				 4 (Red)]]>
</Line>
<Line Number="5">
<![CDATA[		Jam:					 6 (Orange)]]>
</Line>
<Line Number="6">
<![CDATA[		Full:					 8 (Yellow)]]>
</Line>
<Line Number="7">
<![CDATA[		Running:				10 (Green)]]>
</Line>
<Line Number="8">
<![CDATA[		Energy Managment:		12 (Sky Blue)]]>
</Line>
<Line Number="9">
<![CDATA[		Anit Gridlock:			14 (Light Pink)]]>
</Line>
<Line Number="10">
<![CDATA[		Manual Mode:			16 (Brown)]]>
</Line>
<Line Number="11">
<![CDATA[		Off or Inactive:		18 (Grey)]]>
</Line>
<Line Number="12">
<![CDATA[		Disabled:				20 (Purple)]]>
</Line>
<Line Number="13">
<![CDATA[		Cascade Stop:           22 (Light Green)]]>
</Line>
<Line Number="14">
<![CDATA[		Indexing:               24 (Magenta)]]>
</Line>
<Line Number="15">
<![CDATA[		]]>
</Line>
<Line Number="16">
<![CDATA[*/]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[//Constant Values ]]>
</Line>
<Line Number="19">
<![CDATA[//*****PLEASE DO NOT CHANGE*****]]>
</Line>
<Line Number="20">
<![CDATA[HMIColor.Estop := 2;]]>
</Line>
<Line Number="21">
<![CDATA[HMIColor.Fault := 4;]]>
</Line>
<Line Number="22">
<![CDATA[HMIColor.VFD_Fault := 4;]]>
</Line>
<Line Number="23">
<![CDATA[HMIColor.Jam := 6;]]>
</Line>
<Line Number="24">
<![CDATA[HMIColor.Full := 8;]]>
</Line>
<Line Number="25">
<![CDATA[HMIColor.Running := 10;]]>
</Line>
<Line Number="26">
<![CDATA[HMIColor.EngMgmt := 12;]]>
</Line>
<Line Number="27">
