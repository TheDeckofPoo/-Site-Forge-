<Routine Name="P336_Scanner" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[**************************************************************************************************
Find Token of the package when it is at P690 Scanner data transmit point
**************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[TRK_SearchToken_VirtualLocation(P336_SCN336_Token_Find,P336_SCN336.Offset,P336_Conv_Track,P336_Enc.PPI,Track_File_SCN336,HMI_StatsClear);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(P336_SCN336_Token_Find.O_Token_Found_Ack)MOV(P336_SCN336_Token_Find.O_Token_Found,P336_SCN336.TokenNumber)OTU(P336_SCN336_Token_Find.O_Token_Found_Ack);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[**********************************************************
Scanner - Communication Loss Fault
*********************************************************]]>
</Comment>
<Text>
<![CDATA[[NEQ(P336_SCN336.Comm_Code,16384) TON(P336_SCN336.CommLoss_Tmr,?,?) XIC(P336_SCN336.CommLoss_Tmr.DN) ,XIC(P336_SCN336.Flt.CommLoss) XIO(P336_Conv.Reset) ]OTE(P336_SCN336.Flt.CommLoss);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[************************************************************************************************************************
Copy Raw data from Scanner to input data string for Scanner AOI logic.
************************************************************************************************************************

]]>
</Comment>
<Text>
<![CDATA[NEQ(SCN336:I.Status.ResultID,P336_Scanner_Seq1_Pre)XIC(SCN336:I.Status.ResultsAvailable)[MOV(SCN336:I.Status.ResultLength,P336_Scanner_RawData_LEN) [GRT(P336_Scanner_RawData_LEN,128) MOV(128,P336_Scanner_RawData_LEN) ,LES(P336_Scanner_RawData_LEN,0) MOV(0,P336_Scanner_RawData_LEN) ] ,CPS(SCN336:I.ResultData[0],P336_Scanner_RawData_str.DATA[0],P336_Scanner_RawData_LEN) MOV(P336_Scanner_RawData_LEN,P336_Scanner_RawData_str.LEN) ,CPS(P336_Scanner_RawData_str,P336_SCN336.RawData,1) MOV(P336_Scanner_RawData_LEN,P336_SCN336.RawData.LEN) OTL(P336_SCN336.RawData_Available) ,ADD(1,P336_Scan_Raw_Data_History_Index,P336_Scan_Raw_Data_History_Index) GRT(P336_Scan_Raw_Data_History_Index,99) MOV(0,P336_Scan_Raw_Data_History_Index) ,COP(SCN336:I.ResultData[0],Raw_P336_Scanner_Data_History[P336_Scan_Raw_Data_History_Index].Raw_Data.DATA[0],SCN336:I.Status.ResultLength) MOV(SCN336:I.Status.ResultLength,Raw_P336_Scanner_Data_History[P336_Scan_Raw_Data_History_Index].Raw_Data.LEN) COP(PLC.String_DTS,Raw_P336_Scanner_Data_History[P336_Scan_Raw_Data_History_Index].Found_Timestamp,1) MOV(SCN336:I.Status.ResultID,Raw_P336_Scanner_Data_History[P336_Scan_Raw_Data_History_Index].Seq_Number) ,MOV(SCN336:I.Status.ResultID,P336_Scanner_Seq1_Pre) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(SCN336:I.Status.ResultsAvailable)TON(P336_Scanner_ResultsAvailable_Timer,?,?)XIC(P336_Scanner_ResultsAvailable_Timer.DN)OTE(SCN336:O.Control.ResultsAck);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[TRK_Scanner_TokenUpdate(SCN336_Token_Update_AOI,P336_SCN336,0,0,0,P336_Enc.PPI,P336_SCN336.TokenNumber,Token_SCN336[P336_SCN336.TokenNumber].ReasonCode_SINT,Token_SCN336[P336_SCN336.TokenNumber].Package_Length,Token_SCN336[P336_SCN336.TokenNumber].Barcode,NO_Read,MultiRead,NO_Data,HMI_StatsClear,HMI_ScanStatsClear,HMI_LifeTime_ScanStatsClear,P336_Conv.Reset,P336_Scanner_Offset_Find,PE336_I.PE_Clear,P336_ScanOffsetArray,Reason_Code_SINT.Success,Reason_Code_SINT.Induct_NoData,Reason_Code_SINT.Induct_NoRead,Reason_Code_SINT.Induct_Multiread);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[**************************************************************************************************
Find Token of the package when it is at WCS data transmit point
**************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[TRK_SearchToken_VirtualLocation(P336_WCS_Induct_MSG_Token_Find,P336_WCS_Induct_MSG_Offset,P336_Conv_Track,P336_Enc.PPI,Track_File_SCN336,HMI_StatsClear);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[*************************************'
Send Induct Message to Helix
*************************************]]>
</Comment>
<Text>
<![CDATA[XIC(P336_WCS_Induct_MSG_Token_Find.O_Token_Found_Ack)[GRT(Token_SCN336[P336_WCS_Induct_MSG_Token_Find.O_Token_Found].Package_Length,0) [MOV(P336_WCS_Induct_MSG_Token_Find.O_Token_Found,P336_Induct_Scan_WCS_Token_Found) MOV(P336_Induct_Scan_WCS_Token_Found,P336_Induct_Scan_WCS_Token_Found_Last) [OTL(SCN336_Induct_Decision_Request_Helix) ,OTL(P336_CartonData.CountUp) ] ,MOV(P336_Induct_Scan_WCS_Token_Found,P336_WCS_Resp_Token_ID) OTL(Processing_WCS_Response_Time_P336) ] ,OTU(P336_WCS_Induct_MSG_Token_Find.O_Token_Found_Ack) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[*************************************'****'
To record rsponse time from WCS
*****************************************']]>
</Comment>
<Text>
<![CDATA[TON(WCS_Response_Timer_P336,?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Processing_WCS_Response_Time_P336)[ONS(P336_MSG_Sent_to_WCS_ONS) MOV(P336_WCS_Resp_Token_ID,P336_WCS_Resp_Token_ID_Last) CLR(WCS_Response_Time_P336) RES(WCS_Response_Timer_P336) ,NEQ(Token_SCN336[P336_WCS_Resp_Token_ID].Destination[0],0) [MOV(WCS_Response_Timer_P336.ACC,WCS_Response_Time_P336) ,GRT(WCS_Response_Time_P336,0) GRT(WCS_Resp_Time_Interval_P336,0) DIV(WCS_Response_Time_P336,WCS_Resp_Time_Interval_P336,WCS_Time_History_Index_P336) LIM(0,WCS_Time_History_Index_P336,99) ADD(1,WCS_Response_Time_P336_History[WCS_Time_History_Index_P336],WCS_Response_Time_P336_History[WCS_Time_History_Index_P336]) ,GRT(WCS_Response_Time_P336,Max_WCS_Response_Time_P336) MOV(WCS_Response_Time_P336,Max_WCS_Response_Time_P336) ,GRT(WCS_Response_Time_P336,0) LES(WCS_Response_Time_P336,Min_WCS_Response_Time_P336) MOV(WCS_Response_Time_P336,Min_WCS_Response_Time_P336) ,OTU(Processing_WCS_Response_Time_P336) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Processing_WCS_Response_Time_P336)GEQ(WCS_Response_Timer_P336.ACC,WCS_Response_Wait_Timeout_P336)[OTU(Processing_WCS_Response_Time_P336) OTL(WCS_Response_Timed_Out_P336) ,ADD(1,Response_Timed_Out_CNT_P336,Response_Timed_Out_CNT_P336) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Reset_WCS_Respoinse_Time_History_P336)FLL(0,WCS_Response_Time_P336_History[0],100)OTU(Reset_WCS_Respoinse_Time_History_P336);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
