<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Helix_Heartbeat_Primary_CNTRL.ER) ,XIC(S:FS) ][XIC(Helix_Heartbeat_Primary.Error.Auto_Reset) OTE(Helix_Heartbeat_Primary.Error.Reset) ,XIO(S:FS) ONS(Helix_Heartbeat_Primary.Error.ONS) ADD(Helix_Heartbeat_Primary.Log.Error_Count,1,Helix_Heartbeat_Primary.Log.Error_Count) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Build a heartbeat message and add it to the FIFO. ]]>
</Comment>
<Text>
<![CDATA[XIC(PLC_Heartbeat_MSG_Send_Timer.DN)ONS(PLC_Heartbeat_MSG_Send_ONS)[ADD(1,PLC_Heartbeat_MSG_Counter,PLC_Heartbeat_MSG_Counter) ,GRT(PLC_Heartbeat_MSG_Counter,20000000) MOV(1,PLC_Heartbeat_MSG_Counter) ,COP(PLC_Heartbeat_Identifier,Helix_Heartbeat_Message.Data,1) ,COP(PLC_Heartbeat_MSG_Counter,Helix_Heartbeat_Message.SequenceNumber,1) ,COP(PLC.Helix_DTS[0],Helix_Heartbeat_Message.Timestamp[0],7) ,OTL(Helix_Heartbeat_Primary.Control.Send) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(Helix_Heartbeat_Primary.Error.Reset) ,XIC(Helix_Heartbeat_Primary.Error.Reset_Timer.TT) ][TON(Helix_Heartbeat_Primary.Error.Reset_Timer,?,?) ,XIC(Helix_Heartbeat_Primary.Error.Reset_Timer.DN) [OTU(Helix_Heartbeat_Primary_CNTRL.ER) ,OTU(Helix_Heartbeat_Primary_CNTRL.EN) ] ];]]>
</Text>
</Rung>
