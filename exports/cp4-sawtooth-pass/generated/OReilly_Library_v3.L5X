<Program Name="ShippingSorter_Area_L3" TestEdits="false" MainRoutineName="Main_Routine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Conv_Name" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[/*	Initialization Routine - Area Wide]]>
</Line>
<Line Number="1">
<![CDATA[		All logical values that should be set on reboot of the processor.]]>
</Line>
<Line Number="2">
<![CDATA[		Can be configured to reset from default values, configured values saved to memory, or HMI exported values.]]>
</Line>
<Line Number="3">
<![CDATA[		*/]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[//* Do not add or update any values in this Routine]]>
</Line>
<Line Number="6">
<![CDATA[//** These values can only be add or update while commissioning the system]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[//P336_Induct]]>
</Line>
<Line Number="9">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.LEN := 11;]]>
</Line>
<Line Number="10">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[0] := 80; //P]]>
</Line>
<Line Number="11">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[1] := 51; //3]]>
</Line>
<Line Number="12">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[2] := 51; //3]]>
</Line>
<Line Number="13">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[3] := 54; //6]]>
</Line>
<Line Number="14">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[4] := 95; //_]]>
</Line>
<Line Number="15">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[5] := 73; //I]]>
</Line>
<Line Number="16">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[6] := 110; //n]]>
</Line>
<Line Number="17">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[7] := 100; //d]]>
</Line>
<Line Number="18">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[8] := 117; //u]]>
</Line>
<Line Number="19">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[9] := 99; //c]]>
</Line>
<Line Number="20">
<![CDATA[P336_Conv_Track.CFG.Induct_Name.DATA[10] := 116; //t]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[//P336_Exit]]>
</Line>
<Line Number="24">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.LEN := 9;]]>
</Line>
<Line Number="25">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.DATA[0] := 80; //P]]>
</Line>
<Line Number="26">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.DATA[1] := 51; //3]]>
</Line>
<Line Number="27">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.DATA[2] := 51; //3]]>
</Line>
<Line Number="28">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.DATA[3] := 54; //6]]>
</Line>
<Line Number="29">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.DATA[4] := 95; //_]]>
</Line>
<Line Number="30">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.DATA[5] := 69; //E]]>
</Line>
<Line Number="31">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.DATA[6] := 120; //x]]>
</Line>
<Line Number="32">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.DATA[7] := 105; //i]]>
</Line>
<Line Number="33">
<![CDATA[P336_Conv_Track.CFG.Exit_Name.DATA[8] := 116; //t]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[//Sorter Divert Lane Numbers]]>
</Line>
<Line Number="37">
<![CDATA[P336_Divert1.CFG.Lane_Number := 1;]]>
</Line>
<Line Number="38">
