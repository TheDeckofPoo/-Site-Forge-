</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_GD" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Gregorian Day Number (calculated for given Y/M/D)]]>
</Description>
