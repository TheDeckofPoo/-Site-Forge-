</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_SecFrom_uSec" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Seconds to add from Microseconds]]>
</Description>
