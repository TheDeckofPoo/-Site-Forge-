<Dependency Type="AddOnInstructionDefinition" Name="AOI_TIME_DIFFERENCE"/>
<Dependency Type="DataType" Name="SKT_UDP_DATA"/>
<Dependency Type="DataType" Name="DateTime"/>
</Dependencies>
