<Text>
<![CDATA[COP(Empty_WCS_Inbound_MSG,O_Message_Deconstruct_IBMSG,1)MOV(1,Parse_IB_MSG_Search_Start_Position)MOV(0,Parse_IB_MSG_Found_Location)MOV(0,Parse_IB_MSG_Found_Location_Prev)MOV(0,Parse_IB_MSG_Start_Index);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[*******************************
Check for NAK message
*******************************]]>
</Comment>
<Text>
<![CDATA[GEQ(I_InboundMSG_Deconstruct_InputData.LEN,3)EQU(I_InboundMSG_Deconstruct_InputData.DATA[0],I_MSG_NAK.DATA[0])EQU(I_InboundMSG_Deconstruct_InputData.DATA[1],I_MSG_NAK.DATA[1])EQU(I_InboundMSG_Deconstruct_InputData.DATA[2],I_MSG_NAK.DATA[2])COP(I_MSG_NAK,O_Message_Deconstruct_IBMSG.AckNak,1)SUB(I_InboundMSG_Deconstruct_InputData.LEN,3,O_Payload_Len)GEQ(O_Payload_Len,0)MOV(O_Payload_Len,O_Message_Deconstruct_IBMSG.Custom.LEN)COP(I_InboundMSG_Deconstruct_InputData.DATA[4],O_Message_Deconstruct_IBMSG.Custom.DATA[0],82)JMP(End_Search);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[*******************************
Check for ACK message
*******************************]]>
</Comment>
<Text>
<![CDATA[GEQ(I_InboundMSG_Deconstruct_InputData.LEN,3)EQU(I_InboundMSG_Deconstruct_InputData.DATA[0],I_MSG_ACK.DATA[0])EQU(I_InboundMSG_Deconstruct_InputData.DATA[1],I_MSG_ACK.DATA[1])EQU(I_InboundMSG_Deconstruct_InputData.DATA[2],I_MSG_ACK.DATA[2])EQU(I_InboundMSG_Deconstruct_InputData.DATA[3],I_MSG_GroupSeperator.DATA[0])COP(I_MSG_ACK,O_Message_Deconstruct_IBMSG.AckNak,1)MOV(5,Parse_IB_MSG_Search_Start_Position)MOV(4,Parse_IB_MSG_Start_Index);]]>
