<Line Number="0">
<![CDATA[//Decision Point Names (Must match with WCS-BL service)]]>
</Line>
<Line Number="1">
<![CDATA[WCS_DecisionPoint_1 := 'SCNSHP1';]]>
</Line>
<Line Number="2">
<![CDATA[]]>
