<![CDATA[COP(PLC.String_DTS,O_Message_Deconstruct_IBMSG.Timestamp,1)RET(O_Message_Deconstruct_IBMSG);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SBR_Inbound_MSG_FIFO_Load" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[SBR(I_Parse_WCS_Read_MSG_Input,I_Parse_WCS_Read_MSG_Input_Len)NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SIZE(I_Parse_WCS_Read_MSG_Input[0],0,I_Parse_WCS_Read_MSG_Input_ArraySize);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[***************************************************************************************************************************
Enable Large Connection on the EN2T Read Socket Connection to read max character length of 3984.
This is to initialize max buffer length.
***************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[[LEQ(I_Parse_WCS_Read_MSG_Input_Len,I_Parse_WCS_Read_MSG_Input_ArraySize) MOV(I_Parse_WCS_Read_MSG_Input_Len,Max_Socket_WCS1_Read_Buffer_L) ,GRT(I_Parse_WCS_Read_MSG_Input_Len,WCS_TCP_CONN1_CFG.Read_Socket.Buffer_Length) MOV(WCS_TCP_CONN1_CFG.Read_Socket.Buffer_Length,Max_Socket_WCS1_Read_Buffer_L) ]SUB(WCS_TCP_CONN1_CFG.Read_Socket.Buffer_Length,20,Max_Socket_WCS1_Read_Buffer_L_Usable);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[***************************************************************************************************************************
Copy Input SINT data array to a String Tag for parsing
***************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[CPS(I_Parse_WCS_Read_MSG_Input[0],str_Parse_WCS1_Read_MSG_Data.DATA[0],Max_Socket_WCS1_Read_Buffer_L)MOV(Max_Socket_WCS1_Read_Buffer_L,str_Parse_WCS1_Read_MSG_Data.LEN);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[***************************************************************************************************************************
Initialize Tags before searching for multiple messages in the input data
***************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[MOV(1,IO_Parse_WCS1_MSG_SearchStart_Pos)MOV(0,Parse_WCS1_Length_Prev_Position)MOV(0,Parse_WCS1_Message_Found_Location)MOV(0,Parse_WCS1_Message_Start_Index)MOV(25,Min_MSG_Len_Expected)MOV(250,Max_MSG_Len_Expected)ADD(1,Min_MSG_Len_Expected,Min_Message_Length2)CPS(IO_WCS1_STX,WCS1_Search_str,1)OTU(M_STX_Not_Found);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[LBL(Start_Search)NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[CPS(Empty_TCP_Long_String,O_Parse_WCS1_Read_MSG_Output,1);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[***************************************************************************************************************************
Exit search if max search length of the input string is reached
***************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[GRT(IO_Parse_WCS1_MSG_SearchStart_Pos,Max_Socket_WCS1_Read_Buffer_L_Usable)JMP(End_Search);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[***************************************************************************************************************************
Search for STX (starting character) of a message.
***************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[FIND(str_Parse_WCS1_Read_MSG_Data,WCS1_Search_str,IO_Parse_WCS1_MSG_SearchStart_Pos,Parse_WCS1_Message_Found_Location);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[***************************************************************************************************************************
Exit search if no STX is found
***************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[EQU(Parse_WCS1_Message_Found_Location,0)EQU(Parse_WCS1_Length_Prev_Position,0)OTL(M_STX_Not_Found)JMP(End_Search);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[***************************************************************************************************************************
ETX not found - Terminate search
***************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(I_Enable_ETX_Search)EQU(Parse_WCS1_Message_Found_Location,0)NEQ(Parse_WCS1_Length_Prev_Position,0)JMP(End_Search);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[***************************************************************************************************************************
Jump to the begining of search after finding the first message location
***************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[[EQU(Parse_WCS1_Message_Found_Location,1) ,GRT(Parse_WCS1_Message_Found_Location,1) XIC(I_Enable_ETX_Search) ]EQU(WCS1_Search_str,IO_WCS1_STX)MOV(IO_Parse_WCS1_MSG_SearchStart_Pos,Parse_WCS1_Length_Prev_Position)ADD(IO_Parse_WCS1_MSG_SearchStart_Pos,IO_WCS1_STX.LEN,IO_Parse_WCS1_MSG_SearchStart_Pos)[XIO(I_Enable_ETX_Search) ADD(IO_Parse_WCS1_MSG_SearchStart_Pos,Min_MSG_Len_Expected,IO_Parse_WCS1_MSG_SearchStart_Pos) ,XIC(I_Enable_ETX_Search) CPS(IO_WCS1_ETX,WCS1_Search_str,1) ]JMP(Start_Search);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[***************************************************************************************************************************
Copy the message to FIFO array and jump to beginning of the search to find other messages.
***************************************************************************************************************************]]>
</Comment>
<Text>
