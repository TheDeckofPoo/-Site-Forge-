</Comment>
<Text>
<![CDATA[COP(PLC.String_DTS,IO_Heartbeat_MSG_Data.Timestamp,1)[ADD(WCS_Sequence_Number1,1,WCS_Sequence_Number1) GRT(WCS_Sequence_Number1,99999999) MOV(1,WCS_Sequence_Number1) ,MOV(WCS_Sequence_Number1,IO_Heartbeat_MSG_Data.SequenceNumber) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[ADD(IO_Heartbeat_MSG_Data.SequenceNumber,I_Padded_SeqNumConst,WCS_HB_MSG_SeqNum_Padded)DTOS(WCS_HB_MSG_SeqNum_Padded,WCS_HB_MSG_SeqNum_str)DELETE(WCS_HB_MSG_SeqNum_str,1,1,WCS_HB_MSG_SeqNum_str);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[*************************************************************
Format "Payload"
*************************************************************
]]>
</Comment>
<Text>
<![CDATA[CONCAT(I_CurlBracketOpen_str,I_Timestamp_Label_str,I_HB_MSG_Payload_str)CONCAT(I_HB_MSG_Payload_str,IO_Heartbeat_MSG_Data.Timestamp,I_HB_MSG_Payload_str)CONCAT(I_HB_MSG_Payload_str,I_DoubleQuotation_str,I_HB_MSG_Payload_str)CONCAT(I_HB_MSG_Payload_str,I_CurlBracketClose_str,I_HB_MSG_Payload_str);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[*************************************************************
Format full Heartbeat message
*************************************************************]]>
</Comment>
<Text>
<![CDATA[CONCAT(I_MSG_STX,WCS_TCP_CONN1_PLC_ID,IO_Heartbeat_MSG_Output_str)CONCAT(IO_Heartbeat_MSG_Output_str,I_MSG_GroupSeperator,IO_Heartbeat_MSG_Output_str)CONCAT(IO_Heartbeat_MSG_Output_str,WCS_HB_MSG_SeqNum_str,IO_Heartbeat_MSG_Output_str)CONCAT(IO_Heartbeat_MSG_Output_str,I_MSG_GroupSeperator,IO_Heartbeat_MSG_Output_str)CONCAT(IO_Heartbeat_MSG_Output_str,I_Heartbeat_MSG_Header,IO_Heartbeat_MSG_Output_str)CONCAT(IO_Heartbeat_MSG_Output_str,I_MSG_GroupSeperator,IO_Heartbeat_MSG_Output_str)CONCAT(IO_Heartbeat_MSG_Output_str,I_HB_MSG_Payload_str,IO_Heartbeat_MSG_Output_str)CONCAT(IO_Heartbeat_MSG_Output_str,I_MSG_ETX,IO_Heartbeat_MSG_Output_str);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[UIE();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[MSG_FIFO_Array_Load(WCS_Heartbeat_MSG_FIFO1_Load_AOI,WCS_Outbound_MSG_FIFO1,IO_Heartbeat_MSG_Output_str,HMI_Reset_FIFO_AOI_Stats);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
