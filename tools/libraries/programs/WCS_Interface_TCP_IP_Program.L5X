<Rung Number="5" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)SUB(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Search_Start_Position,Parse_WCS2_Message_Length)COP(I_InboundMSG_Deconstruct_InputData.DATA[Parse_IB_MSG_Start_Index],O_Message_Deconstruct_IBMSG.PLCID.DATA[0],Parse_WCS2_Message_Length)MOV(Parse_WCS2_Message_Length,O_Message_Deconstruct_IBMSG.PLCID.LEN);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[*******************************
Find Sequence Number
(Next 2 rungs)
*******************************]]>
</Comment>
<Text>
<![CDATA[MOV(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Start_Index)MOV(Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location_Prev)ADD(Parse_IB_MSG_Found_Location,1,Parse_IB_MSG_Search_Start_Position)FIND(I_InboundMSG_Deconstruct_InputData,I_MSG_GroupSeperator,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
