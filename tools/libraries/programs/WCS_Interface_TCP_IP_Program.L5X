<Rung Number="8" Type="N">
<Comment>
<![CDATA[*******************************
Find Message Header
(Next 2 rungs)
*******************************]]>
</Comment>
<Text>
<![CDATA[MOV(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Start_Index)MOV(Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location_Prev)ADD(Parse_IB_MSG_Found_Location,1,Parse_IB_MSG_Search_Start_Position)FIND(I_InboundMSG_Deconstruct_InputData,I_MSG_GroupSeperator,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQU(Parse_IB_MSG_Found_Location,0)LES(Parse_IB_MSG_Found_Location,I_InboundMSG_Deconstruct_InputData.LEN)SUB(I_InboundMSG_Deconstruct_InputData.LEN,Parse_IB_MSG_Start_Index,Parse_WCS2_Message_Length)COP(I_InboundMSG_Deconstruct_InputData.DATA[Parse_IB_MSG_Start_Index],O_Message_Deconstruct_IBMSG.Header.DATA[0],Parse_WCS2_Message_Length)MOV(Parse_WCS2_Message_Length,O_Message_Deconstruct_IBMSG.Header.LEN)JMP(End_Search);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[GRT(Parse_IB_MSG_Found_Location,1)SUB(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Search_Start_Position,Parse_WCS2_Message_Length)COP(I_InboundMSG_Deconstruct_InputData.DATA[Parse_IB_MSG_Start_Index],O_Message_Deconstruct_IBMSG.Header.DATA[0],Parse_WCS2_Message_Length)MOV(Parse_WCS2_Message_Length,O_Message_Deconstruct_IBMSG.Header.LEN);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[*******************************
Parse fields in "Payload"
*******************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[*******************************
Find "DecisionPoint"
(Next 5 rungs)
*******************************]]>
</Comment>
<Text>
<![CDATA[OTU(IO_DecResp_MSG_DecisionPoint_NotFound)ADD(Parse_IB_MSG_Found_Location,1,Parse_IB_MSG_Search_Start_Position)FIND(I_InboundMSG_Deconstruct_InputData,I_DecPoint_Label_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[EQU(Parse_IB_MSG_Found_Location,0)OTL(IO_DecResp_MSG_DecisionPoint_NotFound)JMP(Parsing_End);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)ADD(Parse_IB_MSG_Search_Start_Position,I_DecPoint_Label_str.LEN,Parse_IB_MSG_Search_Start_Position)FIND(I_InboundMSG_Deconstruct_InputData,I_DoubleQuotation_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)MOV(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Start_Index)ADD(Parse_IB_MSG_Found_Location,1,Parse_IB_MSG_Search_Start_Position)FIND(I_InboundMSG_Deconstruct_InputData,I_DoubleQuotation_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)SUB(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Search_Start_Position,Parse_WCS2_Message_Length)MOV(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Search_Start_Position)COP(I_InboundMSG_Deconstruct_InputData.DATA[Parse_IB_MSG_Start_Index],O_Message_Deconstruct_IBMSG.DecisionPoint.DATA[0],Parse_WCS2_Message_Length)MOV(Parse_WCS2_Message_Length,O_Message_Deconstruct_IBMSG.DecisionPoint.LEN);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[*******************************
Find "GIN"
(Next 4 rungs)
*******************************]]>
</Comment>
<Text>
<![CDATA[OTU(IO_DecResp_MSG_Gin_NotFound)FIND(I_InboundMSG_Deconstruct_InputData,I_GIN_Label_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[EQU(Parse_IB_MSG_Found_Location,0)OTL(IO_DecResp_MSG_Gin_NotFound)JMP(Parsing_End);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)ADD(Parse_IB_MSG_Search_Start_Position,I_GIN_Label_str.LEN,Parse_IB_MSG_Search_Start_Position)FIND(I_InboundMSG_Deconstruct_InputData,I_colon_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)MOV(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Start_Index)MOV(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Search_Start_Position)FIND(I_InboundMSG_Deconstruct_InputData,I_Comma_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[EQU(Parse_IB_MSG_Found_Location,0)FIND(I_InboundMSG_Deconstruct_InputData,I_CurlBracketClose_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)SUB(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Search_Start_Position,Parse_WCS2_Message_Length)MOV(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Search_Start_Position)COP(I_InboundMSG_Deconstruct_InputData.DATA[Parse_IB_MSG_Start_Index],Temp_DecResp_GIN_str.DATA[0],Parse_WCS2_Message_Length)MOV(Parse_WCS2_Message_Length,Temp_IB_MSG_GIN_str.LEN)STOD(Temp_DecResp_GIN_str,O_Message_Deconstruct_IBMSG.GIN);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[*******************************
Find "Actions"
(Next x rungs)
*******************************]]>
</Comment>
<Text>
<![CDATA[OTU(IO_DecResp_MSG_Actions_NotFound)FIND(I_InboundMSG_Deconstruct_InputData,I_Actions_Label_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[EQU(Parse_IB_MSG_Found_Location,0)OTL(IO_DecResp_MSG_Actions_NotFound)JMP(Parsing_End);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[MOV(0,Action_Item_Idx)ADD(Parse_IB_MSG_Found_Location,I_Actions_Label_str.LEN,Parse_IB_MSG_Search_Start_Position);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[LBL(Start_Action_Item_Search)NOP();]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)FIND(I_InboundMSG_Deconstruct_InputData,I_DoubleQuotation_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[EQU(Parse_IB_MSG_Found_Location,0)JMP(Parsing_End);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)ADD(Parse_IB_MSG_Found_Location,1,Parse_IB_MSG_Search_Start_Position)MOV(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Start_Index)FIND(I_InboundMSG_Deconstruct_InputData,I_DoubleQuotation_str,Parse_IB_MSG_Search_Start_Position,Parse_IB_MSG_Found_Location);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[GEQ(Parse_IB_MSG_Found_Location,1)SUB(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Search_Start_Position,Parse_WCS2_Message_Length)ADD(Parse_IB_MSG_Found_Location,1,Parse_IB_MSG_Search_Start_Position)COP(I_InboundMSG_Deconstruct_InputData.DATA[Parse_IB_MSG_Start_Index],O_Message_Deconstruct_IBMSG.Actions[Action_Item_Idx].DATA[0],Parse_WCS2_Message_Length)MOV(Parse_WCS2_Message_Length,O_Message_Deconstruct_IBMSG.Actions[Action_Item_Idx].LEN);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[ADD(Action_Item_Idx,1,Action_Item_Idx)GRT(Action_Item_Idx,9)JMP(Parsing_End);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[JMP(Start_Action_Item_Search);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[LBL(Parsing_End)NOP();]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[LBL(End_Search)NOP();]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
