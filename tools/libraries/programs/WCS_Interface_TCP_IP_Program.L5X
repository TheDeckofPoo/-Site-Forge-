<Routine Name="SBR_Inbound_MSG_Router" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*********************************************************************************
Message Router       
This code takes a message recieved from the TCP server   
     and routes it to the proper PLC Subroutine      
*********************************************************************************
]]>
</Comment>
<Text>
<![CDATA[SBR(I_WCS_MSG_Router_InputData)NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[*********************************************************************************     
NAK Message
This message is a not-acknowledgment to indicate the message received from TCP server is invalid.
*********************************************************************************
]]>
</Comment>
<Text>
<![CDATA[EQU(I_WCS_MSG_Router_InputData.AckNak,I_MSG_NAK)JSR(SBR_Inbound_MSG_NAK,1,I_WCS_MSG_Router_InputData.Custom)ADD(WCS_NAK_MSG_CNT,1,WCS_NAK_MSG_CNT);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[*********************************************************************************     
ACK Message
This message is a acknowledgment to indicate the message received from TCP server is valid.
*********************************************************************************
]]>
</Comment>
<Text>
<![CDATA[EQU(I_WCS_MSG_Router_InputData.AckNak,I_MSG_ACK)JSR(SBR_Inbound_MSG_ACK,1,I_WCS_MSG_Router_InputData)ADD(WCS_ACK_MSG_CNT,1,WCS_ACK_MSG_CNT);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[*********************************************************************************     
Decision Request Message
This message is a acknowledgment to indicate the message received from TCP server is valid.
*********************************************************************************]]>
</Comment>
<Text>
<![CDATA[EQU(I_WCS_MSG_Router_InputData.Header,I_DecRespMSG_Header)JSR(SBR_DecisionResponse_Update,1,I_WCS_MSG_Router_InputData)ADD(WCS_DecResp_MSG_CNT,1,WCS_DecResp_MSG_CNT);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
