<![CDATA[[ADD(WCS_Sequence_Number1,1,WCS_Sequence_Number1) GRT(WCS_Sequence_Number1,99999999) MOV(1,WCS_Sequence_Number1) ,MOV(WCS_Sequence_Number1,I_DecReq_MSG_Data.SequenceNumber) ];]]>
