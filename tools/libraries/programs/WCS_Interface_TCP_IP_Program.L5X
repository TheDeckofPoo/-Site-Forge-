<Rung Number="7" Type="N">
<Text>
<![CDATA[GRT(Parse_IB_MSG_Found_Location,1)SUB(Parse_IB_MSG_Found_Location,Parse_IB_MSG_Search_Start_Position,Parse_WCS2_Message_Length)COP(I_InboundMSG_Deconstruct_InputData.DATA[Parse_IB_MSG_Start_Index],str_SequenceNumber.DATA[0],Parse_WCS2_Message_Length)MOV(Parse_WCS2_Message_Length,str_SequenceNumber.LEN)STOD(str_SequenceNumber,O_Message_Deconstruct_IBMSG.SequenceNumber);]]>
