<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[//Initilize TCP/IP connection parameters]]>
</Line>
<Line Number="5">
<![CDATA[WCS_TCP_CONN1_CFG.Read_Socket.Buffer_Length := 3984; //3984 // For EN2T card: Enable "Large Connection" on "Read Socket Connection" communication method to read max character length of 3984. Otherwise use 480 for (not large connections). ]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[//WCS_TCP_CONN1_CFG.Open_Connection.DestinationAddress := '10.242.23.43?port=8000'; //'10.240.54.13?port=8000';QA]]>
</Line>
<Line Number="8">
<![CDATA[WCS_TCP_CONN1_CFG.Open_Connection.DestinationAddress := '10.232.23.68?port=32315'; //'10.240.54.13?port=8000';Prod]]>
</Line>
<Line Number="9">
<![CDATA[WCS_TCP_CONN1_PLC_ID := 'PLCID002'; // PLC_ID to identify the PLC name]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[WCS_TCP_CONN1_CFG.Open_Connection.Timeout := 5000; //Use Default 5000ms]]>
</Line>
<Line Number="12">
<![CDATA[WCS_TCP_CONN1_CFG.Write_Socket.Timeout := 5000; //Use Default 5000ms]]>
</Line>
<Line Number="13">
<![CDATA[WCS_TCP_CONN1_CFG.Read_Socket.Timeout := 0; //Must be always zero]]>
</Line>
<Line Number="14">
