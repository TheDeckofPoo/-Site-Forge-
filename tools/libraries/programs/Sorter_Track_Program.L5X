<Routine Name="Response_Time" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text><![CDATA[TON(WCS_Response_Timer_P504,?,?);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Text><![CDATA[XIC(Processing_WCS_Response_Time_P504)[ONS(P504_MSG_Sent_to_WCS_ONS) CLR(WCS_Response_Time_P504) RES(WCS_Response_Timer_P504) ,NEQ(Token_SCN1[P504_WCS_Resp_Token_ID].Destination[0],0) [MOV(WCS_Response_Timer_P504.ACC,WCS_Response_Time_P504) ,GRT(WCS_Response_Time_P504,0) GRT(WCS_Resp_Time_Interval_P504,0) DIV(WCS_Response_Time_P504,WCS_Resp_Time_Interval_P504,WCS_Time_History_Index_P504) LIM(0,WCS_Time_History_Index_P504,99) ADD(1,WCS_Response_Time_P504_History[WCS_Time_History_Index_P504],WCS_Response_Time_P504_History[WCS_Time_History_Index_P504]) ,GRT(WCS_Response_Time_P504,Max_WCS_Response_Time_P504) MOV(WCS_Response_Time_P504,Max_WCS_Response_Time_P504) ,GRT(WCS_Response_Time_P504,0) LES(WCS_Response_Time_P504,Min_WCS_Response_Time_P504) MOV(WCS_Response_Time_P504,Min_WCS_Response_Time_P504) ,OTU(Processing_WCS_Response_Time_P504) ] ];]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Text><![CDATA[XIC(Processing_WCS_Response_Time_P504)GEQ(WCS_Response_Timer_P504.ACC,WCS_Response_Wait_Timeout_P504)[OTU(Processing_WCS_Response_Time_P504) OTL(WCS_Response_Timed_Out_P504) ,ADD(1,Response_Timed_Out_CNT_P504,Response_Timed_Out_CNT_P504) ];]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Text><![CDATA[XIC(Reset_WCS_Respoinse_Time_History_P504)FLL(0,WCS_Response_Time_P504_History[0],100)OTU(Reset_WCS_Respoinse_Time_History_P504);]]></Text>
