<Routine Name="Gridlock_Prevention" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[************************************
First Scan Settings
************************************
]]>
</Comment>
<Text><![CDATA[XIC(S:FS)[MOV(0,P504_System.GLP_Timer.ACC) MOV(0,P504_System.RecircCNT) MOV(0,P504_System.Max_RecircCNT) MOV(15,P504_System.Recirc_Max) ,MOV(0,P504_System.GLPFull_Enable) MOV(0,P504_System.GLPCoolDN_Timer.ACC) ,OTU(P504_System.GLP_Enable) ];]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[************************************
GPL: Logic to count No. of boxes out of sorter in 30 seconds Next 2 Rung
************************************]]>
</Comment>
<Text><![CDATA[XIC(P510_Conv.Running)[XIO(P510_PE_J.PE_Clear) ,XIC(P504_System.GLP_Timer.TT) ,NEQ(P504_System.Max_RecircCNT,0) ]TON(P504_System.GLP_Timer,?,?);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Text><![CDATA[XIC(P510_Conv.Running)XIO(P510_PE_J.PE_Clear)ONS(P504_System.PE_ONS)ADD(P504_System.RecircCNT,1,P504_System.RecircCNT);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Text><![CDATA[[XIO(P504_System.GLP_Timer.DN) GEQ(P504_System.RecircCNT,P504_System.Recirc_Max) MOV(1,P504_System.Max_RecircCNT) ,XIC(P504_System.GLP_Timer.DN) LES(P504_System.RecircCNT,P504_System.Recirc_Max) MOV(0,P504_System.Max_RecircCNT) ][RES(P504_System.GLP_Timer) ,MOV(0,P504_System.RecircCNT) ];]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[PACK_WITHHELD: source rung bound to foreign device/module; site binding required]]>
</Comment>
<Text><![CDATA[NOP();]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[PACK_WITHHELD: source rung bound to foreign device/module; site binding required]]>
</Comment>
<Text><![CDATA[NOP();]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[************************************
GPL: Bits for HMI 
************************************]]>
</Comment>
<Text><![CDATA[XIC(P504_System.GLPCoolDN_Timer.TT)OTE(P504_System.HMI.CoolDN_TmrActive);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Text><![CDATA[NEQ(P504_System.Max_RecircCNT,0)OTE(P504_System.HMI.RecircMaxCnt_GLPEnable);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Text><![CDATA[NEQ(P504_System.GLPFull_Enable,0)OTE(P504_System.HMI.RecircFull_GLPEnable);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text><![CDATA[JSR(Encoder,0);]]></Text>
</Rung>
