<Routine Name="Gridlock_Prevention" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[************************************
First Scan Settings
************************************
]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[MOV(0,P504_System.GLP_Timer.ACC) MOV(0,P504_System.RecircCNT) MOV(0,P504_System.Max_RecircCNT) MOV(15,P504_System.Recirc_Max) ,MOV(0,P504_System.GLPFull_Enable) MOV(0,P504_System.GLPCoolDN_Timer.ACC) ,OTU(P504_System.GLP_Enable) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[************************************
GPL: Logic to count No. of boxes out of sorter in 30 seconds Next 2 Rung
************************************]]>
</Comment>
<Text>
<![CDATA[XIC(P510_Conv.Running)[XIO(PE510_J.PE_Clear) ,XIC(P504_System.GLP_Timer.TT) ,NEQ(P504_System.Max_RecircCNT,0) ]TON(P504_System.GLP_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(P510_Conv.Running)XIO(PE510_J.PE_Clear)ONS(P504_System.PE_ONS)ADD(P504_System.RecircCNT,1,P504_System.RecircCNT);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(P504_System.GLP_Timer.DN) GEQ(P504_System.RecircCNT,P504_System.Recirc_Max) MOV(1,P504_System.Max_RecircCNT) ,XIC(P504_System.GLP_Timer.DN) LES(P504_System.RecircCNT,P504_System.Recirc_Max) MOV(0,P504_System.Max_RecircCNT) ][RES(P504_System.GLP_Timer) ,MOV(0,P504_System.RecircCNT) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[************************************
GPL: Logic to check full condition
************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(EZPE536_F.Full) XIC(EZPE542_F.Full) ONS(P504_GLP_On) MOV(1,P504_System.GLPFull_Enable) ,XIO(EZPE536_F.Full) XIO(EZPE542_F.Full) ONS(P504_GLP_Off) MOV(0,P504_System.GLPFull_Enable) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[************************************
GridLock Prevent Enable Logic
************************************]]>
</Comment>
<Text>
<![CDATA[[[EQU(P504_System.GLPFull_Enable,1) ,EQU(P504_System.Max_RecircCNT,1) ] ,EQU(P504_System.GLPFull_Enable,0) EQU(P504_System.Max_RecircCNT,0) TON(P504_System.GLPCoolDN_Timer,?,?) XIO(P504_System.GLPCoolDN_Timer.DN) ][OTE(P500_Conv.Anti_Gridlock) ,OTE(P500A_Conv.Anti_Gridlock) ,OTE(P502_Conv.Anti_Gridlock) ,OTE(P504_System.GLP_Enable) ,OTE(P504_Conv.Anti_Gridlock) ,OTE(P506_Conv.Anti_Gridlock) ,OTE(P508_Conv.Anti_Gridlock) ,OTE(P509_Conv.Anti_Gridlock) ,OTE(P510_Conv.Anti_Gridlock) ,OTE(P550_Conv.Anti_Gridlock) ,OTE(P554_Conv.Anti_Gridlock) ,OTE(P560_Conv.Anti_Gridlock) ,OTE(P564_Conv.Anti_Gridlock) ,OTE(P566_Conv.Anti_Gridlock) ,OTE(P526_Conv.Anti_Gridlock) ,OTE(P528_Conv.Anti_Gridlock) ,OTE(P530_P1_Conv.Anti_Gridlock) ,OTE(P530_P2_Conv.Anti_Gridlock) ,OTE(P534_Conv.Anti_Gridlock) ,OTE(P536_Conv.Anti_Gridlock) ,OTE(P542_Conv.Anti_Gridlock) ,OTE(P544_Conv.Anti_Gridlock) ,OTE(P712_Conv.Anti_Gridlock) ,OTE(P716_Conv.Anti_Gridlock) ,OTE(P718_Conv.Anti_Gridlock) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[************************************
GPL: Bits for HMI 
************************************]]>
</Comment>
<Text>
<![CDATA[XIC(P504_System.GLPCoolDN_Timer.TT)OTE(P504_System.HMI.CoolDN_TmrActive);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NEQ(P504_System.Max_RecircCNT,0)OTE(P504_System.HMI.RecircMaxCnt_GLPEnable);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[NEQ(P504_System.GLPFull_Enable,0)OTE(P504_System.HMI.RecircFull_GLPEnable);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
