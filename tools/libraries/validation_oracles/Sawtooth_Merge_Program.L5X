<Line Number="0">
<![CDATA[//Collector belt config parameters]]>
</Line>
<Line Number="1">
<![CDATA[#region]]>
</Line>
<Line Number="2">
<![CDATA[MRG414_stCollTrkSysCfg.diClctrRunoutDist 			:= P414_SawMerge_HMI.ClctrRunOutDist; //Collector belt length // pulses]]>
</Line>
<Line Number="3">
<![CDATA[MRG414_stCollTrkSysCfg.diClctrSrtSafteyTmrPreset 	:= P414_SawMerge_HMI.ClctrSrtSafteyTmrPreset; // milliseconds]]>
</Line>
<Line Number="4">
<![CDATA[MRG414_rCollSpdFeedback_IPS							:= P414_Enc.FPM / 5.0;]]>
</Line>
<Line Number="5">
<![CDATA[MRG414_stCollTrkSysCfg.rClctrSpd_FPM				:= P414_SawMerge_HMI.ClctrSpeed_FPM; //Nominal speed of collector belt]]>
</Line>
<Line Number="6">
<![CDATA[MRG414_stCollTrkSysCfg.rClctrSpd_IPS 				:= MRG414_stCollTrkSysCfg.rClctrSpd_FPM / 5.0;]]>
</Line>
<Line Number="7">
<![CDATA[P414_Conv.Spd 										:= MRG414_stCollTrkSysCfg.rClctrSpd_FPM;]]>
</Line>
<Line Number="8">
<![CDATA[P418_Conv.Spd 										:= MRG414_stCollTrkSysCfg.rClctrSpd_FPM;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[IF NOT P414_Conv.HMI.Manual THEN]]>
</Line>
<Line Number="11">
<![CDATA[	MRG414_stCollStatus.xClctrRunningAtSpeed := (((MRG414_rCollSpeed_IPS * 100.0) / (MRG414_stCollTrkSysCfg.rClctrSpd_FPM/5)) > 95.0); // Collector conveyor speed should be in IPS]]>
</Line>
<Line Number="12">
<![CDATA[ELSE]]>
</Line>
<Line Number="13">
<![CDATA[	MRG414_stCollStatus.xClctrRunningAtSpeed := 0;]]>
</Line>
<Line Number="14">
<![CDATA[END_IF;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[//Calculate extra gap from no product timer. This will be used to delete unused reservation on tracking array.]]>
</Line>
<Line Number="17">
<![CDATA[MRG414_diNoCartonGap := (P414_SawMerge_HMI.ClctrSpeed_FPM * MRG414_astUNL_SlugBldCfg[1].diQ2_NoCartonTime / 4220) - 10; //Gap created on collector during no product detection timer]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[MRG414_xSystemDrivesConfigured 			:= 1; // Merge logic will not function if this is 0. Need external tag tie in?]]>
</Line>
<Line Number="20">
<![CDATA[MRG414_xUnloadLaneConfigured 			:= 1; // Merge logic will not function if this is 0. Need external tag tie in?]]>
</Line>
<Line Number="21">
<![CDATA[MRG414_Enable_NoCartonCheck				:= 1; // Enable to stop lane releasing if no carton time has expired]]>
</Line>
<Line Number="22">
<![CDATA[MRG414_xShiftUpstrmSlotsAfterNoCarton 	:= 1; // Enable to check if upstream reserved slots can be moved downstream to fill in the vacant space after no carton time has expired]]>
</Line>
<Line Number="23">
<![CDATA[#endregion]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[//Collector belt PE Map]]>
</Line>
<Line Number="26">
<![CDATA[#region Map the Collector Belt Photo-Eye Inputs to the PE structure]]>
</Line>
<Line Number="27">
<![CDATA[MRG414_astCollPe[1].xIsBlocked 	:= NOT(PE219A_J.I.PE_Clear); ]]>
</Line>
<Line Number="28">
<![CDATA[MRG414_astCollPe[2].xIsBlocked 	:= NOT(PE414A_J.I.PE_Clear); ]]>
</Line>
<Line Number="29">
<![CDATA[MRG414_astCollPe[3].xIsBlocked 	:= NOT(PE414B_J.I.PE_Clear); ]]>
</Line>
<Line Number="30">
<![CDATA[MRG414_astCollPe[4].xIsBlocked 	:= NOT(PE414C_J.I.PE_Clear); ]]>
</Line>
<Line Number="31">
<![CDATA[MRG414_astCollPe[5].xIsBlocked	:= NOT(PE414D_J.I.PE_Clear); ]]>
</Line>
<Line Number="32">
<![CDATA[MRG414_astCollPe[6].xIsBlocked	:= NOT(PE414_J.I.PE_Clear); // Last PE: Exit PE of the collector belt // Number of lanes + 1 // For this 5 lane setup]]>
</Line>
<Line Number="33">
<![CDATA[MRG414_astCollPe[7].xIsBlocked	:= 0; //0 = Not used  ]]>
</Line>
<Line Number="34">
<![CDATA[MRG414_astCollPe[8].xIsBlocked	:= 0; //0 = Not used  ]]>
</Line>
<Line Number="35">
<![CDATA[MRG414_astCollPe[9].xIsBlocked	:= 0; //0 = Not used  ]]>
</Line>
<Line Number="36">
<![CDATA[MRG414_astCollPe[10].xIsBlocked := 0; //0 = Not used  ]]>
</Line>
<Line Number="37">
<![CDATA[MRG414_astCollPe[11].xIsBlocked := 0; //0 = Not used  ]]>
</Line>
<Line Number="38">
<![CDATA[MRG414_astCollPe[12].xIsBlocked := 0; //0 = Not used  // Last PE: Exit PE of the collector belt // Number of lanes + 1 // *** Max 11 Lanes]]>
</Line>
<Line Number="39">
<![CDATA[#endregion]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[//Lane [1] IO Map]]>
</Line>
<Line Number="42">
<![CDATA[#region //Lane [1] IO Map]]>
</Line>
<Line Number="43">
<![CDATA[// PE Map]]>
</Line>
<Line Number="44">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[1].xPE_BlockedExit 	:= 0; // Exit PE on Spur/Inject conveyor (MRG) // No PE]]>
</Line>
<Line Number="45">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[1].xPE_BlockedEntr  	:= 0; // NOT(PE2426_I.I.PE_Clear); // Entry PE on Staging Belt (Q2)]]>
</Line>
<Line Number="46">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[1].xPE_BlockedExit  	:= NOT(PE219_P.I.PE_Clear); // Exit PE on Staging conveyor (Q2)]]>
</Line>
<Line Number="47">
<![CDATA[MRG414_astUNL_Q1_CnvCtrl[1].xPE_BlockedEntr 	:= 0; //0 = Not used // Entry PE on Gap&Store Belt (Q1) ]]>
</Line>
<Line Number="48">
<![CDATA[MRG414_astUNL_Q1_CnvCtrl[1].xPE_BlockedExit 	:= 0; //0 = Not used // Exit PE on Gap&Store Belt (Q1) ]]>
</Line>
<Line Number="49">
<![CDATA[MRG414_astUNL_GPR_CnvCtrl[1].xPE_BlockedEntr 	:= 0; //0 = Not used // Entry PE on Gapper Belt (GPR) ]]>
</Line>
<Line Number="50">
<![CDATA[MRG414_astUNL_GPR_CnvCtrl[1].xPE_BlockedExit 	:= 0; //0 = Not used // Exit PE on Gapper Belt (GPR) ]]>
</Line>
<Line Number="51">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[1].xPE_BlockedEntr 	:= // Not used ]]>
</Line>
<Line Number="52">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[1].xPE_BlockedExit 	:= // Not used ]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[//Conveyor Run Status]]>
</Line>
<Line Number="55">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[1].xCnvRunning   		:= P219A_Conv.Running; // Spur/Inject Conveyor Running Status]]>
</Line>
<Line Number="56">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[1].rDesireSpeed_FPM  	:= P414_SawMerge_HMI.ClctrSpeed_FPM; // Spur/Inject Conveyor Commanded Speed to run]]>
</Line>
<Line Number="57">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[1].rDesireSpeed_IPS  	:= MRG414_astUNL_MRG_CnvCtrl[1].rDesireSpeed_FPM / 5; // Speed in inches per second]]>
</Line>
<Line Number="58">
<![CDATA[P219A_Conv.Spd									:= MRG414_astUNL_MRG_CnvCtrl[1].rDesireSpeed_FPM; // Commanded Speed to run]]>
</Line>
<Line Number="59">
<![CDATA[MRG414_astUNL_PT_CnvCtrl[1].xCnvRunning 		:= P219_Conv.Running; // Power turn conveyor running status (PT is slaved to staging conveyor). If PT conveyor doesn't exist then use the running signal of the staging conveyor for merge logic to work.]]>
</Line>
<Line Number="60">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[1].xCnvRunning    		:= P219_Conv.Running; // Staging Conveyor Running Status]]>
</Line>
<Line Number="61">
<![CDATA[P219_Conv.Spd									:= 225; // Commanded Speed to run]]>
</Line>
<Line Number="62">
<![CDATA[/*]]>
</Line>
<Line Number="63">
<![CDATA[MRG422_astUNL_Q1_CnvCtrl[1].xCnvRunning    		:= P2501_Conv.Running; // Gap&Store Conveyor Running Status]]>
</Line>
<Line Number="64">
<![CDATA[P2501_Conv.Spd									:= MRG422_astUNL_Q1_CnvCtrl[1].rDesireSpeed_IPS * 5; // Commanded Speed to run ]]>
</Line>
<Line Number="65">
<![CDATA[MRG422_astUNL_GPR_CnvCtrl[1].xCnvRunning    	:= M824_Conv.Running; // Gapper Conveyor Running Status]]>
</Line>
<Line Number="66">
<![CDATA[M824_Conv.Spd 									:= MRG422_astUNL_GPR_CnvCtrl[1].rDesireSpeed_IPS * 5 / 1.5; //Gear ratio = 1.5]]>
</Line>
<Line Number="67">
<![CDATA[*/]]>
</Line>
<Line Number="68">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[1].xInterlock_OUT		:= (MRG414_astLaneClctrSlotResvStat[1].diLaneMode = 2) OR (MRG414_astLaneClctrSlotResvStat[1].xLaneMerging AND (MRG414_astLaneClctrSlotResvStat[1].diLaneMode = 1));]]>
</Line>
<Line Number="69">
<![CDATA[P219A_Conv.PI.Run_Hold 							:= NOT (MRG414_astUNL_MRG_CnvCtrl[1].xInterlock_OUT AND MRG414_astUNL_MRG_CnvCtrl[1].rDesireSpeed_IPS > 0); ]]>
</Line>
<Line Number="70">
<![CDATA[ ]]>
</Line>
<Line Number="71">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[1].xInterlock_OUT := (MRG414_astUNL_SlugBldCtrl[1].xSlugReleasing_Q2 OR MRG414_astUNL_SlugBldCtrl[1].xSlugAccepting_Q2) AND MRG414_astUNL_Q2_CnvCtrl[1].xCnvReadyToRun AND MRG414_astUNL_PT_CnvCtrl[1].xCnvReadyToRun;]]>
</Line>
<Line Number="72">
<![CDATA[P219_Conv.PI.Run_Hold := not MRG414_astUNL_Q2_CnvCtrl[1].xInterlock_OUT and not PE219_P.I.PE_Clear;]]>
</Line>
<Line Number="73">
<![CDATA[]]>
</Line>
<Line Number="74">
<![CDATA[// Conveyor Faulted Status]]>
</Line>
<Line Number="75">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[1].xCnvFaulted := P219A_Conv.Flt.Flt;]]>
</Line>
<Line Number="76">
<![CDATA[MRG414_astUNL_PT_CnvCtrl[1].xCnvFaulted  := P219_Conv.Flt.Flt;]]>
</Line>
<Line Number="77">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[1].xCnvFaulted  := P219_Conv.Flt.Flt;]]>
</Line>
<Line Number="78">
<![CDATA[//MRG422_astUNL_Q1_CnvCtrl[1].xCnvFaulted  := P2501_Conv.Flt.Flt;]]>
</Line>
<Line Number="79">
<![CDATA[//MRG422_astUNL_GPR_CnvCtrl[1].xCnvFaulted := M824_Conv.Flt.Flt;]]>
</Line>
<Line Number="80">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[1].xCnvFaulted := M824_Conv.Flt.Flt;]]>
</Line>
<Line Number="81">
<![CDATA[]]>
</Line>
<Line Number="82">
<![CDATA[// Conveyor Restart Required Status]]>
</Line>
<Line Number="83">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[1].xCnvRestartReq := NOT P219A_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="84">
<![CDATA[MRG414_astUNL_PT_CnvCtrl[1].xCnvRestartReq  := NOT P219_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="85">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[1].xCnvRestartReq  := NOT P219_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="86">
<![CDATA[//MRG422_astUNL_Q1_CnvCtrl[1].xCnvRestartReq 	:= NOT P2501_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="87">
<![CDATA[//MRG422_astUNL_GPR_CnvCtrl[1].xCnvRestartReq := NOT M824_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="88">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[1].xCnvRestartReq := NOT M824_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="89">
<![CDATA[]]>
</Line>
<Line Number="90">
<![CDATA[// Set lane control flags Lane [1]]]>
</Line>
<Line Number="91">
<![CDATA[IF P219_Conv.RestartTmr_DN THEN]]>
</Line>
<Line Number="92">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[1].xLaneRunEnable := 1;]]>
</Line>
<Line Number="93">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[1].xLaneStop 		:= 0;]]>
</Line>
<Line Number="94">
<![CDATA[ELSE ]]>
</Line>
<Line Number="95">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[1].xLaneRunEnable := 0;	]]>
</Line>
<Line Number="96">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[1].xLaneStop 		:= 1;]]>
</Line>
<Line Number="97">
<![CDATA[END_IF;]]>
</Line>
<Line Number="98">
<![CDATA[MRG414_astUNL_SlugBldCtrl[1].xLaneMaintMode 	:= P219A_Conv.HMI.Manual OR P219_Conv.HMI.Manual; //If any conveyor in Manual Mode  // OR P2426_Conv.HMI.Manual OR P2501_Conv.HMI.Manual]]>
</Line>
<Line Number="99">
<![CDATA[]]>
</Line>
<Line Number="100">
<![CDATA[IF MRG414_astUNL_SlugBldCtrl[1].xLaneRunEnable AND MRG414_astUNL_MRG_CnvCtrl[1].xCnvReadyToRun AND MRG414_astUNL_PT_CnvCtrl[1].xCnvReadyToRun then]]>
</Line>
<Line Number="101">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[1].xLaneStartupEnable := 1;]]>
</Line>
<Line Number="102">
<![CDATA[ELSE ]]>
</Line>
<Line Number="103">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[1].xLaneStartupEnable := 0;]]>
</Line>
<Line Number="104">
<![CDATA[END_IF;]]>
</Line>
<Line Number="105">
<![CDATA[#endregion]]>
</Line>
<Line Number="106">
<![CDATA[]]>
</Line>
<Line Number="107">
