</Line>
<Line Number="108">
<![CDATA[#region]]>
</Line>
<Line Number="109">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[2].xPE_BlockedExit 	:= 0; // Exit PE on Spur conveyor (MRG) // No PE]]>
</Line>
<Line Number="110">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[2].xPE_BlockedEntr  	:= 0;//NOT(PE3452_I.I.PE_Clear); // Entry PE on Staging Belt (Q2);]]>
</Line>
<Line Number="111">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[2].xPE_BlockedExit  	:= NOT(PE410_P.I.PE_Clear); // Exit PE on Staging conveyor (Q2);]]>
</Line>
<Line Number="112">
<![CDATA[MRG414_astUNL_Q1_CnvCtrl[2].xPE_BlockedEntr 	:= 0;//NOT(PE3451_I.I.PE_Clear);]]>
</Line>
<Line Number="113">
<![CDATA[MRG414_astUNL_Q1_CnvCtrl[2].xPE_BlockedExit 	:= 0;//NOT(PE3451_P.I.PE_Clear);]]>
</Line>
<Line Number="114">
<![CDATA[MRG414_astUNL_GPR_CnvCtrl[2].xPE_BlockedEntr 	:= 0;//NOT(PE410_I.I.PE_Clear);]]>
</Line>
<Line Number="115">
<![CDATA[MRG414_astUNL_GPR_CnvCtrl[2].xPE_BlockedExit 	:= 0;//NOT(PE410_P.I.PE_Clear);]]>
</Line>
<Line Number="116">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[2].xPE_BlockedEntr 		:= NOT(UNL185_2_PE01_IN);]]>
</Line>
<Line Number="117">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[2].xPE_BlockedExit 		:= NOT(UNL185_2_PE02_IN);]]>
</Line>
<Line Number="118">
<![CDATA[]]>
</Line>
<Line Number="119">
<![CDATA[//Conveyor Run Status]]>
</Line>
<Line Number="120">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[2].xCnvRunning   		:= P412_Conv.Running;]]>
</Line>
<Line Number="121">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[2].rDesireSpeed_FPM  	:= P414_SawMerge_HMI.ClctrSpeed_FPM; ]]>
</Line>
<Line Number="122">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[2].rDesireSpeed_IPS  	:= MRG414_astUNL_MRG_CnvCtrl[2].rDesireSpeed_FPM / 5; ]]>
</Line>
<Line Number="123">
<![CDATA[P412_Conv.Spd									:= MRG414_astUNL_MRG_CnvCtrl[2].rDesireSpeed_FPM;]]>
</Line>
<Line Number="124">
<![CDATA[MRG414_astUNL_PT_CnvCtrl[2].xCnvRunning 		:= P410_Conv.Running; ]]>
</Line>
<Line Number="125">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[2].xCnvRunning    		:= P410_Conv.Running; ]]>
</Line>
<Line Number="126">
<![CDATA[P410_Conv.Spd									:= 225; //MRG422_astUNL_Q2_CnvCtrl[2].rDesireSpeed_IPS * 5 / 1.5; //1.5= Gear Ratio on gapper; ]]>
</Line>
<Line Number="127">
<![CDATA[]]>
</Line>
<Line Number="128">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[2].xInterlock_OUT		:= (MRG414_astLaneClctrSlotResvStat[2].diLaneMode = 2) OR (MRG414_astLaneClctrSlotResvStat[2].xLaneMerging AND (MRG414_astLaneClctrSlotResvStat[2].diLaneMode = 1));]]>
</Line>
<Line Number="129">
<![CDATA[P412_Conv.PI.Run_Hold 							:= NOT (MRG414_astUNL_MRG_CnvCtrl[2].xInterlock_OUT AND MRG414_astUNL_MRG_CnvCtrl[2].rDesireSpeed_IPS > 0); ]]>
</Line>
<Line Number="130">
<![CDATA[ ]]>
</Line>
<Line Number="131">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[2].xInterlock_OUT := (MRG414_astUNL_SlugBldCtrl[2].xSlugReleasing_Q2 OR MRG414_astUNL_SlugBldCtrl[2].xSlugAccepting_Q2) AND MRG414_astUNL_Q2_CnvCtrl[2].xCnvReadyToRun AND MRG414_astUNL_PT_CnvCtrl[2].xCnvReadyToRun;]]>
</Line>
<Line Number="132">
<![CDATA[P410_Conv.PI.Run_Hold := not MRG414_astUNL_Q2_CnvCtrl[2].xInterlock_OUT and not PE410_P.I.PE_Clear;]]>
</Line>
<Line Number="133">
<![CDATA[]]>
</Line>
<Line Number="134">
<![CDATA[// Conveyor Faulted Status]]>
</Line>
<Line Number="135">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[2].xCnvFaulted := P412_Conv.Flt.Flt;]]>
</Line>
<Line Number="136">
<![CDATA[MRG414_astUNL_PT_CnvCtrl[2].xCnvFaulted  := P410_Conv.Flt.Flt;]]>
</Line>
<Line Number="137">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[2].xCnvFaulted  := P410_Conv.Flt.Flt;]]>
</Line>
<Line Number="138">
<![CDATA[//MRG422_astUNL_Q1_CnvCtrl[2].xCnvFaulted  := P3451_Conv.Flt.Flt;]]>
</Line>
<Line Number="139">
<![CDATA[//MRG422_astUNL_GPR_CnvCtrl[2].xCnvFaulted := M410_Conv.Flt.Flt;]]>
</Line>
<Line Number="140">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[2].xCnvFaulted := M410_Conv.Flt.Flt;]]>
</Line>
<Line Number="141">
<![CDATA[]]>
</Line>
<Line Number="142">
<![CDATA[// Conveyor Restart Required Status]]>
</Line>
<Line Number="143">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[2].xCnvRestartReq := NOT P412_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="144">
<![CDATA[MRG414_astUNL_PT_CnvCtrl[2].xCnvRestartReq  := NOT P410_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="145">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[2].xCnvRestartReq  := NOT P410_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="146">
<![CDATA[//MRG422_astUNL_Q1_CnvCtrl[2].xCnvRestartReq 	:= NOT P3451_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="147">
<![CDATA[//MRG422_astUNL_GPR_CnvCtrl[2].xCnvRestartReq := NOT M410_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="148">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[2].xCnvRestartReq := NOT M410_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="149">
<![CDATA[]]>
</Line>
<Line Number="150">
<![CDATA[// Set lane control flags Lane [2]]]>
</Line>
<Line Number="151">
<![CDATA[IF P410_Conv.RestartTmr_DN THEN]]>
</Line>
<Line Number="152">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[2].xLaneRunEnable := 1;]]>
</Line>
<Line Number="153">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[2].xLaneStop 		:= 0;]]>
</Line>
<Line Number="154">
<![CDATA[ELSE ]]>
</Line>
<Line Number="155">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[2].xLaneRunEnable := 0;	]]>
</Line>
<Line Number="156">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[2].xLaneStop 		:= 1;]]>
</Line>
<Line Number="157">
<![CDATA[END_IF;]]>
</Line>
<Line Number="158">
<![CDATA[MRG414_astUNL_SlugBldCtrl[2].xLaneMaintMode 	:= P412_Conv.HMI.Manual OR P410_Conv.HMI.Manual; //If any conveyor in Manual Mode // OR P3452_Conv.HMI.Manual OR P3451_Conv.HMI.Manual]]>
</Line>
<Line Number="159">
<![CDATA[]]>
</Line>
<Line Number="160">
<![CDATA[IF MRG414_astUNL_SlugBldCtrl[2].xLaneRunEnable AND MRG414_astUNL_MRG_CnvCtrl[2].xCnvReadyToRun AND MRG414_astUNL_PT_CnvCtrl[2].xCnvReadyToRun then]]>
</Line>
<Line Number="161">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[2].xLaneStartupEnable := 1;]]>
</Line>
<Line Number="162">
<![CDATA[ELSE ]]>
