<![CDATA[MRG414_astUNL_Q2_CnvCtrl[5].xCnvFaulted  := P834_Conv.Flt.Flt;]]>
</Line>
<Line Number="325">
<![CDATA[//MRG422_astUNL_Q1_CnvCtrl[5].xCnvFaulted  := P1491_Conv.Flt.Flt;]]>
</Line>
<Line Number="326">
<![CDATA[//MRG422_astUNL_GPR_CnvCtrl[5].xCnvFaulted := M216_Conv.Flt.Flt;]]>
</Line>
<Line Number="327">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[5].xCnvFaulted := M216_Conv.Flt.Flt;]]>
</Line>
<Line Number="328">
<![CDATA[]]>
</Line>
<Line Number="329">
<![CDATA[// Conveyor Restart Required Status]]>
</Line>
<Line Number="330">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[5].xCnvRestartReq := NOT P836_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="331">
<![CDATA[MRG414_astUNL_PT_CnvCtrl[5].xCnvRestartReq  := NOT P834_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="332">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[5].xCnvRestartReq  := NOT P834_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="333">
<![CDATA[//MRG422_astUNL_Q1_CnvCtrl[5].xCnvRestartReq 	:= NOT P1491_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="334">
<![CDATA[//MRG422_astUNL_GPR_CnvCtrl[5].xCnvRestartReq := NOT M216_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="335">
<![CDATA[//MRG422_astUNL_BFR_CnvCtrl[5].xCnvRestartReq := NOT M216_Conv.RestartTmr_DN;]]>
</Line>
<Line Number="336">
<![CDATA[]]>
</Line>
<Line Number="337">
<![CDATA[// Set lane control flags Lane [5]]]>
</Line>
<Line Number="338">
<![CDATA[IF P834_Conv.RestartTmr_DN THEN]]>
</Line>
<Line Number="339">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[5].xLaneRunEnable := 1;]]>
</Line>
<Line Number="340">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[5].xLaneStop 		:= 0;]]>
</Line>
<Line Number="341">
<![CDATA[ELSE ]]>
</Line>
<Line Number="342">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[5].xLaneRunEnable := 0;	]]>
</Line>
<Line Number="343">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[5].xLaneStop 		:= 1;]]>
</Line>
<Line Number="344">
<![CDATA[END_IF;]]>
</Line>
<Line Number="345">
<![CDATA[MRG414_astUNL_SlugBldCtrl[5].xLaneMaintMode 	:= P836_Conv.HMI.Manual OR P834_Conv.HMI.Manual; //If any conveyor in Manual Mode // OR P1492_Conv.HMI.Manual OR P1491_Conv.HMI.Manual]]>
</Line>
<Line Number="346">
<![CDATA[]]>
</Line>
<Line Number="347">
<![CDATA[IF MRG414_astUNL_SlugBldCtrl[5].xLaneRunEnable AND MRG414_astUNL_MRG_CnvCtrl[5].xCnvReadyToRun AND MRG414_astUNL_PT_CnvCtrl[5].xCnvReadyToRun then]]>
</Line>
<Line Number="348">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[5].xLaneStartupEnable := 1;]]>
</Line>
<Line Number="349">
<![CDATA[ELSE ]]>
</Line>
<Line Number="350">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[5].xLaneStartupEnable := 0;]]>
</Line>
<Line Number="351">
<![CDATA[END_IF;]]>
</Line>
<Line Number="352">
<![CDATA[#endregion]]>
</Line>
<Line Number="353">
<![CDATA[]]>
</Line>
<Line Number="354">
<![CDATA[// Tag Mapping]]>
</Line>
<Line Number="355">
<![CDATA[FOR MRG414_diHMI_LaneIdx := 1 TO MRG414_stCollTrkSysCfg.diNumLanes DO]]>
</Line>
<Line Number="356">
<![CDATA[//HMI Monitor tags	]]>
</Line>
<Line Number="357">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].AcceptedSlugLength 	:= MRG414_astLaneClctrSlotResvStat[MRG414_diHMI_LaneIdx].rSlotSizeInch;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].AcceptedSlugLength]]>
</Line>
<Line Number="358">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].ReservedSlugLength 	:= MRG414_astLaneClctrSlotResvStat[MRG414_diHMI_LaneIdx].rSlotSizeInch;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].ReservedSlugLength]]>
</Line>
<Line Number="359">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].SlugTrackID 			:= MRG414_astLaneClctrSlotResvStat[MRG414_diHMI_LaneIdx].diLanePkgSeqId;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].SlugTrackID]]>
</Line>
<Line Number="360">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].ReleasingSlugLength 	:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].rQ2_SlugLengthReleaseMeasure;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].ReleasingSlugLength]]>
</Line>
<Line Number="361">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].NoProductTimer 		:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].tmrSlugReleased_Q2.ACC;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].NoProductTimer]]>
</Line>
<Line Number="362">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].AcceptingProduct 		:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xSlugAccepting_Q2;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].AcceptingProduct]]>
</Line>
<Line Number="363">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].SlugAccepted 			:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xSlugAccepted_Q2;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].SlugAccepted]]>
</Line>
<Line Number="364">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].SlugLengthReserved 	:= MRG414_astLaneClctrSlotResvCntrl[MRG414_diHMI_LaneIdx].xSlotReserved;]]>
</Line>
<Line Number="365">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].ReadyToMerge 			:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xSlugReadyToRelease_Q2;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].ReadyToMerge]]>
</Line>
<Line Number="366">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].SlugReleasing 			:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xSlugReleasing_Q2;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].SlugReleasing]]>
</Line>
<Line Number="367">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].SlugReleaseDone 		:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xSlugReleased_Q2;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].SlugReleaseDone]]>
</Line>
<Line Number="368">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].SlugHalted 			:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xSlugHalted_Q2;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].SlugHalted]]>
</Line>
<Line Number="369">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].NoProductTimerOn 		:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].tmrSlugReleased_Q2.EN;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].NoProductTimerOn]]>
</Line>
<Line Number="370">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].RunEnabled 			:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xLaneRunEnable;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].RunEnabled]]>
</Line>
<Line Number="371">
<![CDATA[//P422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].Disabled 				:= MRG422_astUNL_SlugBldCtrl[MRG422_diHMI_LaneIdx].xLaneDisabled;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].Disabled]]>
</Line>
<Line Number="372">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].Stopped 				:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xLaneStop;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].Stopped]]>
</Line>
<Line Number="373">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].MaintenanceMode 		:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xLaneMaintMode;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].MaintenanceMode]]>
</Line>
<Line Number="374">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].FlowControlActive 		:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xLaneFlowControlActive;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].FlowControlActive]]>
</Line>
<Line Number="375">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].AnyConveyorFaulted 	:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xLaneAnyConvFaulted;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].AnyConveyorFaulted]]>
</Line>
<Line Number="376">
<![CDATA[P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].StartUpEnabled 		:= MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xLaneStartupEnable;	  //M422_SawMerge_HMI.Lane[MRG422_diHMI_LaneIdx].StartUpEnabled]]>
</Line>
<Line Number="377">
<![CDATA[]]>
</Line>
<Line Number="378">
<![CDATA[//HMI Inputs]]>
</Line>
<Line Number="379">
<![CDATA[MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].diQ2_NoCartonTime 	:= P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].NoProductTime; // No Carton detection timer preset value]]>
</Line>
<Line Number="380">
<![CDATA[MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].diQ2_SlugGapAdder	:= P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].AddionalGap; //Additional gap for end of slug]]>
</Line>
<Line Number="381">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneLoc[MRG414_diHMI_LaneIdx] 			:= P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].LaneOffset; //Set lane location offset (with respect to collector belt Exit PE)]]>
</Line>
<Line Number="382">
<![CDATA[MRG414_stCollTrkSysCfg.adiStartupLaneLoc[MRG414_diHMI_LaneIdx] 		:= P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].LaneOffset - 20;]]>
</Line>
<Line Number="383">
<![CDATA[MRG414_stCollTrkSysCfg.adiCollAvgSlotSize[MRG414_diHMI_LaneIdx] 	:= MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].rQ2_MaxTrainLen + MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].diQ2_SlugGapAdder;]]>
</Line>
<Line Number="384">
<![CDATA[]]>
</Line>
<Line Number="385">
<![CDATA[// Conveyor Ready To Run Status]]>
</Line>
<Line Number="386">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvReadyToRun := NOT MRG414_astUNL_MRG_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted AND NOT MRG414_astUNL_MRG_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRestartReq;]]>
</Line>
<Line Number="387">
<![CDATA[MRG414_astUNL_PT_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvReadyToRun  := NOT MRG414_astUNL_PT_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted AND NOT MRG414_astUNL_PT_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRestartReq;]]>
</Line>
<Line Number="388">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvReadyToRun  := NOT MRG414_astUNL_Q2_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted AND NOT MRG414_astUNL_Q2_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRestartReq;]]>
</Line>
<Line Number="389">
<![CDATA[MRG414_astUNL_Q1_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvReadyToRun  := NOT MRG414_astUNL_Q1_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted AND NOT MRG414_astUNL_Q1_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRestartReq;]]>
</Line>
<Line Number="390">
<![CDATA[MRG414_astUNL_GPR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvReadyToRun := NOT MRG414_astUNL_GPR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted AND NOT MRG414_astUNL_GPR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRestartReq;]]>
</Line>
<Line Number="391">
<![CDATA[MRG414_astUNL_BFR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvReadyToRun := NOT MRG414_astUNL_BFR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted AND NOT MRG414_astUNL_BFR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRestartReq;]]>
</Line>
<Line Number="392">
<![CDATA[]]>
</Line>
<Line Number="393">
<![CDATA[// Conveyor VFD Run Enable Status]]>
</Line>
<Line Number="394">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRunEnable 	:= 1; ]]>
</Line>
<Line Number="395">
<![CDATA[MRG414_astUNL_PT_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRunEnable  	:= 1; ]]>
</Line>
<Line Number="396">
<![CDATA[MRG414_astUNL_Q2_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRunEnable  	:= 1; ]]>
</Line>
<Line Number="397">
<![CDATA[MRG414_astUNL_Q1_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRunEnable  	:= 1; ]]>
</Line>
<Line Number="398">
<![CDATA[MRG414_astUNL_GPR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRunEnable 	:= 1; ]]>
</Line>
<Line Number="399">
<![CDATA[MRG414_astUNL_BFR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvRunEnable 	:= 1; ]]>
</Line>
<Line Number="400">
<![CDATA[]]>
</Line>
<Line Number="401">
<![CDATA[// Set lane control flags Lane ]]>
</Line>
<Line Number="402">
<![CDATA[MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xLaneAnyConvFaulted 	:= MRG414_astUNL_MRG_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted OR MRG414_astUNL_PT_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted OR MRG414_astUNL_Q2_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted OR ]]>
</Line>
<Line Number="403">
<![CDATA[                                             		   					   MRG414_astUNL_Q1_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted OR MRG414_astUNL_GPR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted OR MRG414_astUNL_BFR_CnvCtrl[MRG414_diHMI_LaneIdx].xCnvFaulted;]]>
</Line>
<Line Number="404">
<![CDATA[MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xLaneDisabled       	:= P414_SawMerge_HMI.Lane[MRG414_diHMI_LaneIdx].Disabled; ]]>
</Line>
<Line Number="405">
<![CDATA[MRG414_astUNL_SlugBldCtrl[MRG414_diHMI_LaneIdx].xLaneFlowControlActive 	:= 0; //MRG422_astUNL_SlugBldCtrl[MRG422_diHMI_LaneIdx].xLaneRunEnable AND NOT MRG422_astUNL_SlugBldCtrl[MRG422_diHMI_LaneIdx].xSlugReleasing_Q2; ]]>
</Line>
<Line Number="406">
<![CDATA[ ]]>
</Line>
<Line Number="407">
<![CDATA[// Slug Building Config for Lanes]]>
</Line>
<Line Number="408">
<![CDATA[MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].rQ2_ReleaseSpeed_IPS 		:= P414_SawMerge_HMI.ClctrSpeed_FPM / 5.0; ]]>
</Line>
<Line Number="409">
<![CDATA[MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].rQ1_MaxTrainReleaseLen 		:= MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].rQ1_MaxTrainLen + 100; // Max slug release length]]>
</Line>
<Line Number="410">
<![CDATA[MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].rStartupSlugLenInch			:= MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].rPT_StartupDistPre + MRG414_astUNL_SlugBldCfg[MRG414_diHMI_LaneIdx].rMRG_StartupDistPre;]]>
</Line>
<Line Number="411">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="412">
<![CDATA[]]>
</Line>
<Line Number="413">
