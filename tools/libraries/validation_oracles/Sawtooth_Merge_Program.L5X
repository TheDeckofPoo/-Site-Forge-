<Line Number="426">
<![CDATA[#endregion]]>
</Line>
<Line Number="427">
<![CDATA[]]>
</Line>
<Line Number="428">
<![CDATA[// *** Use the following condition to define slug release lengths if ***Gap & Store belts are not availble***.]]>
</Line>
<Line Number="429">
<![CDATA[// Q2 the discharge belt]]>
</Line>
<Line Number="430">
<![CDATA[#region Set Q2 slug release length based on lane full condition (no Gap&Store function)]]>
</Line>
<Line Number="431">
<![CDATA[IF EZPE127_F.Full THEN ]]>
</Line>
<Line Number="432">
<![CDATA[]]>
</Line>
<Line Number="433">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[1].rQ1_SlugLength_Q := P414_SawMerge_HMI.Lane[1].ReleaseLengthFull; //M422_Merge_SlugRelLen2_L1;]]>
</Line>
<Line Number="434">
<![CDATA[ELSE]]>
</Line>
<Line Number="435">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[1].rQ1_SlugLength_Q := P414_SawMerge_HMI.Lane[1].ReleaseLength; //M422_Merge_SlugRelLen_L1;]]>
</Line>
<Line Number="436">
<![CDATA[END_IF;]]>
</Line>
<Line Number="437">
<![CDATA[]]>
</Line>
<Line Number="438">
<![CDATA[IF EZPE408_F.Full THEN ]]>
</Line>
<Line Number="439">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[2].rQ1_SlugLength_Q := P414_SawMerge_HMI.Lane[2].ReleaseLengthFull;]]>
</Line>
<Line Number="440">
<![CDATA[ELSE]]>
</Line>
<Line Number="441">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[2].rQ1_SlugLength_Q := P414_SawMerge_HMI.Lane[2].ReleaseLength;]]>
</Line>
<Line Number="442">
<![CDATA[END_IF;]]>
</Line>
<Line Number="443">
<![CDATA[]]>
</Line>
<Line Number="444">
<![CDATA[IF EZPE116_F.Full THEN ]]>
</Line>
<Line Number="445">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[3].rQ1_SlugLength_Q := P414_SawMerge_HMI.Lane[3].ReleaseLengthFull;]]>
</Line>
<Line Number="446">
<![CDATA[ELSE]]>
</Line>
<Line Number="447">
