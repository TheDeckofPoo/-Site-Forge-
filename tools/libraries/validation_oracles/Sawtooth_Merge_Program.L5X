</Line>
<Line Number="453">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[4].rQ1_SlugLength_Q := P414_SawMerge_HMI.Lane[4].ReleaseLength;]]>
</Line>
<Line Number="454">
<![CDATA[END_IF;]]>
</Line>
<Line Number="455">
<![CDATA[]]>
</Line>
<Line Number="456">
<![CDATA[IF EZPE832_F.Full THEN ]]>
</Line>
<Line Number="457">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[5].rQ1_SlugLength_Q := P414_SawMerge_HMI.Lane[5].ReleaseLengthFull;]]>
</Line>
<Line Number="458">
<![CDATA[ELSE]]>
</Line>
<Line Number="459">
<![CDATA[	MRG414_astUNL_SlugBldCtrl[5].rQ1_SlugLength_Q := P414_SawMerge_HMI.Lane[5].ReleaseLength;]]>
</Line>
<Line Number="460">
<![CDATA[END_IF;]]>
</Line>
<Line Number="461">
<![CDATA[#endregion]]>
</Line>
<Line Number="462">
<![CDATA[]]>
</Line>
<Line Number="463">
<![CDATA[// Upstream and Downstream search limits to optimize space reservation on collector for slugs]]>
</Line>
<Line Number="464">
<![CDATA[IF MRG414_stCollTrkSysCfg.xCollOptimizeSearch THEN]]>
</Line>
<Line Number="465">
<![CDATA[	FOR diOptSearchLimitIdx := 1 TO MRG414_stCollTrkSysCfg.diNumLanes DO]]>
</Line>
<Line Number="466">
<![CDATA[		MRG414_stCollTrkSysCfg.adiOptUpStrmSearchLimit[diOptSearchLimitIdx] 	:= MRG414_stCollTrkSysCfg.adiCollAvgSlotSize[diOptSearchLimitIdx] * 2;]]>
</Line>
<Line Number="467">
<![CDATA[		MRG414_stCollTrkSysCfg.adiOptDnStrmSearchLimit[diOptSearchLimitIdx] 	:= (MRG414_stCollTrkSysCfg.adiLaneLoc[diOptSearchLimitIdx] - MRG414_stCollTrkSysCfg.adiLaneLoc[MRG414_stCollTrkSysCfg.diNumLanes]) * MRG414_stCollTrkSysCfg.rClctrPsuedoEnc_IPP; // Six downstream lanes]]>
</Line>
<Line Number="468">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="469">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="RT_LaneOffsetFind" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Ranga Jayasinghe]]>
</Line>
<Line Number="8">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[////////////////////////////////////////////////]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[// Lane Offset find using lane Exit PEs]]>
</Line>
<Line Number="13">
<![CDATA[// First enable "MRG422_xLaneClctrPeCalibrate" then "MRG422_xLane_OffsetCaptureArm"]]>
</Line>
<Line Number="14">
<![CDATA[// PE offsets will be saved to "MRG422_astLanePeTrackCal[x].diPlsCntSave" and "MRG422_xLane_OffsetCaptureArm" gets reset when process is completed]]>
</Line>
<Line Number="15">
<![CDATA[////////////////////////////////////////////////]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[IF MRG414_xLane_OffsetCaptureArm THEN]]>
</Line>
<Line Number="18">
<![CDATA[	]]>
</Line>
<Line Number="19">
<![CDATA[	FOR MRG414_diLaneCalPeIndex := 1 TO (MRG414_stCollTrkSysCfg.diNumPE) DO]]>
</Line>
<Line Number="20">
<![CDATA[		]]>
</Line>
<Line Number="21">
<![CDATA[		// Tracking PE's]]>
</Line>
<Line Number="22">
<![CDATA[		IF (MRG414_diLaneCalPeIndex >= 1) AND  (MRG414_diLaneCalPeIndex <= MRG414_stCollTrkSysCfg.diNumLanes) THEN]]>
</Line>
<Line Number="23">
<![CDATA[			]]>
</Line>
<Line Number="24">
<![CDATA[			// Pulse counter for all PE's]]>
</Line>
<Line Number="25">
<![CDATA[			IF (MRG414_diCollDeltaEncCnt > 0) AND MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].xCntInProgress THEN]]>
</Line>
<Line Number="26">
<![CDATA[				MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].diPlsAccum := MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].diPlsAccum + MRG414_diCollDeltaEncCnt;]]>
</Line>
<Line Number="27">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="28">
<![CDATA[			]]>
</Line>
<Line Number="29">
<![CDATA[			// Zero tracking PE counters when blocked ]]>
</Line>
<Line Number="30">
<![CDATA[			IF (MRG414_astUNL_Q2_CnvCtrl[MRG414_diLaneCalPeIndex].xPE_BlockedExit AND MRG414_astUNL_Q2_CnvCtrl[1].xInterlock_OUT) AND NOT(MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].xIsBlockedPrev) THEN]]>
</Line>
<Line Number="31">
<![CDATA[				MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].diPlsAccum := 0;]]>
</Line>
<Line Number="32">
<![CDATA[				MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].diPlsCntSave := 0;]]>
</Line>
<Line Number="33">
<![CDATA[				MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].xCntInProgress := MRG414_c_xTRUE;]]>
</Line>
<Line Number="34">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="35">
<![CDATA[			MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].xIsBlockedPrev := MRG414_astUNL_Q2_CnvCtrl[MRG414_diLaneCalPeIndex].xPE_BlockedExit AND MRG414_astUNL_Q2_CnvCtrl[1].xInterlock_OUT;]]>
</Line>
<Line Number="36">
<![CDATA[		]]>
</Line>
<Line Number="37">
<![CDATA[		// Last PE on Collector blocked, grab running counters]]>
</Line>
<Line Number="38">
<![CDATA[		ELSIF MRG414_astCollPe[MRG414_stCollTrkSysCfg.diNumPE].xIsBlocked THEN]]>
</Line>
<Line Number="39">
<![CDATA[			FOR MRG414_diLaneCalPeIndex := 1 TO MRG414_stCollTrkSysCfg.diNumLanes DO]]>
</Line>
<Line Number="40">
<![CDATA[				MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].diPlsCntSave := MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].diPlsAccum;]]>
</Line>
<Line Number="41">
<![CDATA[				MRG414_xLane_OffsetCaptureArm := FALSE;]]>
</Line>
<Line Number="42">
<![CDATA[				MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].xCntInProgress := MRG414_c_xFALSE;]]>
</Line>
<Line Number="43">
<![CDATA[			END_FOR;]]>
</Line>
<Line Number="44">
<![CDATA[			]]>
</Line>
<Line Number="45">
<![CDATA[			EXIT;]]>
</Line>
<Line Number="46">
<![CDATA[			]]>
</Line>
<Line Number="47">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="48">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="49">
<![CDATA[	]]>
</Line>
<Line Number="50">
<![CDATA[END_IF;]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[IF MRG414_xLanePeCalReset THEN]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[	FOR MRG414_diLaneCalPeIndex := 1 TO MRG414_stCollTrkSysCfg.diNumLanes DO]]>
</Line>
<Line Number="55">
<![CDATA[		MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].diPlsCntSave :=  0;]]>
</Line>
<Line Number="56">
<![CDATA[		MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].diPlsAccum := 0;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[		MRG414_astLanePeTrackCal[MRG414_diLaneCalPeIndex].xCntInProgress := MRG414_c_xFALSE;]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[		MRG414_xLanePeCalReset := MRG414_c_xFALSE;]]>
</Line>
<Line Number="61">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="62">
<![CDATA[]]>
</Line>
<Line Number="63">
<![CDATA[END_IF;]]>
</Line>
<Line Number="64">
<![CDATA[	]]>
</Line>
</STContent>
</Routine>
<Routine Name="SR_CollTrackChkSlot" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[//	Searches the reserved slot to see if it has been compromised by another package ]]>
</Line>
<Line Number="13">
<![CDATA[//	(or debris) occuping the reserved slot.]]>
</Line>
<Line Number="14">
<![CDATA[//]]>
</Line>
<Line Number="15">
<![CDATA[//]]>
</Line>
<Line Number="16">
<![CDATA[//	INPUTS:]]>
</Line>
<Line Number="17">
<![CDATA[//		i_diCollChkStartIdx 	: Location in the astCollTrkArray to begin the search]]>
</Line>
<Line Number="18">
<![CDATA[//		i_diCollChkSlotSize 	: The number of elements to chk]]>
</Line>
<Line Number="19">
<![CDATA[//		i_diCollChkTrkId		: The Track Id of the Parcel the slot is being reserved for]]>
</Line>
<Line Number="20">
<![CDATA[//		i_diCollChkLaneId		: The Lane Id of the Parcel the slot is being reserved for]]>
</Line>
<Line Number="21">
<![CDATA[//]]>
</Line>
<Line Number="22">
<![CDATA[//	OUTPUTS:]]>
</Line>
<Line Number="23">
<![CDATA[//		o_xCollChkSlotCmpsd : Indicator whether an empty slot was Compromised]]>
</Line>
<Line Number="24">
<![CDATA[//		]]>
</Line>
<Line Number="25">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[// Searches the reserved slot to see if it has been compromised by another package (or debris) occuping the reserved slot]]>
</Line>
<Line Number="28">
<![CDATA[//]]>
</Line>
<Line Number="29">
<![CDATA[// I/O :]]>
</Line>
<Line Number="30">
<![CDATA[// iq_stLaneClctrSlotRes : ST_LaneClctrSlotRes]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[SBR( MRG414_i_diCollChkStartIdx, MRG414_i_diCollChkSlotSize, MRG414_i_diCollChkTrkId, MRG414_i_diCollChkLaneId);]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[// default to Not Compromised]]>
</Line>
<Line Number="35">
<![CDATA[MRG414_o_xCollChkSlotCmpsd := 0;  // FALSE]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[IF (MRG414_i_diCollChkStartIdx > 0) ]]>
</Line>
<Line Number="38">
<![CDATA[  AND (MRG414_i_diCollChkStartIdx  < (MRG414_diCollTrkPkgArySize - 1))]]>
</Line>
<Line Number="39">
<![CDATA[   THEN]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[	]]>
</Line>
<Line Number="42">
<![CDATA[	MRG414_diCollChkSize := MRG414_i_diCollChkSlotSize;]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[	// Calulate the combined TrackId and Lane ID]]>
</Line>
<Line Number="45">
<![CDATA[	MRG414_diCollChkLaneTrkId := (MRG414_i_diCollChkLaneId * MRG414_diLaneID_Mod) + MRG414_i_diCollChkTrkId;]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[	FOR MRG414_diCollChkIdx := MRG414_i_diCollChkStartIdx TO MRG414_diCollTrkPkgAryLastIdx DO]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[		// check that the slot only contains the reserved Lane ID + Track ID]]>
</Line>
<Line Number="50">
<![CDATA[		IF (MRG414_adiCollTrkArray[MRG414_diCollChkIdx] <> MRG414_diCollChkLaneTrkId)]]>
</Line>
<Line Number="51">
<![CDATA[//		  AND ( astCollTrkArray[diCollChkIdx] <> 0)]]>
</Line>
<Line Number="52">
<![CDATA[		  THEN]]>
</Line>
<Line Number="53">
<![CDATA[		 	]]>
</Line>
<Line Number="54">
<![CDATA[			// slot was compromised]]>
</Line>
<Line Number="55">
<![CDATA[			MRG414_o_xCollChkSlotCmpsd := 1; // TRUE]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[			// No need to search any further]]>
</Line>
<Line Number="58">
<![CDATA[			EXIT;]]>
</Line>
<Line Number="59">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[		// See if Checked all of the requested slots]]>
</Line>
<Line Number="62">
<![CDATA[		MRG414_diCollChkSize := MRG414_diCollChkSize -1;]]>
</Line>
<Line Number="63">
<![CDATA[		IF MRG414_diCollChkSize <= 0 THEN]]>
</Line>
<Line Number="64">
<![CDATA[			EXIT;]]>
</Line>
<Line Number="65">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="66">
<![CDATA[]]>
</Line>
<Line Number="67">
<![CDATA[]]>
</Line>
<Line Number="68">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="69">
<![CDATA[]]>
</Line>
<Line Number="70">
<![CDATA[ELSE]]>
</Line>
<Line Number="71">
<![CDATA[]]>
</Line>
<Line Number="72">
<![CDATA[	// Something wrong with input parmeters]]>
</Line>
<Line Number="73">
<![CDATA[	MRG414_o_xCollChkSlotCmpsd := 1; // TRUE]]>
</Line>
<Line Number="74">
<![CDATA[]]>
</Line>
<Line Number="75">
<![CDATA[END_IF;]]>
</Line>
<Line Number="76">
<![CDATA[]]>
</Line>
<Line Number="77">
<![CDATA[// 2014-12-03 Do not use RET statement]]>
</Line>
<Line Number="78">
<![CDATA[// RET (o_xCollChkSlotCmpsd);]]>
</Line>
<Line Number="79">
<![CDATA[]]>
</Line>
<Line Number="80">
<![CDATA[// ************ End of Subroutine ********************]]>
</Line>
<Line Number="81">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="SR_CollTrackClrSlot" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[// Invoked to clear the previously reserved track Id from the Collector Tracking Slot]]>
</Line>
<Line Number="13">
<![CDATA[// The Lane Id is pre-pended to the Track ID]]>
</Line>
<Line Number="14">
<![CDATA[//]]>
</Line>
<Line Number="15">
<![CDATA[//	INPUTS:]]>
</Line>
<Line Number="16">
<![CDATA[//		i_diCollClrStartIdx 	: Location in the astCollTrkArray to begin the search]]>
</Line>
<Line Number="17">
<![CDATA[//		i_diCollClrSlotSize 	: The number of elements to be Cleard]]>
</Line>
<Line Number="18">
<![CDATA[//		i_diCollClrTrkId		: The Track Id of the Parcel the slot is being cleared ]]>
</Line>
<Line Number="19">
<![CDATA[//		i_diCollClrLaneId		: The Lane Id of the Parcel the slot is being cleared]]>
</Line>
<Line Number="20">
<![CDATA[//]]>
</Line>
<Line Number="21">
<![CDATA[//	OUTPUTS:]]>
</Line>
<Line Number="22">
<![CDATA[//		NONE ]]>
</Line>
<Line Number="23">
<![CDATA[//]]>
</Line>
<Line Number="24">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[SBR( MRG414_i_diCollClrStartIdx, MRG414_i_diCollClrSlotSize, MRG414_i_diCollClrTrkId, MRG414_i_diCollClrLaneId );]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[IF (MRG414_i_diCollClrStartIdx > 0) ]]>
</Line>
<Line Number="30">
<![CDATA[  AND (MRG414_i_diCollClrStartIdx  < (MRG414_diCollTrkPkgArySize - 1))]]>
</Line>
<Line Number="31">
<![CDATA[  AND (MRG414_i_diCollClrSlotSize > 0)]]>
</Line>
<Line Number="32">
<![CDATA[   THEN]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[	MRG414_diCollClrSize := MRG414_i_diCollClrSlotSize;]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[	// Calulate the combined TrackId and Lane ID]]>
</Line>
<Line Number="37">
<![CDATA[	MRG414_diCollClrLaneTrkId := (MRG414_i_diCollClrLaneId * MRG414_diLaneID_Mod) + MRG414_i_diCollClrTrkId;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[	FOR MRG414_diCollClrIdx := MRG414_i_diCollClrStartIdx TO MRG414_diCollTrkPkgAryLastIdx DO]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[		// AND out the combined Lane and Track Id]]>
</Line>
<Line Number="42">
<![CDATA[		MRG414_adiCollTrkArray[MRG414_diCollClrIdx] := MRG414_adiCollTrkArray[MRG414_diCollClrIdx] AND 16#FFFF0000;]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[		// Check if Cleared all of the requested slots]]>
</Line>
<Line Number="45">
<![CDATA[		MRG414_diCollClrSize := MRG414_diCollClrSize -1;]]>
</Line>
<Line Number="46">
<![CDATA[		IF MRG414_diCollClrSize <= 0 THEN]]>
</Line>
<Line Number="47">
<![CDATA[			EXIT;]]>
</Line>
<Line Number="48">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="49">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="50">
<![CDATA[END_IF;]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[// ************ End of Subroutine ********************]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="SR_CollTrackRsrvSlot" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[// Reserves the slot with the input Track ID ]]>
</Line>
<Line Number="13">
<![CDATA[// The Lane Id is pre-pended to the Track ID]]>
</Line>
<Line Number="14">
<![CDATA[//]]>
</Line>
<Line Number="15">
<![CDATA[//	INPUTS:]]>
</Line>
<Line Number="16">
<![CDATA[//		i_diCollRsrvStartIdx 	: Location in the astCollTrkArray to begin the reservation]]>
</Line>
<Line Number="17">
<![CDATA[//		i_diCollRsvSlotSize 	: The number of elements to be reserved]]>
</Line>
<Line Number="18">
<![CDATA[//		i_diCollRsrvTrkId		: The Track Id of the Parcel the slot is being reserved for]]>
</Line>
<Line Number="19">
<![CDATA[//		i_diCollRsrvLaneId		: The Lane Id of the Parcel the slot is being reserved for]]>
</Line>
<Line Number="20">
<![CDATA[//]]>
</Line>
<Line Number="21">
<![CDATA[//	OUTPUTS:]]>
</Line>
<Line Number="22">
<![CDATA[//		NONE ]]>
</Line>
<Line Number="23">
<![CDATA[//]]>
</Line>
<Line Number="24">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[SBR( MRG414_i_diCollRsrvStartIdx, MRG414_i_diCollRsvSlotSize, MRG414_i_diCollRsrvTrkId, MRG414_i_diCollRsrvLaneId );]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[IF (MRG414_i_diCollRsrvStartIdx > 0) ]]>
</Line>
<Line Number="30">
<![CDATA[  AND (MRG414_i_diCollRsrvStartIdx  < (MRG414_diCollTrkPkgArySize - 1))]]>
</Line>
<Line Number="31">
<![CDATA[  AND (MRG414_i_diCollRsvSlotSize > 0)]]>
</Line>
<Line Number="32">
<![CDATA[   THEN]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[	MRG414_diCollRsrvSize := MRG414_i_diCollRsvSlotSize;]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[	// Calulate the combined TrackId and Lane ID]]>
</Line>
<Line Number="37">
<![CDATA[	MRG414_diCollRsrvLaneTrkId := (MRG414_i_diCollRsrvLaneId * MRG414_diLaneID_Mod) + MRG414_i_diCollRsrvTrkId;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[	FOR MRG414_diCollRsrvIdx := MRG414_i_diCollRsrvStartIdx TO MRG414_diCollTrkPkgAryLastIdx DO]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[		// OR in the combined Lane and Track Id]]>
</Line>
<Line Number="42">
<![CDATA[		MRG414_adiCollTrkArray[MRG414_diCollRsrvIdx] := MRG414_adiCollTrkArray[MRG414_diCollRsrvIdx] OR MRG414_diCollRsrvLaneTrkId;]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[		// Check if reserved all of the requested slots]]>
</Line>
<Line Number="45">
<![CDATA[		MRG414_diCollRsrvSize := MRG414_diCollRsrvSize -1;]]>
</Line>
<Line Number="46">
<![CDATA[		IF MRG414_diCollRsrvSize <= 0 THEN]]>
</Line>
<Line Number="47">
<![CDATA[			EXIT;]]>
</Line>
<Line Number="48">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="49">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="50">
<![CDATA[END_IF;]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[// ************ End of Subroutine ********************]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="SR_CollTrackSlotAtMrgPnt" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[//	Searches the reserved slot to see if the slot has reached the Merge Point]]>
</Line>
<Line Number="13">
<![CDATA[//]]>
</Line>
<Line Number="14">
<![CDATA[//]]>
</Line>
<Line Number="15">
<![CDATA[//	INPUTS:]]>
</Line>
<Line Number="16">
<![CDATA[//		i_diCollMrgStartIdx 	: Location in the astCollTrkArray to begin the search]]>
</Line>
<Line Number="17">
<![CDATA[//		i_diCollMrgStartOffset	: Location of the Merge along the collector]]>
</Line>
<Line Number="18">
<![CDATA[//		i_diCollMrgSlotSize 	: The number of elements to chk]]>
</Line>
<Line Number="19">
<![CDATA[//		i_diCollMrgTrkId		: The Track Id of the Parcel the slot is being reserved for]]>
</Line>
<Line Number="20">
<![CDATA[//		i_diCollMrgLaneId		: The Lane Id of the Parcel the slot is being reserved for]]>
</Line>
<Line Number="21">
<![CDATA[//]]>
</Line>
<Line Number="22">
<![CDATA[//	OUTPUTS:]]>
</Line>
<Line Number="23">
<![CDATA[//		o_xCollSlotAtMrg : Indicator when the slot is at the merge point ]]>
</Line>
<Line Number="24">
<![CDATA[//		o_xCollSlotAtMrg : Indicator that the entire slot is past the merge point]]>
</Line>
<Line Number="25">
<![CDATA[//		]]>
</Line>
<Line Number="26">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[// Searches the reserved slot to see if it has been compromised by another package (or debris) occuping the reserved slot]]>
</Line>
<Line Number="31">
<![CDATA[//]]>
</Line>
<Line Number="32">
<![CDATA[// I/O :]]>
</Line>
<Line Number="33">
<![CDATA[// iq_stLaneClctrSlotRes : ST_LaneClctrSlotRes]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[SBR( MRG414_i_diCollMrgStartIdx, MRG414_i_diCollMrgStartOffset, MRG414_i_diCollMrgSlotSize, MRG414_i_diCollMrgTrkId, MRG414_i_diCollMrgLaneId );]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[// Default Slot is not at merge]]>
</Line>
<Line Number="38">
<![CDATA[MRG414_o_xCollSlotAtMrg := 0; // False]]>
</Line>
<Line Number="39">
<![CDATA[MRG414_o_xCollSlotPastMrg := 0; // False]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[// 2014-12-01 Corrected from : i_diCollSrchStartIdx TO : i_diCollMrgStartIdx]]>
</Line>
<Line Number="42">
<![CDATA[IF (MRG414_i_diCollMrgStartIdx > 0) ]]>
</Line>
<Line Number="43">
<![CDATA[  AND (MRG414_i_diCollMrgStartIdx  < (MRG414_diCollTrkPkgArySize - 1))]]>
</Line>
<Line Number="44">
<![CDATA[   THEN]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[	// Check if the current start location of the slot is at or beyond the Merge Offset]]>
</Line>
<Line Number="47">
<![CDATA[	IF (MRG414_i_diCollMrgStartIdx <=  MRG414_i_diCollMrgStartOffset)  ]]>
</Line>
<Line Number="48">
<![CDATA[	  AND ((MRG414_i_diCollMrgStartIdx + MRG414_i_diCollMrgSlotSize) > MRG414_i_diCollMrgStartOffset)]]>
</Line>
<Line Number="49">
<![CDATA[	  THEN]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[		// Calulate the combined TrackId and Lane ID]]>
</Line>
<Line Number="52">
<![CDATA[		MRG414_diCollMrgLaneTrkId := (MRG414_i_diCollMrgLaneId * MRG414_diLaneID_Mod) + MRG414_i_diCollMrgTrkId;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[		// Seperate out the Lane and Track Id]]>
</Line>
<Line Number="55">
<![CDATA[		MRG414_diCollMrgExtLaneTrkId := MRG414_adiCollTrkArray[MRG414_i_diCollMrgStartOffset] AND 16#0000FFFF;]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[		// Check if the combined Lane Track Id matches that in the Slot]]>
</Line>
<Line Number="58">
<![CDATA[		]]>
</Line>
<Line Number="59">
<![CDATA[		IF MRG414_diCollMrgExtLaneTrkId = MRG414_diCollMrgLaneTrkId THEN]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[			// They match so slot is at the merge offset]]>
</Line>
<Line Number="62">
<![CDATA[			MRG414_o_xCollSlotAtMrg := 1; // True]]>
</Line>
<Line Number="63">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[	// Check if slot is completly past the merge point]]>
</Line>
<Line Number="66">
<![CDATA[	ELSIF ((MRG414_i_diCollMrgStartIdx + MRG414_i_diCollMrgSlotSize) <= MRG414_i_diCollMrgStartOffset)]]>
</Line>
<Line Number="67">
<![CDATA[	  THEN]]>
</Line>
<Line Number="68">
<![CDATA[		MRG414_o_xCollSlotPastMrg := 1; // True]]>
</Line>
<Line Number="69">
<![CDATA[]]>
</Line>
<Line Number="70">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="71">
<![CDATA[ELSE]]>
</Line>
<Line Number="72">
<![CDATA[]]>
</Line>
<Line Number="73">
<![CDATA[	// Start index or POI Location is corrupt]]>
</Line>
<Line Number="74">
<![CDATA[	MRG414_o_xCollSlotPastMrg := 1; // True]]>
</Line>
<Line Number="75">
<![CDATA[]]>
</Line>
<Line Number="76">
<![CDATA[END_IF;]]>
</Line>
<Line Number="77">
<![CDATA[]]>
</Line>
<Line Number="78">
<![CDATA[// RET (o_xCollSlotAtMrg, o_xCollSlotPastMrg);]]>
</Line>
<Line Number="79">
<![CDATA[]]>
</Line>
<Line Number="80">
<![CDATA[// ************ End of Subroutine ********************]]>
</Line>
<Line Number="81">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="SR_CollTrackSrchSlot" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[//  Version: 1.1 - Added Optimized slot alignment]]>
</Line>
<Line Number="9">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="12">
<![CDATA[//]]>
</Line>
<Line Number="13">
<![CDATA[//	Search the Collector Tracking Array for an empty Slot]]>
</Line>
<Line Number="14">
<![CDATA[//	a slot which is not occupied or allocatted]]>
</Line>
<Line Number="15">
<![CDATA[//]]>
</Line>
<Line Number="16">
<![CDATA[//	INPUTS:]]>
</Line>
<Line Number="17">
<![CDATA[//		i_diCollSrchStartIdx 	: Location in the astCollTrkArray to begin the search]]>
</Line>
<Line Number="18">
<![CDATA[//		i_diCollSrchSlotSizeReq : The number of elements looking to be empty]]>
</Line>
<Line Number="19">
<![CDATA[//]]>
</Line>
<Line Number="20">
<![CDATA[//	OUTPUTS:]]>
</Line>
<Line Number="21">
<![CDATA[//		o_xCollSlotFnd 			: Indicator whether an empty slot was found or not]]>
</Line>
<Line Number="22">
<![CDATA[//		o_diCollFndSlotLoc 		: The starting location of the found slot]]>
</Line>
<Line Number="23">
<![CDATA[//]]>
</Line>
<Line Number="24">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[SBR( MRG414_i_diCollSrchStartIdx, MRG414_i_diCollSrchSlotSizeReq);]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[// Initialize to not found]]>
</Line>
<Line Number="29">
<![CDATA[MRG414_o_xCollSlotFnd := FALSE;]]>
</Line>
<Line Number="30">
<![CDATA[MRG414_o_diCollFndSlotLoc := -1;]]>
</Line>
<Line Number="31">
<![CDATA[MRG414_diCollStartSrchIdx := MRG414_i_diCollSrchStartIdx;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[(********************************]]>
</Line>
<Line Number="34">
<![CDATA[// Check if need to delay Merge location for load balancing]]>
</Line>
<Line Number="35">
<![CDATA[IF xCollLoadBalanceEn THEN]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[	diCollResultMask :=  diLaneResvFarUpstream_Status AND diCollLaneCompareMask;]]>
</Line>
<Line Number="38">
<![CDATA[	diCollLoadBalDelayCnt := 0;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[	IF diCollResultMask <> 16#0000_0000 THEN]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[		IF diCollResultMask.1 THEN]]>
</Line>
<Line Number="43">
<![CDATA[			diCollLoadBalDelayCnt := diCollLoadBalDelayCnt + 1;]]>
</Line>
<Line Number="44">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="45">
<![CDATA[		// Lane #2]]>
</Line>
<Line Number="46">
<![CDATA[		IF diCollResultMask.2 THEN]]>
</Line>
<Line Number="47">
<![CDATA[			diCollLoadBalDelayCnt := diCollLoadBalDelayCnt + 1;]]>
</Line>
<Line Number="48">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="49">
<![CDATA[		// Lane #3]]>
</Line>
<Line Number="50">
<![CDATA[		IF diCollResultMask.3 THEN]]>
</Line>
<Line Number="51">
<![CDATA[			diCollLoadBalDelayCnt := diCollLoadBalDelayCnt + 1;]]>
</Line>
<Line Number="52">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="53">
<![CDATA[		// Lane #4]]>
</Line>
<Line Number="54">
<![CDATA[		IF diCollResultMask.4 THEN]]>
</Line>
<Line Number="55">
<![CDATA[			diCollLoadBalDelayCnt := diCollLoadBalDelayCnt + 1;]]>
</Line>
<Line Number="56">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="57">
<![CDATA[		// Lane #5]]>
</Line>
<Line Number="58">
<![CDATA[		IF diCollResultMask.5 THEN]]>
</Line>
<Line Number="59">
<![CDATA[			diCollLoadBalDelayCnt := diCollLoadBalDelayCnt + 1;]]>
</Line>
<Line Number="60">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="61">
<![CDATA[		// Lane #6]]>
</Line>
<Line Number="62">
<![CDATA[		IF diCollResultMask.6 THEN]]>
</Line>
<Line Number="63">
<![CDATA[			diCollLoadBalDelayCnt := diCollLoadBalDelayCnt + 1;]]>
</Line>
<Line Number="64">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="65">
<![CDATA[		// Lane #7]]>
</Line>
<Line Number="66">
<![CDATA[		IF diCollResultMask.7 THEN]]>
</Line>
<Line Number="67">
<![CDATA[			diCollLoadBalDelayCnt := diCollLoadBalDelayCnt + 1;]]>
</Line>
<Line Number="68">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="69">
<![CDATA[		// Lane #8]]>
</Line>
<Line Number="70">
<![CDATA[		IF diCollResultMask.8 THEN]]>
</Line>
<Line Number="71">
<![CDATA[			diCollLoadBalDelayCnt := diCollLoadBalDelayCnt + 1;]]>
</Line>
<Line Number="72">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="73">
<![CDATA[	]]>
</Line>
<Line Number="74">
<![CDATA[		diCollStartSrchIdx := i_diCollSrchStartIdx + (diCollSlotSizeForLbPls * diCollLoadBalDelayCnt);]]>
</Line>
<Line Number="75">
<![CDATA[		IF( (diCollStartSrchIdx +  i_diCollSrchSlotSizeReq) > (diCollTrkPkgArySize - 1) ) THEN]]>
</Line>
<Line Number="76">
<![CDATA[			diCollStartSrchIdx := i_diCollSrchStartIdx;]]>
</Line>
<Line Number="77">
<![CDATA[		END_IF;	]]>
</Line>
<Line Number="78">
<![CDATA[	]]>
</Line>
<Line Number="79">
<![CDATA[		// Counts]]>
</Line>
<Line Number="80">
<![CDATA[		// Increment Count]]>
</Line>
<Line Number="81">
<![CDATA[		stCollLaneMrgCnts.diLoadBalDelayCnt := stCollLaneMrgCnts.diLoadBalDelayCnt + 1;]]>
</Line>
<Line Number="82">
<![CDATA[]]>
</Line>
<Line Number="83">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="84">
<![CDATA[]]>
</Line>
<Line Number="85">
<![CDATA[END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[*****************************)]]>
</Line>
<Line Number="87">
<![CDATA[]]>
</Line>
<Line Number="88">
<![CDATA[// Search for an available slot]]>
</Line>
<Line Number="89">
<![CDATA[IF (MRG414_diCollStartSrchIdx > 0) AND (MRG414_diCollStartSrchIdx  < (MRG414_diCollTrkPkgArySize - 1)) THEN]]>
</Line>
<Line Number="90">
<![CDATA[	MRG414_xCollFirstAvailFnd := FALSE;]]>
</Line>
<Line Number="91">
<![CDATA[	MRG414_diCollFirsAvailLoc := -1;]]>
</Line>
<Line Number="92">
<![CDATA[	MRG414_diCollSrchCellEmptyCnt := 0;]]>
</Line>
<Line Number="93">
<![CDATA[	]]>
</Line>
<Line Number="94">
<![CDATA[	FOR MRG414_diCollSrchIdx := MRG414_diCollStartSrchIdx TO MRG414_diCollTrkPkgAryLastIdx DO]]>
</Line>
<Line Number="95">
<![CDATA[		IF NOT(MRG414_o_xCollSlotFnd) THEN]]>
</Line>
<Line Number="96">
<![CDATA[			IF NOT(MRG414_xCollFirstAvailFnd) THEN]]>
</Line>
<Line Number="97">
<![CDATA[				IF (MRG414_adiCollTrkArray[MRG414_diCollSrchIdx] = 0) THEN]]>
</Line>
<Line Number="98">
<![CDATA[			 	]]>
</Line>
<Line Number="99">
<![CDATA[					MRG414_xCollFirstAvailFnd := MRG414_c_xTRUE;]]>
</Line>
<Line Number="100">
<![CDATA[					MRG414_diCollFirsAvailLoc := MRG414_diCollSrchIdx;]]>
</Line>
<Line Number="101">
<![CDATA[					MRG414_diCollSrchCellEmptyCnt := 1;]]>
</Line>
<Line Number="102">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="103">
<![CDATA[			ELSE]]>
</Line>
<Line Number="104">
<![CDATA[				IF (MRG414_adiCollTrkArray[MRG414_diCollSrchIdx] <> 0) THEN]]>
</Line>
<Line Number="105">
<![CDATA[					MRG414_xCollFirstAvailFnd := FALSE;]]>
</Line>
<Line Number="106">
<![CDATA[					MRG414_diCollFirsAvailLoc := -1;]]>
</Line>
<Line Number="107">
<![CDATA[					MRG414_diCollSrchCellEmptyCnt := 0;]]>
</Line>
<Line Number="108">
<![CDATA[				ELSE]]>
</Line>
<Line Number="109">
<![CDATA[					MRG414_diCollSrchCellEmptyCnt := MRG414_diCollSrchCellEmptyCnt + 1;]]>
</Line>
<Line Number="110">
<![CDATA[					IF MRG414_diCollSrchCellEmptyCnt >= MRG414_i_diCollSrchSlotSizeReq THEN]]>
</Line>
<Line Number="111">
<![CDATA[						MRG414_o_xCollSlotFnd := MRG414_c_xTRUE;]]>
</Line>
<Line Number="112">
<![CDATA[						MRG414_o_diCollFndSlotLoc := MRG414_diCollFirsAvailLoc;]]>
</Line>
<Line Number="113">
<![CDATA[						// Exit the loop]]>
</Line>
<Line Number="114">
<![CDATA[						EXIT;]]>
</Line>
<Line Number="115">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="116">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="117">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="118">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="119">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="120">
<![CDATA[]]>
</Line>
<Line Number="121">
<![CDATA[	// ***********************************************************************************]]>
</Line>
<Line Number="122">
<![CDATA[	// Optimize search to align reserved slot within edges of available window]]>
</Line>
<Line Number="123">
<![CDATA[]]>
</Line>
<Line Number="124">
<![CDATA[	MRG414_diCollDelaySlotSizePls := -1;  // Default to Indicate that Optimize was not performed]]>
</Line>
<Line Number="125">
<![CDATA[]]>
</Line>
<Line Number="126">
<![CDATA[	IF MRG414_stCollTrkSysCfg.xCollOptimizeSearch THEN]]>
</Line>
<Line Number="127">
<![CDATA[		// Only optimize if location of the found slot is at same location as the Start Search point]]>
</Line>
<Line Number="128">
<![CDATA[		IF MRG414_o_xCollSlotFnd AND (MRG414_o_diCollFndSlotLoc = MRG414_i_diCollSrchStartIdx) THEN]]>
</Line>
<Line Number="129">
<![CDATA[]]>
</Line>
<Line Number="130">
<![CDATA[			// Determine how many lanes are Empty of parcel trains ready to be released onto the Collector]]>
</Line>
<Line Number="131">
<![CDATA[			MRG414_diLaneEmptyCnt := 0;]]>
</Line>
<Line Number="132">
<![CDATA[			]]>
</Line>
<Line Number="133">
<![CDATA[			// Lane #1]]>
</Line>
<Line Number="134">
<![CDATA[			IF MRG414_diLaneEmptyPkg_Status.1 THEN]]>
</Line>
<Line Number="135">
<![CDATA[				MRG414_diLaneEmptyCnt := MRG414_diLaneEmptyCnt + 1;]]>
</Line>
<Line Number="136">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="137">
<![CDATA[			// Lane #2]]>
</Line>
<Line Number="138">
<![CDATA[			IF MRG414_diLaneEmptyPkg_Status.2 THEN]]>
</Line>
<Line Number="139">
<![CDATA[				MRG414_diLaneEmptyCnt := MRG414_diLaneEmptyCnt + 1;]]>
</Line>
<Line Number="140">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="141">
<![CDATA[			// Lane #3]]>
</Line>
<Line Number="142">
<![CDATA[			IF MRG414_diLaneEmptyPkg_Status.3 THEN]]>
</Line>
<Line Number="143">
<![CDATA[				MRG414_diLaneEmptyCnt := MRG414_diLaneEmptyCnt + 1;]]>
</Line>
<Line Number="144">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="145">
<![CDATA[			// Lane #4]]>
</Line>
<Line Number="146">
<![CDATA[			IF MRG414_diLaneEmptyPkg_Status.4 THEN]]>
</Line>
<Line Number="147">
<![CDATA[				MRG414_diLaneEmptyCnt := MRG414_diLaneEmptyCnt + 1;]]>
</Line>
<Line Number="148">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="149">
<![CDATA[			// Lane #5]]>
</Line>
<Line Number="150">
<![CDATA[			IF MRG414_diLaneEmptyPkg_Status.5 THEN]]>
</Line>
<Line Number="151">
<![CDATA[				MRG414_diLaneEmptyCnt := MRG414_diLaneEmptyCnt + 1;]]>
</Line>
<Line Number="152">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="153">
<![CDATA[			// Lane #6]]>
</Line>
<Line Number="154">
<![CDATA[			IF MRG414_diLaneEmptyPkg_Status.6 THEN]]>
</Line>
<Line Number="155">
<![CDATA[				MRG414_diLaneEmptyCnt := MRG414_diLaneEmptyCnt + 1;]]>
</Line>
<Line Number="156">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="157">
<![CDATA[			// Lane #7]]>
</Line>
<Line Number="158">
<![CDATA[			IF MRG414_diLaneEmptyPkg_Status.7 THEN]]>
</Line>
<Line Number="159">
<![CDATA[				MRG414_diLaneEmptyCnt := MRG414_diLaneEmptyCnt + 1;]]>
</Line>
<Line Number="160">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="161">
<![CDATA[			// Lane #8]]>
</Line>
<Line Number="162">
<![CDATA[			IF MRG414_diLaneEmptyPkg_Status.8 THEN]]>
</Line>
<Line Number="163">
<![CDATA[				MRG414_diLaneEmptyCnt := MRG414_diLaneEmptyCnt + 1;]]>
</Line>
<Line Number="164">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="165">
<![CDATA[			// Lane #9]]>
</Line>
<Line Number="166">
<![CDATA[			IF MRG414_diLaneEmptyPkg_Status.9 THEN]]>
</Line>
<Line Number="167">
<![CDATA[				MRG414_diLaneEmptyCnt := MRG414_diLaneEmptyCnt + 1;]]>
</Line>
<Line Number="168">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="169">
<![CDATA[]]>
</Line>
<Line Number="170">
<![CDATA[]]>
</Line>
<Line Number="171">
<![CDATA[			// Check that minimum number of lanes are not empty ]]>
</Line>
<Line Number="172">
<![CDATA[			// And all the downstream lanes are not empty]]>
</Line>
<Line Number="173">
<![CDATA[// ////			IF (diLaneEmptyCnt <= stCollTrkSysCfg.diCollLaneEmptyOptPreset)]]>
</Line>
<Line Number="174">
<![CDATA[// ///			  AND ( (diLaneEmptyPkg_Status AND diCollLaneCompareMask) <> diCollLaneCompareMask)]]>
</Line>
<Line Number="175">
<![CDATA[			IF ( (MRG414_diLaneEmptyPkg_Status AND MRG414_diCollLaneCompareMask) <> MRG414_diCollLaneCompareMask)]]>
</Line>
<Line Number="176">
<![CDATA[			  THEN]]>
</Line>
<Line Number="177">
<![CDATA[				// Search Upstream of the Start Search point for the size of the available empty slot]]>
</Line>
<Line Number="178">
<![CDATA[				MRG414_diCollUpStrmFreeSlotSizePls := 0;]]>
</Line>
<Line Number="179">
<![CDATA[				FOR MRG414_diCollUpStrmSrchIdx := MRG414_i_diCollSrchStartIdx TO MRG414_diCollTrkPkgAryLastIdx DO]]>
</Line>
<Line Number="180">
<![CDATA[					IF (MRG414_adiCollTrkArray[MRG414_diCollUpStrmSrchIdx] = 0) THEN]]>
</Line>
<Line Number="181">
<![CDATA[						MRG414_diCollUpStrmFreeSlotSizePls := MRG414_diCollUpStrmFreeSlotSizePls + 1;			 	]]>
</Line>
<Line Number="182">
<![CDATA[						// Only search for a pre-condigured limit]]>
</Line>
<Line Number="183">
<![CDATA[						IF (MRG414_diCollUpStrmFreeSlotSizePls >= (MRG414_diCollUpStrmFreeSearchLimitPls + MRG414_i_diCollSrchSlotSizeReq) ) THEN]]>
</Line>
<Line Number="184">
<![CDATA[							// No need to search any longer]]>
</Line>
<Line Number="185">
<![CDATA[							// Exit the loop]]>
</Line>
<Line Number="186">
<![CDATA[							EXIT;]]>
</Line>
<Line Number="187">
<![CDATA[						END_IF;]]>
</Line>
<Line Number="188">
<![CDATA[					ELSE]]>
</Line>
<Line Number="189">
<![CDATA[						// End of the empty slot]]>
</Line>
<Line Number="190">
<![CDATA[						// Exit the loop]]>
</Line>
<Line Number="191">
<![CDATA[						EXIT;]]>
</Line>
<Line Number="192">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="193">
<![CDATA[				END_FOR;]]>
</Line>
<Line Number="194">
<![CDATA[]]>
</Line>
<Line Number="195">
<![CDATA[				// Calculate the extra size of the available upstream slot versus the slot size required]]>
</Line>
<Line Number="196">
<![CDATA[				MRG414_diCollUpStrmXtraSlotSizePls := MRG414_diCollUpStrmFreeSlotSizePls - MRG414_i_diCollSrchSlotSizeReq;]]>
</Line>
<Line Number="197">
<![CDATA[				IF MRG414_diCollUpStrmXtraSlotSizePls < 0 THEN]]>
</Line>
<Line Number="198">
<![CDATA[					MRG414_diCollUpStrmXtraSlotSizePls := 0;]]>
</Line>
<Line Number="199">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="200">
<![CDATA[			]]>
</Line>
<Line Number="201">
<![CDATA[				// Search Downstream for the amount of empty space on Collector ahead of this merge point]]>
</Line>
<Line Number="202">
<![CDATA[				MRG414_diCollDnStrmFreeSlotSizePls := 0;]]>
</Line>
<Line Number="203">
<![CDATA[				IF (MRG414_diCollDnStrmFreeSearchLimitPls > 0 ) AND (MRG414_diCollUpStrmXtraSlotSizePls > 0) THEN ]]>
</Line>
<Line Number="204">
<![CDATA[					FOR MRG414_diCollDnStrmSrchIdx := MRG414_i_diCollSrchStartIdx TO 1 by -1 DO]]>
</Line>
<Line Number="205">
<![CDATA[				]]>
</Line>
<Line Number="206">
<![CDATA[						IF (MRG414_adiCollTrkArray[MRG414_diCollDnStrmSrchIdx] = 0) THEN]]>
</Line>
<Line Number="207">
<![CDATA[							MRG414_diCollDnStrmFreeSlotSizePls := MRG414_diCollDnStrmFreeSlotSizePls + 1;			 	]]>
</Line>
<Line Number="208">
<![CDATA[							// Only search for a pre-configured limit]]>
</Line>
<Line Number="209">
<![CDATA[							IF (MRG414_diCollDnStrmFreeSlotSizePls >= MRG414_diCollDnStrmFreeSearchLimitPls) THEN]]>
</Line>
<Line Number="210">
<![CDATA[								// No need to search any longer]]>
</Line>
<Line Number="211">
<![CDATA[								// Exit the loop]]>
</Line>
<Line Number="212">
<![CDATA[								EXIT;]]>
</Line>
<Line Number="213">
<![CDATA[							END_IF;]]>
</Line>
<Line Number="214">
<![CDATA[						ELSE]]>
</Line>
<Line Number="215">
<![CDATA[							// End of the empty slot]]>
</Line>
<Line Number="216">
<![CDATA[							// Exit the loop]]>
</Line>
<Line Number="217">
<![CDATA[							EXIT;]]>
</Line>
<Line Number="218">
<![CDATA[						END_IF;]]>
</Line>
<Line Number="219">
<![CDATA[					END_FOR;]]>
</Line>
<Line Number="220">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="221">
<![CDATA[]]>
</Line>
<Line Number="222">
<![CDATA[				// Calculate the total free upstream and downstream space]]>
</Line>
<Line Number="223">
<![CDATA[				MRG414_diCollTotalXtraSlotSizePls := MRG414_diCollUpStrmXtraSlotSizePls + MRG414_diCollDnStrmFreeSlotSizePls;]]>
</Line>
<Line Number="224">
<![CDATA[]]>
</Line>
<Line Number="225">
<![CDATA[				// Calulate the extra distance required on the downstream slot to align it the pre-configured average size slot]]>
</Line>
<Line Number="226">
<![CDATA[				MRG414_diCollDelaySlotSizePls := 0;]]>
</Line>
<Line Number="227">
<![CDATA[				// Only adjust if not already aligned to the back of a reserved slot]]>
</Line>
<Line Number="228">
<![CDATA[				IF (MRG414_diCollDnStrmFreeSlotSizePls > 0) THEN]]>
</Line>
<Line Number="229">
<![CDATA[					// If total free space is less than the configured Slot Size Then adjust  to eleminate upstream space]]>
</Line>
<Line Number="230">
<![CDATA[					IF (MRG414_diCollTotalXtraSlotSizePls < MRG414_diCollAvgSlotSizePls ) THEN]]>
</Line>
<Line Number="231">
<![CDATA[						MRG414_diCollDelaySlotSizePls := MRG414_diCollUpStrmXtraSlotSizePls;]]>
</Line>
<Line Number="232">
<![CDATA[					ELSE]]>
</Line>
<Line Number="233">
<![CDATA[						// Delay/Shift to align to a Avg. Slot Size ]]>
</Line>
<Line Number="234">
<![CDATA[						MRG414_diCollDnStrmModSlotSizePls := MRG414_diCollDnStrmFreeSlotSizePls MOD MRG414_diCollAvgSlotSizePls;]]>
</Line>
<Line Number="235">
<![CDATA[						// Only adjust if not already aligned to a multiple of the average slot size ]]>
</Line>
<Line Number="236">
<![CDATA[						IF (MRG414_diCollDnStrmModSlotSizePls > 0 ) THEN]]>
</Line>
<Line Number="237">
<![CDATA[							MRG414_diCollDnStrmXtraSlotSizePls := MRG414_diCollAvgSlotSizePls - MRG414_diCollDnStrmModSlotSizePls ;]]>
</Line>
<Line Number="238">
<![CDATA[							// Calulate the amount of distance to delay the reservation based upon the smaller of the ]]>
</Line>
<Line Number="239">
<![CDATA[							// extra distance available upstream and the extra distance need downstream to align the downstream gap to average slot size]]>
</Line>
<Line Number="240">
<![CDATA[							MRG414_diCollDelaySlotSizePls :=  MRG414_diCollDnStrmXtraSlotSizePls;]]>
</Line>
<Line Number="241">
<![CDATA[							IF (MRG414_diCollDelaySlotSizePls > MRG414_diCollUpStrmXtraSlotSizePls) THEN]]>
</Line>
<Line Number="242">
<![CDATA[								MRG414_diCollDelaySlotSizePls := MRG414_diCollUpStrmXtraSlotSizePls;]]>
</Line>
<Line Number="243">
<![CDATA[							END_IF;]]>
</Line>
<Line Number="244">
<![CDATA[						END_IF;]]>
</Line>
<Line Number="245">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="246">
<![CDATA[					// Add the extra Delay Slot Size to the found merge starting location]]>
</Line>
<Line Number="247">
<![CDATA[					MRG414_o_diCollFndSlotLoc := MRG414_o_diCollFndSlotLoc + MRG414_diCollDelaySlotSizePls;]]>
</Line>
<Line Number="248">
<![CDATA[					// Increment Count]]>
</Line>
<Line Number="249">
<![CDATA[					MRG414_stCollLaneMrgCnts.diOptimizedDelayCnt := MRG414_stCollLaneMrgCnts.diOptimizedDelayCnt + 1;]]>
</Line>
<Line Number="250">
<![CDATA[				END_IF;	]]>
</Line>
<Line Number="251">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="252">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="253">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="254">
<![CDATA[	// ***** END of Optimized search for Slot alignment : *************************************************]]>
</Line>
<Line Number="255">
<![CDATA[]]>
</Line>
<Line Number="256">
<![CDATA[END_IF;]]>
</Line>
<Line Number="257">
<![CDATA[]]>
</Line>
<Line Number="258">
<![CDATA[// ************ End of Subroutine ********************]]>
</Line>
<Line Number="259">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="SR_LaneCntrl" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[//  Version: 2.0 / Author: Ranga Jayasinghe - Modified logic to integrate with D&F base code]]>
</Line>
<Line Number="9">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[// **************************************************************************************************************************************]]>
</Line>
<Line Number="12">
<![CDATA[//	Logic for Merge Coordination from  (P249 = Lane[1]) Through (P148 = Lane[4]) to P422 (Collector)]]>
</Line>
<Line Number="13">
<![CDATA[// **************************************************************************************************************************************]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[SBR(MRG414_i_diUNL_LaneIdx);]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[// Get local copy of control registers]]>
</Line>
<Line Number="18">
<![CDATA[COP(MRG414_astUNL_SlugBldCfg[MRG414_i_diUNL_LaneIdx],MRG414_stUNL_SlugBldCfgTmp1,1); ]]>
</Line>
<Line Number="19">
<![CDATA[COP(MRG414_astUNL_SlugBldCtrl[MRG414_i_diUNL_LaneIdx],MRG414_stUNL_SlugBldCtrlTmp1,1); ]]>
</Line>
<Line Number="20">
<![CDATA[COP(MRG414_astLaneClctrSlotResvStat[MRG414_i_diUNL_LaneIdx],MRG414_stLaneClctrSlotResvStat, 1);]]>
</Line>
<Line Number="21">
<![CDATA[COP(MRG414_astLaneClctrSlotResvCntrl[MRG414_i_diUNL_LaneIdx],MRG414_stLaneClctrSlotResvCntrl, 1);]]>
</Line>
<Line Number="22">
<![CDATA[COP(MRG414_astUNL_Q2_CnvCtrl[MRG414_i_diUNL_LaneIdx],MRG414_stUNL_Q2_CnvCtrl,1); ]]>
</Line>
<Line Number="23">
<![CDATA[COP(MRG414_astUNL_MRG_CnvCtrl[MRG414_i_diUNL_LaneIdx],MRG414_stUNL_MRG_CnvCtrl,1); ]]>
</Line>
<Line Number="24">
<![CDATA[COP(MRG414_astUNL_PT_CnvCtrl[MRG414_i_diUNL_LaneIdx],MRG414_stUNL_PT_CnvCtrl,1); ]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[// *****]]>
</Line>
<Line Number="27">
<![CDATA[// Lane Mode Management]]>
</Line>
<Line Number="28">
<![CDATA[// 0 = Stopped]]>
</Line>
<Line Number="29">
<![CDATA[// 1 = Startup, Merge any possible parcels on Power Turn and Inject conveyor]]>
</Line>
<Line Number="30">
<![CDATA[// 2 = Normal]]>
</Line>
<Line Number="31">
<![CDATA[// 3 = Manual/Maint]]>
</Line>
<Line Number="32">
<![CDATA[// *****]]>
</Line>
<Line Number="33">
<![CDATA[MRG414_stLaneClctrSlotResvStat.diLaneModePrev := MRG414_stLaneClctrSlotResvStat.diLaneMode;]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[IF (MRG414_stLaneClctrSlotResvStat.diLaneMode <> 1) THEN ]]>
</Line>
<Line Number="36">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xStartupComplete := 0;]]>
</Line>
<Line Number="37">
<![CDATA[END_IF;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xLaneStop ]]>
</Line>
<Line Number="40">
<![CDATA[  OR NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneRunEnable ]]>
</Line>
<Line Number="41">
<![CDATA[  OR NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneStartupEnable]]>
</Line>
<Line Number="42">
<![CDATA[  OR NOT MRG414_stLaneClctrSlotResvCntrl.xOkToReleaseLane  ]]>
</Line>
<Line Number="43">
<![CDATA[  THEN]]>
</Line>
<Line Number="44">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.diLaneMode := 0;]]>
</Line>
<Line Number="45">
<![CDATA[	]]>
</Line>
<Line Number="46">
<![CDATA[ELSIF MRG414_stUNL_SlugBldCtrlTmp1.xLaneMaintMode THEN ]]>
</Line>
<Line Number="47">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.diLaneMode := 3;]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[ELSIF (MRG414_stLaneClctrSlotResvStat.diLaneModePrev = 0) THEN ]]>
</Line>
<Line Number="50">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.diLaneMode := 1;]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[ELSIF (MRG414_stLaneClctrSlotResvStat.diLaneModePrev = 1) AND MRG414_stLaneClctrSlotResvStat.xStartupComplete  THEN ]]>
</Line>
<Line Number="53">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.diLaneMode := 2;]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[ELSE ]]>
</Line>
<Line Number="56">
<![CDATA[	; // Otherwise do not change the mode]]>
</Line>
<Line Number="57">
<![CDATA[	]]>
</Line>
<Line Number="58">
<![CDATA[END_IF;]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[// Check for Lane ]]>
</Line>
<Line Number="61">
<![CDATA[]]>
</Line>
<Line Number="62">
<![CDATA[// **********]]>
</Line>
<Line Number="63">
<![CDATA[// Q2 Slug Length Measuring]]>
</Line>
<Line Number="64">
<![CDATA[// **********]]>
</Line>
<Line Number="65">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugReadyToRelease_Q2 THEN ]]>
</Line>
<Line Number="66">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthReleaseMeasure := 0.0;]]>
</Line>
<Line Number="67">
<![CDATA[END_IF;]]>
</Line>
<Line Number="68">
<![CDATA[  ]]>
</Line>
<Line Number="69">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleasing_Q2 THEN ]]>
</Line>
<Line Number="70">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthReleaseMeasure := MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthReleaseMeasure + MRG414_stUNL_Q2_CnvCtrl.rDeltaDist;  ]]>
</Line>
<Line Number="71">
<![CDATA[END_IF;]]>
</Line>
<Line Number="72">
<![CDATA[]]>
</Line>
<Line Number="73">
<![CDATA[// While Q2 Slug is releasing set timer when PE is clear   ]]>
</Line>
<Line Number="74">
<![CDATA[MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugReleased_Q2.TimerEnable := MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleasing_Q2 AND NOT MRG414_stUNL_Q2_CnvCtrl.xPE_BlockedExit;]]>
</Line>
<Line Number="75">
<![CDATA[MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugReleased_Q2.PRE := 6000; //3000.0;]]>
</Line>
<Line Number="76">
<![CDATA[TONR(MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugReleased_Q2);]]>
</Line>
<Line Number="77">
<![CDATA[IF ((MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthReleaseMeasure > (MRG414_stLaneClctrSlotResvStat.rSlotSizeInch - MRG414_stUNL_SlugBldCfgTmp1.diQ2_SlugGapAdder)) AND NOT MRG414_stUNL_Q2_CnvCtrl.xPE_BlockedExit) // RJ updated. Org code:stUNL_SlugBldCtrlTmp1.tmrSlugReleased_Q2.DN AND (stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthReleaseMeasure > stLaneClctrSlotResvStat.rSlotSizeInch) THEN]]>
</Line>
<Line Number="78">
<![CDATA[	OR (((MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugReleased_Q2.ACC >= MRG414_stUNL_SlugBldCfgTmp1.diQ2_NoCartonTime ) AND (MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthReleaseMeasure > 0) AND MRG414_Enable_NoCartonCheck)) // RJ added]]>
</Line>
<Line Number="79">
<![CDATA[THEN ]]>
</Line>
<Line Number="80">
<![CDATA[	// RJ added to delete remaining slot reservation /////////////////////////]]>
</Line>
<Line Number="81">
<![CDATA[	IF (((MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugReleased_Q2.ACC >= MRG414_stUNL_SlugBldCfgTmp1.diQ2_NoCartonTime ) AND (MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthReleaseMeasure > 0) AND MRG414_Enable_NoCartonCheck)) // RJ added]]>
</Line>
<Line Number="82">
<![CDATA[	THEN]]>
</Line>
<Line Number="83">
<![CDATA[		MRG414_diCollUsableSlotSize := MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthReleaseMeasure + MRG414_stUNL_SlugBldCfgTmp1.diQ2_SlugGapAdder - MRG414_diNoCartonGap;]]>
</Line>
<Line Number="84">
<![CDATA[		MRG414_diCollSlotDelStartIdx := MRG414_stLaneClctrSlotResvCntrl.diSlotStartLoc + MRG414_diCollUsableSlotSize; //MRG422_stLaneClctrSlotResvCntrl.diResvLaneLoc - MRG422_diNoCartonGap + MRG422_stUNL_SlugBldCfgTmp1.diQ2_SlugGapAdder;]]>
</Line>
<Line Number="85">
<![CDATA[		IF MRG414_diCollSlotDelStartIdx > MRG414_diCollTrkPkgAryLastIdx THEN]]>
</Line>
<Line Number="86">
<![CDATA[			MRG414_diCollSlotDelStartIdx := MRG414_diCollTrkPkgAryLastIdx; ]]>
</Line>
<Line Number="87">
<![CDATA[		ELSIF MRG414_diCollSlotDelStartIdx < 0 THEN]]>
</Line>
<Line Number="88">
<![CDATA[			MRG414_diCollSlotDelStartIdx := 0;]]>
</Line>
<Line Number="89">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="90">
<![CDATA[		]]>
</Line>
<Line Number="91">
<![CDATA[		MRG414_diCollClrSlotSizeToDel := MRG414_stLaneClctrSlotResvCntrl.diSlotSizePls - MRG414_diCollUsableSlotSize; //Calcualte the slot size to delete (unused reservation) from tracking array]]>
</Line>
<Line Number="92">
<![CDATA[		IF (MRG414_diCollClrSlotSizeToDel < 0) THEN //Check for negative values]]>
</Line>
<Line Number="93">
<![CDATA[			MRG414_diCollClrSlotSizeToDel := 0;]]>
</Line>
<Line Number="94">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="95">
<![CDATA[		]]>
</Line>
<Line Number="96">
<![CDATA[		// Remove reservation from tracking array]]>
</Line>
<Line Number="97">
<![CDATA[		JSR(SR_CollTrackClrSlot]]>
</Line>
<Line Number="98">
<![CDATA[			,4			]]>
</Line>
<Line Number="99">
<![CDATA[			,MRG414_diCollSlotDelStartIdx 					// i_diCollClrStartIdx]]>
</Line>
<Line Number="100">
<![CDATA[			,MRG414_diCollClrSlotSizeToDel 					// i_diCollClrSlotSize]]>
</Line>
<Line Number="101">
<![CDATA[			,MRG414_stLaneClctrSlotResvStat.diLanePkgSeqId	// i_diCollClrTrkId]]>
</Line>
<Line Number="102">
<![CDATA[			,MRG414_i_diUNL_LaneIdx							// i_diCollClrLaneId ]]>
</Line>
<Line Number="103">
<![CDATA[			);]]>
</Line>
<Line Number="104">
<![CDATA[		]]>
</Line>
<Line Number="105">
<![CDATA[		MRG414_diNextUpStrmSlotStartLoc	:= MRG414_stLaneClctrSlotResvCntrl.diSlotStartLoc + MRG414_stLaneClctrSlotResvCntrl.diSlotSizePls;	]]>
</Line>
<Line Number="106">
<![CDATA[]]>
</Line>
<Line Number="107">
<![CDATA[		//Update slot length in "MRG422_astLaneClctrSlotResvCntrl"]]>
</Line>
<Line Number="108">
<![CDATA[	  	MRG414_diSlotSizePlsNew := MRG414_stLaneClctrSlotResvCntrl.diSlotSizePls - MRG414_diCollClrSlotSizeToDel;]]>
</Line>
<Line Number="109">
<![CDATA[		IF MRG414_diSlotSizePlsNew > 0 THEN]]>
</Line>
<Line Number="110">
<![CDATA[			MRG414_stLaneClctrSlotResvCntrl.diSlotSizePls := MRG414_diSlotSizePlsNew;]]>
</Line>
<Line Number="111">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="112">
<![CDATA[]]>
</Line>
<Line Number="113">
<![CDATA[		MRG414_diNextUpStrmSlotStartLocNew:= MRG414_diCollSlotDelStartIdx; //Set limit for upstream slot move]]>
</Line>
<Line Number="114">
<![CDATA[]]>
</Line>
<Line Number="115">
<![CDATA[		IF  MRG414_xShiftUpstrmSlotsAfterNoCarton THEN //Check next upstream slot. If it can be moved downstream to fill in the vacant space]]>
</Line>
<Line Number="116">
<![CDATA[			FOR MRG414_diNextUpStrmSlotStartLocIdx := MRG414_diNextUpStrmSlotStartLoc TO MRG414_diCollTrkPkgAryLastIdx DO]]>
</Line>
<Line Number="117">
<![CDATA[]]>
</Line>
<Line Number="118">
<![CDATA[				MRG414_diNextUpStrmSlotTrkID := MRG414_adiCollTrkArray[MRG414_diNextUpStrmSlotStartLocIdx] AND 16#0000_ffff; //Only last four digits contain the Track ID]]>
</Line>
<Line Number="119">
<![CDATA[]]>
</Line>
<Line Number="120">
<![CDATA[				IF MRG414_diNextUpStrmSlotTrkID > 0 THEN]]>
</Line>
<Line Number="121">
<![CDATA[					MRG414_diNextUpStrmSlotLnID 		:= MRG414_diNextUpStrmSlotTrkID / MRG414_diLaneID_Mod;]]>
</Line>
<Line Number="122">
<![CDATA[					MRG414_diNextUpStrmSlotResvLen		:= MRG414_astLaneClctrSlotResvCntrl[MRG414_diNextUpStrmSlotLnID].diSlotSizePls;]]>
</Line>
<Line Number="123">
<![CDATA[					MRG414_diNextUpStrmSlotEndLoc		:= MRG414_diNextUpStrmSlotStartLoc + MRG414_diNextUpStrmSlotResvLen - 1;]]>
</Line>
<Line Number="124">
<![CDATA[					MRG414_diNextUpStrmSlotResvLaneLoc	:= MRG414_astLaneClctrSlotResvCntrl[MRG414_diNextUpStrmSlotLnID].diResvLaneLoc;]]>
</Line>
<Line Number="125">
<![CDATA[					]]>
</Line>
<Line Number="126">
<![CDATA[					IF MRG414_diNextUpStrmSlotStartLocIdx > MRG414_diNextUpStrmSlotResvLaneLoc THEN //Check if upstream slot has not passed its merge location]]>
</Line>
<Line Number="127">
<![CDATA[						IF (MRG414_diNextUpStrmSlotStartLocNew < MRG414_diNextUpStrmSlotResvLaneLoc)THEN //Make sure upstream slot's new reservation start location will not pass its merge  location]]>
</Line>
<Line Number="128">
<![CDATA[							MRG414_diNextUpStrmSlotStartLocNew := MRG414_diNextUpStrmSlotResvLaneLoc;]]>
</Line>
<Line Number="129">
<![CDATA[						END_IF; ]]>
</Line>
<Line Number="130">
<![CDATA[						]]>
</Line>
<Line Number="131">
<![CDATA[						COP(MRG414_adiCollTrkArray[MRG414_diNextUpStrmSlotStartLocIdx], MRG414_adiCollTrkArray[MRG414_diNextUpStrmSlotStartLocNew],MRG414_diNextUpStrmSlotResvLen);]]>
</Line>
<Line Number="132">
<![CDATA[						MRG414_astLaneClctrSlotResvCntrl[MRG414_diNextUpStrmSlotLnID].diSlotStartLoc := MRG414_diNextUpStrmSlotStartLocNew;			]]>
</Line>
<Line Number="133">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="134">
<![CDATA[]]>
</Line>
<Line Number="135">
<![CDATA[					//Delete upstream slug tail end after moving data downstream]]>
</Line>
<Line Number="136">
<![CDATA[					MRG414_diCollClrSlotSizeToDel := MRG414_diNextUpStrmSlotStartLocIdx - MRG414_diNextUpStrmSlotStartLocNew;]]>
</Line>
<Line Number="137">
<![CDATA[					IF (MRG414_diCollClrSlotSizeToDel < 0) THEN]]>
</Line>
<Line Number="138">
<![CDATA[						MRG414_diCollClrSlotSizeToDel := 0;]]>
</Line>
<Line Number="139">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="140">
<![CDATA[					]]>
</Line>
<Line Number="141">
<![CDATA[					MRG414_diCollSlotDelStartIdx := MRG414_diNextUpStrmSlotStartLocNew + MRG414_diNextUpStrmSlotResvLen;]]>
</Line>
<Line Number="142">
<![CDATA[					MRG414_diNextUpStrmSlotPkgSeqID := MRG414_diNextUpStrmSlotTrkID/1000;]]>
</Line>
<Line Number="143">
<![CDATA[					]]>
</Line>
<Line Number="144">
<![CDATA[					// Remove reservation from tracking array]]>
</Line>
<Line Number="145">
<![CDATA[					JSR( SR_CollTrackClrSlot]]>
</Line>
<Line Number="146">
<![CDATA[						,4			]]>
</Line>
<Line Number="147">
<![CDATA[						,MRG414_diCollSlotDelStartIdx 		// i_diCollClrStartIdx]]>
</Line>
<Line Number="148">
<![CDATA[						,MRG414_diCollClrSlotSizeToDel 		// i_diCollClrSlotSize]]>
</Line>
<Line Number="149">
<![CDATA[						,MRG414_diNextUpStrmSlotPkgSeqID	// i_diCollClrTrkId]]>
</Line>
<Line Number="150">
<![CDATA[						,MRG414_diNextUpStrmSlotLnID		// i_diCollClrLaneId ]]>
</Line>
<Line Number="151">
<![CDATA[						);]]>
</Line>
<Line Number="152">
<![CDATA[						]]>
</Line>
<Line Number="153">
<![CDATA[					MRG414_diNextUpStrmSlotStartLocIdx := MRG414_diNextUpStrmSlotStartLocNew + MRG414_diNextUpStrmSlotResvLen; //Repeat for the next slot]]>
</Line>
<Line Number="154">
<![CDATA[					MRG414_diNextUpStrmSlotStartLocNew := MRG414_diNextUpStrmSlotStartLocIdx;	]]>
</Line>
<Line Number="155">
<![CDATA[					]]>
</Line>
<Line Number="156">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="157">
<![CDATA[			END_FOR;]]>
</Line>
<Line Number="158">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="159">
<![CDATA[	END_IF;			]]>
</Line>
<Line Number="160">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleased_Q2 := 1; // Stop releasing product]]>
</Line>
<Line Number="161">
<![CDATA[ELSE]]>
</Line>
<Line Number="162">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleased_Q2 := 0;]]>
</Line>
<Line Number="163">
<![CDATA[END_IF;]]>
</Line>
<Line Number="164">
<![CDATA[]]>
</Line>
<Line Number="165">
<![CDATA[]]>
</Line>
<Line Number="166">
<![CDATA[MRG414_stLaneClctrSlotResvStat.xSearchForSlotPrev := MRG414_stLaneClctrSlotResvStat.xSearchForSlot;]]>
</Line>
<Line Number="167">
<![CDATA[]]>
</Line>
<Line Number="168">
<![CDATA[// *************]]>
</Line>
<Line Number="169">
<![CDATA[// Check For Merge Complete]]>
</Line>
<Line Number="170">
<![CDATA[// *************]]>
</Line>
<Line Number="171">
<![CDATA[IF MRG414_stLaneClctrSlotResvStat.xLaneMerging AND MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleased_Q2 AND (MRG414_stLaneClctrSlotResvStat.diLaneMode = 2) THEN  // NORMAL Mode  ]]>
</Line>
<Line Number="172">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneMerging := 0; ]]>
</Line>
<Line Number="173">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlot := 0;]]>
</Line>
<Line Number="174">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlotPrev := 0;]]>
</Line>
<Line Number="175">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv := 0;]]>
</Line>
<Line Number="176">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot := 0;]]>
</Line>
<Line Number="177">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotAtMergePoint := 0;]]>
</Line>
<Line Number="178">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotPastMergePoint := 0;]]>
</Line>
<Line Number="179">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotReserved := 0;]]>
</Line>
<Line Number="180">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotFound := 0;]]>
</Line>
<Line Number="181">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="182">
<![CDATA[]]>
</Line>
<Line Number="183">
<![CDATA[// ******************]]>
</Line>
<Line Number="184">
<![CDATA[// Check For Slot at Merge Point on Collector]]>
</Line>
<Line Number="185">
<![CDATA[// ******************   ]]>
</Line>
<Line Number="186">
<![CDATA[IF MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot AND MRG414_stLaneClctrSlotResvCntrl.xSlotAtMergePoint THEN ]]>
</Line>
<Line Number="187">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneMerging := 1;]]>
</Line>
<Line Number="188">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot := 0;]]>
</Line>
<Line Number="189">
<![CDATA[	]]>
</Line>
<Line Number="190">
<![CDATA[	// Added reset of these status flags 9/15/2020]]>
</Line>
<Line Number="191">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlot := 0;]]>
</Line>
<Line Number="192">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlotPrev := 0;]]>
</Line>
<Line Number="193">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv := 0;]]>
</Line>
<Line Number="194">
<![CDATA[	]]>
</Line>
<Line Number="195">
<![CDATA[	// Added reset of these control flags 9/15/2020]]>
</Line>
<Line Number="196">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotAtMergePoint := 0;]]>
</Line>
<Line Number="197">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotPastMergePoint := 0;]]>
</Line>
<Line Number="198">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotReserved := 0;]]>
</Line>
<Line Number="199">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotFound := 0;]]>
</Line>
<Line Number="200">
<![CDATA[END_IF;]]>
</Line>
<Line Number="201">
<![CDATA[]]>
</Line>
<Line Number="202">
<![CDATA[// ******************]]>
</Line>
<Line Number="203">
<![CDATA[// Check For Slot past Merge Point on Collector]]>
</Line>
<Line Number="204">
<![CDATA[// ******************   ]]>
</Line>
<Line Number="205">
<![CDATA[IF MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot AND MRG414_stLaneClctrSlotResvCntrl.xSlotPastMergePoint THEN ]]>
</Line>
<Line Number="206">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneMerging := 0;]]>
</Line>
<Line Number="207">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlot := 0;]]>
</Line>
<Line Number="208">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlotPrev := 0;]]>
</Line>
<Line Number="209">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv := 0;]]>
</Line>
<Line Number="210">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot := 0;]]>
</Line>
<Line Number="211">
<![CDATA[	]]>
</Line>
<Line Number="212">
<![CDATA[	// Added reset of these control flags 9/15/2020]]>
</Line>
<Line Number="213">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotAtMergePoint := 0;]]>
</Line>
<Line Number="214">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotPastMergePoint := 0;]]>
</Line>
<Line Number="215">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotReserved := 0;]]>
</Line>
<Line Number="216">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotFound := 0;]]>
</Line>
<Line Number="217">
<![CDATA[END_IF;]]>
</Line>
<Line Number="218">
<![CDATA[]]>
</Line>
<Line Number="219">
<![CDATA[// ******************]]>
</Line>
<Line Number="220">
<![CDATA[// Check For Slot Reserved on Collector]]>
</Line>
<Line Number="221">
<![CDATA[// ******************   ]]>
</Line>
<Line Number="222">
<![CDATA[IF MRG414_stLaneClctrSlotResvCntrl.xSlotReserved AND (MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv OR MRG414_stLaneClctrSlotResvStat.xSearchForSlot) THEN]]>
</Line>
<Line Number="223">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot := 1;]]>
</Line>
<Line Number="224">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv := 0;]]>
</Line>
<Line Number="225">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlot := 0;]]>
</Line>
<Line Number="226">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="227">
<![CDATA[]]>
</Line>
<Line Number="228">
<![CDATA[// ********************]]>
</Line>
<Line Number="229">
<![CDATA[//  Startup Mode]]>
</Line>
<Line Number="230">
<![CDATA[// *********************]]>
</Line>
<Line Number="231">
<![CDATA[IF MRG414_stLaneClctrSlotResvStat.diLaneMode = 1 THEN  ]]>
</Line>
<Line Number="232">
<![CDATA[]]>
</Line>
<Line Number="233">
<![CDATA[	// Just transitioned into Startup Mode]]>
</Line>
<Line Number="234">
<![CDATA[	IF (MRG414_stLaneClctrSlotResvStat.diLaneModePrev <> 1)]]>
</Line>
<Line Number="235">
<![CDATA[	  THEN  ]]>
</Line>
<Line Number="236">
<![CDATA[		// Incrment the Lane PkgSequence ID ]]>
</Line>
<Line Number="237">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.diLanePkgSeqId := MRG414_stLaneClctrSlotResvStat.diLanePkgSeqId + 1;]]>
</Line>
<Line Number="238">
<![CDATA[		IF MRG414_stLaneClctrSlotResvStat.diLanePkgSeqId > MRG414_diLanePkgSeqId_Max THEN //RJ changed max from 999 to 99 to support more than 9 lanes]]>
</Line>
<Line Number="239">
<![CDATA[			MRG414_stLaneClctrSlotResvStat.diLanePkgSeqId := 1;]]>
</Line>
<Line Number="240">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="241">
<![CDATA[		// Set the Slug Size to be merged]]>
</Line>
<Line Number="242">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.rStartupSlotSizeInch := MRG414_stUNL_SlugBldCfgTmp1.rStartupSlugLenInch;]]>
</Line>
<Line Number="243">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.rStartupSlotSizeInch := MRG414_stLaneClctrSlotResvStat.rStartupSlotSizeInch * MRG414_stCollTrkSysCfg.rSlotReserveMultiple;  ]]>
</Line>
<Line Number="244">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.rStartupSlotSizeInch := MRG414_stLaneClctrSlotResvStat.rStartupSlotSizeInch + MRG414_stUNL_SlugBldCfgTmp1.diQ2_SlugGapAdder;]]>
</Line>
<Line Number="245">
<![CDATA[]]>
</Line>
<Line Number="246">
<![CDATA[		IF MRG414_stLaneClctrSlotResvStat.rStartupSlotSizeInch < 100.0 THEN ]]>
</Line>
<Line Number="247">
<![CDATA[			MRG414_stLaneClctrSlotResvStat.rStartupSlotSizeInch := 100.0; ]]>
</Line>
<Line Number="248">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="249">
<![CDATA[		MRG414_stUNL_SlugBldCtrlTmp1.rStartupSlugLengthMeasure := 0.0;]]>
</Line>
<Line Number="250">
<![CDATA[		]]>
</Line>
<Line Number="251">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.xSearchForSlot := 1;]]>
</Line>
<Line Number="252">
<![CDATA[]]>
</Line>
<Line Number="253">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.xLaneMerging := 0;]]>
</Line>
<Line Number="254">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.xSearchForSlotPrev := 0;]]>
</Line>
<Line Number="255">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv := 0;]]>
</Line>
<Line Number="256">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot := 0;]]>
</Line>
<Line Number="257">
<![CDATA[		]]>
</Line>
<Line Number="258">
<![CDATA[		// reset of these control flags ]]>
</Line>
<Line Number="259">
<![CDATA[		MRG414_stLaneClctrSlotResvCntrl.xSlotAtMergePoint := 0;]]>
</Line>
<Line Number="260">
<![CDATA[		MRG414_stLaneClctrSlotResvCntrl.xSlotPastMergePoint := 0;]]>
</Line>
<Line Number="261">
<![CDATA[		MRG414_stLaneClctrSlotResvCntrl.xSlotReserved := 0;]]>
</Line>
<Line Number="262">
<![CDATA[		MRG414_stLaneClctrSlotResvCntrl.xSlotFound := 0;]]>
</Line>
<Line Number="263">
<![CDATA[]]>
</Line>
<Line Number="264">
<![CDATA[	ELSE]]>
</Line>
<Line Number="265">
<![CDATA[		// Wait for the Merge cycle to complete]]>
</Line>
<Line Number="266">
<![CDATA[		]]>
</Line>
<Line Number="267">
<![CDATA[  		IF NOT MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv ]]>
</Line>
<Line Number="268">
<![CDATA[  		  AND NOT MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot ]]>
</Line>
<Line Number="269">
<![CDATA[  		  AND NOT MRG414_stLaneClctrSlotResvStat.xLaneMerging ]]>
</Line>
<Line Number="270">
<![CDATA[  		  THEN ]]>
</Line>
<Line Number="271">
<![CDATA[			MRG414_stLaneClctrSlotResvStat.xSearchForSlot := 1;]]>
</Line>
<Line Number="272">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="273">
<![CDATA[]]>
</Line>
<Line Number="274">
<![CDATA[		IF MRG414_stLaneClctrSlotResvStat.xLaneMerging THEN ]]>
</Line>
<Line Number="275">
<![CDATA[			MRG414_stUNL_SlugBldCtrlTmp1.rStartupSlugLengthMeasure := MRG414_stUNL_SlugBldCtrlTmp1.rStartupSlugLengthMeasure + MRG414_stUNL_MRG_CnvCtrl.rDeltaDist;]]>
</Line>
<Line Number="276">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="277">
<![CDATA[		]]>
</Line>
<Line Number="278">
<![CDATA[		// Startup merge complete]]>
</Line>
<Line Number="279">
<![CDATA[		IF MRG414_stUNL_SlugBldCtrlTmp1.rStartupSlugLengthMeasure >= MRG414_stLaneClctrSlotResvStat.rStartupSlotSizeInch]]>
</Line>
<Line Number="280">
<![CDATA[		THEN ]]>
</Line>
<Line Number="281">
<![CDATA[			MRG414_stLaneClctrSlotResvStat.xStartupComplete := 1;]]>
</Line>
<Line Number="282">
<![CDATA[			]]>
</Line>
<Line Number="283">
<![CDATA[			// Added 9/24/2020]]>
</Line>
<Line Number="284">
<![CDATA[			MRG414_stLaneClctrSlotResvStat.xLaneMerging := 0;]]>
</Line>
<Line Number="285">
<![CDATA[			MRG414_stLaneClctrSlotResvStat.xSearchForSlot := 0;]]>
</Line>
<Line Number="286">
<![CDATA[			MRG414_stLaneClctrSlotResvStat.xSearchForSlotPrev := 0;]]>
</Line>
<Line Number="287">
<![CDATA[			MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv := 0;]]>
</Line>
<Line Number="288">
<![CDATA[			MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot := 0;]]>
</Line>
<Line Number="289">
<![CDATA[			MRG414_stLaneClctrSlotResvCntrl.xSlotAtMergePoint := 0;]]>
</Line>
<Line Number="290">
<![CDATA[			MRG414_stLaneClctrSlotResvCntrl.xSlotPastMergePoint := 0;]]>
</Line>
<Line Number="291">
<![CDATA[			MRG414_stLaneClctrSlotResvCntrl.xSlotReserved := 0;]]>
</Line>
<Line Number="292">
<![CDATA[			MRG414_stLaneClctrSlotResvCntrl.xSlotFound := 0;			]]>
</Line>
<Line Number="293">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="294">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="295">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="296">
<![CDATA[]]>
</Line>
<Line Number="297">
<![CDATA[]]>
</Line>
<Line Number="298">
<![CDATA[// ******************]]>
</Line>
<Line Number="299">
<![CDATA[// Check if should request a slot when Slug is ready to release]]>
</Line>
<Line Number="300">
<![CDATA[// ******************   ]]>
</Line>
<Line Number="301">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugReadyToRelease_Q2 ]]>
</Line>
<Line Number="302">
<![CDATA[  AND (MRG414_stLaneClctrSlotResvStat.diLaneMode = 2)   // NORMAL Mode]]>
</Line>
<Line Number="303">
<![CDATA[  AND NOT MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv ]]>
</Line>
<Line Number="304">
<![CDATA[  AND NOT MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot ]]>
</Line>
<Line Number="305">
<![CDATA[  AND NOT MRG414_stLaneClctrSlotResvStat.xLaneMerging ]]>
</Line>
<Line Number="306">
<![CDATA[  AND NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneFlowControlActive  //RJ enabled flow control which was disabled in org code: "AND NOT stUNL_SlugBldCtrl.xLaneFlowControlActive"]]>
</Line>
<Line Number="307">
<![CDATA[  THEN]]>
</Line>
<Line Number="308">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlot := 1;]]>
</Line>
<Line Number="309">
<![CDATA[END_IF;]]>
</Line>
<Line Number="310">
<![CDATA[   ]]>
</Line>
<Line Number="311">
<![CDATA[IF MRG414_stLaneClctrSlotResvStat.xLaneMerging  AND (MRG414_stLaneClctrSlotResvStat.diLaneMode = 2) AND MRG414_stLaneClctrSlotResvCntrl.xOkToReleaseLane THEN]]>
</Line>
<Line Number="312">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleasing_Q2 := 1;]]>
</Line>
<Line Number="313">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugReadyToRelease_Q2 := 0;]]>
</Line>
<Line Number="314">
<![CDATA[ELSE ]]>
</Line>
<Line Number="315">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleasing_Q2 := 0;]]>
</Line>
<Line Number="316">
<![CDATA[END_IF;]]>
</Line>
<Line Number="317">
<![CDATA[]]>
</Line>
<Line Number="318">
<![CDATA[// While accepting slug from Q1, build slug length relative to Q2 distance traveled and trailing gap relative to Q]]>
</Line>
<Line Number="319">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepting_Q2 AND MRG414_stUNL_Q2_CnvCtrl.xCnvRunning AND MRG414_stUNL_Q2_CnvCtrl.xPE_BlockedEntr AND NOT MRG414_stUNL_SlugBldCtrlTmp1.xSlugLengthAcceptMeasureArm_Q2 then]]>
</Line>
<Line Number="320">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugLengthAcceptMeasureArm_Q2 := 1;]]>
</Line>
<Line Number="321">
<![CDATA[END_IF;]]>
</Line>
<Line Number="322">
<![CDATA[]]>
</Line>
<Line Number="323">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugLengthAcceptMeasureArm_Q2 then]]>
</Line>
<Line Number="324">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthAcceptMeasure := MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthAcceptMeasure + MRG414_stUNL_Q2_CnvCtrl.rDeltaDist;]]>
</Line>
<Line Number="325">
<![CDATA[	]]>
</Line>
<Line Number="326">
<![CDATA[	IF MRG414_stUNL_Q2_CnvCtrl.xPE_BlockedEntr THEN ]]>
</Line>
<Line Number="327">
<![CDATA[		MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugGapLengthAcceptMeasure := 0.0;]]>
</Line>
<Line Number="328">
<![CDATA[ 	ELSE ]]>
</Line>
<Line Number="329">
<![CDATA[	 	MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugGapLengthAcceptMeasure := MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugGapLengthAcceptMeasure + MRG414_stUNL_Q2_CnvCtrl.rDeltaDist;]]>
</Line>
<Line Number="330">
<![CDATA[ 	END_IF;]]>
</Line>
<Line Number="331">
<![CDATA[else]]>
</Line>
<Line Number="332">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthAcceptMeasure := 0.0;]]>
</Line>
<Line Number="333">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugGapLengthAcceptMeasure := 0.0;]]>
</Line>
<Line Number="334">
<![CDATA[END_IF;]]>
</Line>
<Line Number="335">
<![CDATA[]]>
</Line>
<Line Number="336">
<![CDATA[// ******]]>
</Line>
<Line Number="337">
<![CDATA[// Check When accepted Slug is at PE - PE is blocked]]>
</Line>
<Line Number="338">
<![CDATA[// ******   ]]>
</Line>
<Line Number="339">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepting_Q2 AND MRG414_stUNL_Q2_CnvCtrl.xCnvRunning AND  MRG414_stUNL_Q2_CnvCtrl.xPE_BlockedExit THEN ]]>
</Line>
<Line Number="340">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_Q2 := 1;]]>
</Line>
<Line Number="341">
<![CDATA[END_IF;]]>
</Line>
<Line Number="342">
<![CDATA[]]>
</Line>
<Line Number="343">
<![CDATA[// Determine when to run to Accept another slug   ]]>
</Line>
<Line Number="344">
<![CDATA[MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepting_Q2 := NOT MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_Q2 AND NOT MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleasing_Q2 AND NOT MRG414_stUNL_SlugBldCtrlTmp1.xSlugReadyToRelease_Q2;]]>
</Line>
<Line Number="345">
<![CDATA[]]>
</Line>
<Line Number="346">
<![CDATA[// Record the Slug Length as soon as fully accepted]]>
</Line>
<Line Number="347">
<![CDATA[// And increment the sequence id for this lane  ]]>
</Line>
<Line Number="348">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_Q2 AND NOT MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_ONS_Q2 THEN ]]>
</Line>
<Line Number="349">
<![CDATA[	]]>
</Line>
<Line Number="350">
<![CDATA[	// Capture length of slug and gap length relative to Q2 belt travel and entrance PE state.  Calculate reservation slot size]]>
</Line>
<Line Number="351">
<![CDATA[	// in inches from slug length and gap measured on Q2.]]>
</Line>
<Line Number="352">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthAccept_Q := MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthAcceptMeasure;]]>
</Line>
<Line Number="353">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugGapLengthAccept_Q := MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugGapLengthAcceptMeasure;]]>
</Line>
<Line Number="354">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlotSizeMeasure := MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugLengthAccept_Q - MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlugGapLengthAccept_Q; ]]>
</Line>
<Line Number="355">
<![CDATA[	]]>
</Line>
<Line Number="356">
<![CDATA[	// Calculate reservation slot size in inches from slug length and gap captured on measured Q1 during release to Q2.]]>
</Line>
<Line Number="357">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.rQ1_SlotSizeMeasure := MRG414_stUNL_SlugBldCtrlTmp1.rQ1_SlugLength_Q - MRG414_stUNL_SlugBldCtrlTmp1.rQ1_GapLength_Q;]]>
</Line>
<Line Number="358">
<![CDATA[	]]>
</Line>
<Line Number="359">
<![CDATA[	// Compare the slot sizes from slug and gap from Q1 and Q2 and take the largest value.]]>
</Line>
<Line Number="360">
<![CDATA[	IF MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlotSizeMeasure >= MRG414_stUNL_SlugBldCtrlTmp1.rQ1_SlotSizeMeasure THEN]]>
</Line>
<Line Number="361">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.rSlotSizeInch := MRG414_stUNL_SlugBldCtrlTmp1.rQ2_SlotSizeMeasure;]]>
</Line>
<Line Number="362">
<![CDATA[	else]]>
</Line>
<Line Number="363">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.rSlotSizeInch := MRG414_stUNL_SlugBldCtrlTmp1.rQ1_SlotSizeMeasure;]]>
</Line>
<Line Number="364">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="365">
<![CDATA[	IF MRG414_stLaneClctrSlotResvStat.rSlotSizeInch  > MRG414_stUNL_SlugBldCfgTmp1.rQ2_MaxTrainLen THEN ]]>
</Line>
<Line Number="366">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.rSlotSizeInch  := MRG414_stUNL_SlugBldCfgTmp1.rQ2_MaxTrainLen;]]>
</Line>
<Line Number="367">
<![CDATA[	END_IF; ]]>
</Line>
<Line Number="368">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.rSlotSizeInch := MRG414_stLaneClctrSlotResvStat.rSlotSizeInch * MRG414_stCollTrkSysCfg.rSlotReserveMultiple;  ]]>
</Line>
<Line Number="369">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.rSlotSizeInch := MRG414_stLaneClctrSlotResvStat.rSlotSizeInch + MRG414_stUNL_SlugBldCfgTmp1.diQ2_SlugGapAdder;]]>
</Line>
<Line Number="370">
<![CDATA[]]>
</Line>
<Line Number="371">
<![CDATA[	IF MRG414_stLaneClctrSlotResvStat.rSlotSizeInch < 20.0 THEN ]]>
</Line>
<Line Number="372">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.rSlotSizeInch := 20.0; ]]>
</Line>
<Line Number="373">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="374">
<![CDATA[]]>
</Line>
<Line Number="375">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.diLanePkgSeqId := MRG414_stLaneClctrSlotResvStat.diLanePkgSeqId + 1;]]>
</Line>
<Line Number="376">
<![CDATA[	IF MRG414_stLaneClctrSlotResvStat.diLanePkgSeqId > MRG414_diLanePkgSeqId_Max THEN //RJ changed max from 999 to 99 to support more than 9 lanes]]>
</Line>
<Line Number="377">
<![CDATA[		MRG414_stLaneClctrSlotResvStat.diLanePkgSeqId := 1;]]>
</Line>
<Line Number="378">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="379">
<![CDATA[	]]>
</Line>
<Line Number="380">
<![CDATA[END_IF;]]>
</Line>
<Line Number="381">
<![CDATA[MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_ONS_Q2 := MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_Q2;]]>
</Line>
<Line Number="382">
<![CDATA[]]>
</Line>
<Line Number="383">
<![CDATA[IF NOT MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepting_Q2 then]]>
</Line>
<Line Number="384">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugLengthAcceptMeasureArm_Q2 := 0;]]>
</Line>
<Line Number="385">
<![CDATA[END_If;]]>
</Line>
<Line Number="386">
<![CDATA[  ]]>
</Line>
<Line Number="387">
<![CDATA[MRG414_stUNL_SlugBldCtrlTmp1.tmrStopped_Q2.PRE := 100; //RJ changed from "1000"]]>
</Line>
<Line Number="388">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_Q2 THEN //RJ modified  //org-> stUNL_SlugBldCtrl.xSlugAccepted_Q2 THEN AND (MRG422_stUNL_Q2_CnvCtrl.rCurrSpd <= 0.0)]]>
</Line>
<Line Number="389">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.tmrStopped_Q2.TimerEnable := 1;]]>
</Line>
<Line Number="390">
<![CDATA[	IF MRG414_stUNL_SlugBldCtrlTmp1.tmrStopped_Q2.DN AND NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneDisabled AND NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneStop AND (MRG414_stUNL_MRG_CnvCtrl.rCurrSpd > 0.0) AND MRG414_stLaneClctrSlotResvCntrl.xOkToReleaseLane AND NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneFlowControlActive THEN // RJ added flow control check]]>
</Line>
<Line Number="391">
<![CDATA[		MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_Q2 := 0;]]>
</Line>
<Line Number="392">
<![CDATA[		MRG414_stUNL_SlugBldCtrlTmp1.xSlugReadyToRelease_Q2 := 1;]]>
</Line>
<Line Number="393">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="394">
<![CDATA[ELSE ]]>
</Line>
<Line Number="395">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.tmrStopped_Q2.TimerEnable := 0;]]>
</Line>
<Line Number="396">
<![CDATA[END_IF;]]>
</Line>
<Line Number="397">
<![CDATA[TONR(MRG414_stUNL_SlugBldCtrlTmp1.tmrStopped_Q2);]]>
</Line>
<Line Number="398">
<![CDATA[]]>
</Line>
<Line Number="399">
<![CDATA[// *********]]>
</Line>
<Line Number="400">
<![CDATA[// Check for a Fault or Area Stop While Realeasing or Ready To Release]]>
</Line>
<Line Number="401">
<![CDATA[// *********]]>
</Line>
<Line Number="402">
<![CDATA[// 2017-01-18 Added Condition for Stop_PS_Lanes or xxx_Disable_Feed]]>
</Line>
<Line Number="403">
<![CDATA[// **********  ]]>
</Line>
<Line Number="404">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleasing_Q2 THEN ]]>
</Line>
<Line Number="405">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugHalted_Q2.PRE := 100; ]]>
</Line>
<Line Number="406">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugHalted_Q2.TimerEnable := (NOT MRG414_stUNL_MRG_CnvCtrl.xCnvRunning) OR (NOT MRG414_stUNL_PT_CnvCtrl.xCnvRunning) OR (NOT MRG414_stUNL_Q2_CnvCtrl.xCnvRunning);]]>
</Line>
<Line Number="407">
<![CDATA[	IF MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugHalted_Q2.DN OR NOT MRG414_stCollStatus.xClctrRunningAtSpeed OR (MRG414_stLaneClctrSlotResvStat.diLaneMode <> 2) THEN]]>
</Line>
<Line Number="408">
<![CDATA[		MRG414_stUNL_SlugBldCtrlTmp1.xSlugHalted_Q2 := 1; ]]>
</Line>
<Line Number="409">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="410">
<![CDATA[ELsif (MRG414_stUNL_SlugBldCtrlTmp1.xSlugReadyToRelease_Q2 OR MRG414_stUNL_SlugBldCtrlTmp1.xSlugHalted_Q2) AND NOT MRG414_stUNL_SlugBldCtrlTmp1.xSlugReleasing_Q2 then]]>
</Line>
<Line Number="411">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugHalted_Q2 := MRG414_stUNL_SlugBldCtrlTmp1.xLaneDisabled OR MRG414_stUNL_SlugBldCtrlTmp1.xLaneFlowControlActive; // RJ added flow control check]]>
</Line>
<Line Number="412">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugHalted_Q2.TimerEnable := 0;]]>
</Line>
<Line Number="413">
<![CDATA[ELSE]]>
</Line>
<Line Number="414">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugHalted_Q2 := 0;]]>
</Line>
<Line Number="415">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugHalted_Q2.TimerEnable := 0;]]>
</Line>
<Line Number="416">
<![CDATA[END_IF;]]>
</Line>
<Line Number="417">
<![CDATA[TONR(MRG414_stUNL_SlugBldCtrlTmp1.tmrSlugHalted_Q2);]]>
</Line>
<Line Number="418">
<![CDATA[]]>
</Line>
<Line Number="419">
<![CDATA[//*************]]>
</Line>
<Line Number="420">
<![CDATA[// Check For Slug Halted]]>
</Line>
<Line Number="421">
<![CDATA[// *************   ]]>
</Line>
<Line Number="422">
<![CDATA[IF MRG414_stUNL_SlugBldCtrlTmp1.xSlugHalted_Q2 THEN ]]>
</Line>
<Line Number="423">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneMerging := 0;]]>
</Line>
<Line Number="424">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlot := 0;]]>
</Line>
<Line Number="425">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xSearchForSlotPrev := 0;]]>
</Line>
<Line Number="426">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForResv := 0;]]>
</Line>
<Line Number="427">
<![CDATA[	MRG414_stLaneClctrSlotResvStat.xLaneWaitingForslot := 0;]]>
</Line>
<Line Number="428">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSearchForSlotAck := 0;]]>
</Line>
<Line Number="429">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotFound := 0;]]>
</Line>
<Line Number="430">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotReserved := 0;]]>
</Line>
<Line Number="431">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotResvRevoked := 0;]]>
</Line>
<Line Number="432">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotCompromised := 0;]]>
</Line>
<Line Number="433">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotAtMergePoint := 0;]]>
</Line>
<Line Number="434">
<![CDATA[	MRG414_stLaneClctrSlotResvCntrl.xSlotPastMergePoint := 0;]]>
</Line>
<Line Number="435">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_Q2 := 1;	]]>
</Line>
<Line Number="436">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugReadyToRelease_Q2 := 0;]]>
</Line>
<Line Number="437">
<![CDATA[END_IF;]]>
</Line>
<Line Number="438">
<![CDATA[]]>
</Line>
<Line Number="439">
<![CDATA[// Update when a slug is approaching to perform a collector search of a slot]]>
</Line>
<Line Number="440">
<![CDATA[IF (NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneDisabled) AND (NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneStop) AND (NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneAnyConvFaulted) AND (MRG414_stUNL_SlugBldCtrlTmp1.xLaneRunEnable) AND (NOT MRG414_stUNL_SlugBldCtrlTmp1.xLaneFlowControlActive) THEN //RJ added flow control check]]>
</Line>
<Line Number="441">
<![CDATA[	IF (MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepted_Q2)]]>
</Line>
<Line Number="442">
<![CDATA[	   OR MRG414_stUNL_SlugBldCtrlTmp1.xSlugReadyToRelease_Q2]]>
</Line>
<Line Number="443">
<![CDATA[	   OR (MRG414_stUNL_SlugBldCtrlTmp1.xSlugLengthAcceptMeasureArm_Q2  AND MRG414_stUNL_SlugBldCtrlTmp1.xSlugAccepting_Q2)]]>
</Line>
<Line Number="444">
<![CDATA[	   OR (MRG414_stUNL_SlugBldCtrlTmp1.xSlugAcceptingMeasure_Q1 AND (MRG414_stUNL_SlugBldCtrlTmp1.rQ1_SlugLengthAcceptMeasure > (MRG414_stUNL_SlugBldCfgTmp1.rQ1_MaxTrainLen / 2.0)))]]>
</Line>
<Line Number="445">
<![CDATA[	THEN]]>
</Line>
<Line Number="446">
<![CDATA[		MRG414_stUNL_SlugBldCtrlTmp1.xSlugApproachClctrSrch := 1; ]]>
</Line>
<Line Number="447">
<![CDATA[	ELSE]]>
</Line>
<Line Number="448">
<![CDATA[		MRG414_stUNL_SlugBldCtrlTmp1.xSlugApproachClctrSrch := 0;]]>
</Line>
<Line Number="449">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="450">
<![CDATA[ELSE]]>
</Line>
<Line Number="451">
<![CDATA[	MRG414_stUNL_SlugBldCtrlTmp1.xSlugApproachClctrSrch := 0;]]>
</Line>
<Line Number="452">
<![CDATA[END_IF;]]>
</Line>
<Line Number="453">
<![CDATA[]]>
</Line>
<Line Number="454">
<![CDATA[// Update array elements of control]]>
</Line>
<Line Number="455">
<![CDATA[COP(MRG414_stUNL_SlugBldCtrlTmp1,MRG414_astUNL_SlugBldCtrl[MRG414_i_diUNL_LaneIdx],1);]]>
</Line>
<Line Number="456">
<![CDATA[COP(MRG414_stLaneClctrSlotResvStat,MRG414_astLaneClctrSlotResvStat[MRG414_i_diUNL_LaneIdx],1);]]>
</Line>
<Line Number="457">
<![CDATA[COP(MRG414_stLaneClctrSlotResvCntrl,MRG414_astLaneClctrSlotResvCntrl[MRG414_i_diUNL_LaneIdx],1);]]>
</Line>
<Line Number="458">
<![CDATA[]]>
</Line>
<Line Number="459">
<![CDATA[]]>
</Line>
<Line Number="460">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Controller>
</RSLogix5000Content>
