<Program Name="Sawtooth_Merge" TestEdits="false" MainRoutineName="Main_Routine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Conv_Enc" Type="RLL"/>
<Routine Name="Conv_Fast" Type="RLL"/>
<Routine Name="Conv_PE" Type="RLL"/>
<Routine Name="Main_Routine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Initialize Default Values
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[XIC(MRG414_xINIT)OTU(MRG414_xCollTrackConfigured)OTU(MRG414_xINIT);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Enable Collector Tracking Histogram
Refer to "RT_CollTrackHist"
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[XIC(MRG414_xLaneClctrTrkHistorize)NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Reset Reservation Stats for Lanes
Refer to "RT_CollResetCounts"
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[XIC(MRG414_xCollResetCounts)NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Debug: Freeze the Track Array Data to 
"MRG500_adiCollTrkArray_Freeze"
"MRG500_astLaneClctrSlotResvCntrl_Freeze"
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[XIC(MRG414_xLaneClctrTrkAryFreeze)NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Calibrate PEs on the Collector
Refer to "RT_CollPeTrackCal". First enable "MRG500_xLaneClctrPeCalibrate" then "MRG500_xCollTrackPE_OffsetCaptureArm".
PE offsets will be saved to "MRG500_astCollPeTrackCal[x].diPlsCntSave" and "MRG500_xCollTrackPE_OffsetCaptureArm" gets reset when process is completed.
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[XIC(MRG414_xLaneClctrPeCalibrate)XIC(MRG414_xCollTrackPE_OffsetCaptureArm)NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Calibrate PEs on the Collector
Refer to "RT_CollPeTrackCal". First enable "MRG500_xLaneClctrPeCalibrate" then "MRG500_xCollTrackPE_OffsetCaptureArm".
PE offsets will be saved to "MRG500_astCollPeTrackCal[x].diPlsCntSave" and "MRG500_xCollTrackPE_OffsetCaptureArm" gets reset when process is completed.
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[XIC(MRG414_xLaneOffsetFind)XIC(MRG414_xLane_OffsetCaptureArm)NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Collector Lane Merge Capture to check slug reservation against actual slug position
Refer to "RT_CollLaneMergeCapture" and (MRG500_stCollLaneMrgCapture.diLaneId, MRG500_stCollLaneMrgCapture.diDelta)
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[XIC(MRG414_xCollLaneMrgCaptureArm)MOV(MRG414_stCollLaneMrgCapture.diTrackId,MRG414_stCollLaneMrgCapture.diTrackId)MOV(MRG414_stCollLaneMrgCapture.diLaneId,MRG414_stCollLaneMrgCapture.diLaneId)MOV(MRG414_stCollLaneMrgCapture.diDelta,MRG414_stCollLaneMrgCapture.diDelta);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[JSR(Conv_Fast,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[JSR(Conv_PE,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[JSR(Conv_Enc,0);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Enable_Merge2_Trk)[XIC(Use_GapStore_Belts) MOV(400,P414_SawMerge_HMI.ClctrSpeed_FPM) ,XIO(Use_GapStore_Belts) MOV(140,P414_SawMerge_HMI.ClctrSpeed_FPM) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Enable_Merge2_Trk)XIO(Use_GapStore_Belts)JSR(RT_DeltaDist_NoGapStore,0);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Enable_Merge2_Trk)XIO(Use_GapStore_Belts)JSR(RT_IO_Map_NoGapStore,0);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Enable_Merge2_Trk)XIC(Enable_Merge1_Reserv)JSR(RT_CollTrackMain,0);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(S:FS)MOV(1,MRG414_stCollStatus.diClctrMode);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="RT_CollLaneMergeCapture" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[////////////////////////////////////////////////]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[//  Collector Lane Merge Capture]]>
</Line>
<Line Number="13">
<![CDATA[//]]>
</Line>
<Line Number="14">
<![CDATA[//	For each Lane capture the delta between the front edge of the lane reservation and the lead edge of the slug lead parcel reaching PE-8]]>
</Line>
<Line Number="15">
<![CDATA[//	Determine how far ahead or behind the closest Tracking slot is to the PE lead edge]]>
</Line>
<Line Number="16">
<![CDATA[//	A negative Delta indicates that the reserved slot was ahead of the lead parcel reaching the PE - Good if delta is not too large]]>
</Line>
<Line Number="17">
<![CDATA[//  A positive delta indicates that the lead parcel reached the PE ahead of the reserved slot - Bad ]]>
</Line>
<Line Number="18">
<![CDATA[//]]>
</Line>
<Line Number="19">
<![CDATA[//	For a positive delta the stCollTrkSysCfg.adiLaneLoc[x] must be decreased or moved further downstream]]>
</Line>
<Line Number="20">
<![CDATA[// 	For a large negative delta the stCollTrkSysCfg.adiLaneLoc[x] must be increased or moved further upstream]]>
</Line>
<Line Number="21">
<![CDATA[// ]]>
</Line>
<Line Number="22">
<![CDATA[////////////////////////////////////////////////]]>
</Line>
<Line Number="23">
<![CDATA[MRG414_stCollTrkSysCfg.diNumPE := MRG414_stCollTrkSysCfg.diNumPE;]]>
</Line>
<Line Number="24">
<![CDATA[IF MRG414_xCollLaneMrgCaptureArm THEN]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[	IF MRG414_astCollPe[MRG414_stCollTrkSysCfg.diNumPE].xIsBlocked THEN]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[		// Debug count]]>
</Line>
<Line Number="29">
<![CDATA[		MRG414_stCollLaneMrgCapture.diNumCaptures := MRG414_stCollLaneMrgCapture.diNumCaptures + 1;]]>
</Line>
<Line Number="30">
<![CDATA[		]]>
</Line>
<Line Number="31">
<![CDATA[		// Zero Out the Capture Information ]]>
</Line>
<Line Number="32">
<![CDATA[		MRG414_stCollLaneMrgCapture.diLaneId := 0;]]>
</Line>
<Line Number="33">
<![CDATA[		MRG414_stCollLaneMrgCapture.diTrackId := 0;]]>
</Line>
<Line Number="34">
<![CDATA[		MRG414_stCollLaneMrgCapture.diDelta := 0;]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[		// When the Last PE on collector becomes blocked, then Capture the Collector Tracking Array]]>
</Line>
<Line Number="37">
<![CDATA[		COP(MRG414_adiCollTrkArray[0], MRG414_adiCollTrkArray_Capture[0], MRG414_diCollTrkPkgArySize);]]>
</Line>
<Line Number="38">
<![CDATA[		]]>
</Line>
<Line Number="39">
<![CDATA[		// Disarm the capture]]>
</Line>
<Line Number="40">
<![CDATA[		MRG414_xCollLaneMrgCaptureArm := 0;		]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[		// Calculate the delta between the Lane's Reservation in the Collector Tracking array and the Lead Edge breaking the PE]]>
</Line>
<Line Number="43">
<![CDATA[		// First search downstream of the Last PE]]>
</Line>
<Line Number="44">
<![CDATA[		FOR MRG414_stCollLaneMrgCapture.diCollMrgCapIndex_A :=  1 TO MRG414_diCollTrkPkgAryLastIdx DO]]>
</Line>
<Line Number="45">
<![CDATA[			// Check for a non-zero ID ]]>
</Line>
<Line Number="46">
<![CDATA[			MRG414_stCollLaneMrgCapture.diLaneTrackId := MRG414_adiCollTrkArray_Capture[MRG414_stCollLaneMrgCapture.diCollMrgCapIndex_A] AND 16#0000FFFF;]]>
</Line>
<Line Number="47">
<![CDATA[			]]>
</Line>
<Line Number="48">
<![CDATA[			// find a non-zero LaneTrackId ]]>
</Line>
<Line Number="49">
<![CDATA[			IF MRG414_stCollLaneMrgCapture.diLaneTrackId > 0 THEN ]]>
</Line>
<Line Number="50">
<![CDATA[				MRG414_stCollLaneMrgCapture.diLaneId := MRG414_stCollLaneMrgCapture.diLaneTrackId / MRG414_diLaneID_Mod;]]>
</Line>
<Line Number="51">
<![CDATA[				MRG414_stCollLaneMrgCapture.diTrackId := MRG414_stCollLaneMrgCapture.diLaneTrackId MOD MRG414_diLaneID_Mod;]]>
</Line>
<Line Number="52">
<![CDATA[				MRG414_stCollLaneMrgCapture.diDelta := MRG414_stCollLaneMrgCapture.diCollMrgCapIndex_A - MRG414_astCollPeCfg[MRG414_stCollTrkSysCfg.diNumPE].diPlsLocation;]]>
</Line>
<Line Number="53">
<![CDATA[				EXIT;]]>
</Line>
<Line Number="54">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="55">
<![CDATA[		END_FOR;]]>
</Line>
<Line Number="56">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="57">
<![CDATA[END_IF;]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="RT_CollPeTrackCal" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[////////////////////////////////////////////////]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[// Collector Photo-Eye Calibration]]>
</Line>
<Line Number="13">
<![CDATA[// First enable "MRG422_xLaneClctrPeCalibrate" then "MRG422_xCollTrackPE_OffsetCaptureArm"]]>
</Line>
<Line Number="14">
<![CDATA[// PE offsets will be saved to "MRG422_astCollPeTrackCal[x].diPlsCntSave" and "MRG422_xCollTrackPE_OffsetCaptureArm" gets reset when process is completed]]>
</Line>
<Line Number="15">
<![CDATA[////////////////////////////////////////////////]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[IF MRG414_xCollTrackPE_OffsetCaptureArm then]]>
</Line>
<Line Number="18">
<![CDATA[	]]>
</Line>
<Line Number="19">
<![CDATA[	FOR MRG414_diCollCalPeIndex := 1 TO (MRG414_stCollTrkSysCfg.diNumPE) DO]]>
</Line>
<Line Number="20">
<![CDATA[		]]>
</Line>
<Line Number="21">
<![CDATA[		// Tracking PE's]]>
</Line>
<Line Number="22">
<![CDATA[		IF (MRG414_diCollCalPeIndex >= 1) AND  (MRG414_diCollCalPeIndex <= (MRG414_stCollTrkSysCfg.diNumPE - 1)) THEN]]>
</Line>
<Line Number="23">
<![CDATA[			]]>
</Line>
<Line Number="24">
<![CDATA[			// Pulse counter for all PE's]]>
</Line>
<Line Number="25">
<![CDATA[			IF (MRG414_diCollDeltaEncCnt > 0) THEN]]>
</Line>
<Line Number="26">
<![CDATA[				MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].diPlsAccum := MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].diPlsAccum + MRG414_diCollDeltaEncCnt;]]>
</Line>
<Line Number="27">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="28">
<![CDATA[			]]>
</Line>
<Line Number="29">
<![CDATA[			// Zero tracking PE counters when blocked]]>
</Line>
<Line Number="30">
<![CDATA[			IF MRG414_astCollPe[MRG414_diCollCalPeIndex].xIsBlocked AND NOT(MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].xIsBlockedPrev) THEN]]>
</Line>
<Line Number="31">
<![CDATA[				MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].diPlsAccum := 0;]]>
</Line>
<Line Number="32">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="33">
<![CDATA[			MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].xIsBlockedPrev := MRG414_astCollPe[MRG414_diCollCalPeIndex].xIsBlocked;]]>
</Line>
<Line Number="34">
<![CDATA[		]]>
</Line>
<Line Number="35">
<![CDATA[		// Last PE on collector blocked, grab running counters]]>
</Line>
<Line Number="36">
<![CDATA[		ELSIF MRG414_astCollPe[MRG414_stCollTrkSysCfg.diNumPE].xIsBlocked THEN]]>
</Line>
<Line Number="37">
<![CDATA[			FOR MRG414_diCollCalPeIndex := 1 TO (MRG414_stCollTrkSysCfg.diNumPE - 1) DO]]>
</Line>
<Line Number="38">
<![CDATA[				MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].diPlsCntSave := MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].diPlsAccum;]]>
</Line>
<Line Number="39">
<![CDATA[				MRG414_xCollTrackPE_OffsetCaptureArm := FALSE;]]>
</Line>
<Line Number="40">
<![CDATA[			END_FOR;]]>
</Line>
<Line Number="41">
<![CDATA[			]]>
</Line>
<Line Number="42">
<![CDATA[			EXIT;]]>
</Line>
<Line Number="43">
<![CDATA[			]]>
</Line>
<Line Number="44">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="45">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="46">
<![CDATA[	]]>
</Line>
<Line Number="47">
<![CDATA[END_IF;]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[IF MRG414_xCollPeCalReset THEN]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[	FOR MRG414_diCollCalPeIndex := 1 TO (MRG414_stCollTrkSysCfg.diNumPE) DO]]>
</Line>
<Line Number="52">
<![CDATA[		MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].diPlsCntSave :=  0;]]>
</Line>
<Line Number="53">
<![CDATA[		MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].diPlsAccum := 0;]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[		MRG414_astCollPeTrackCal[MRG414_diCollCalPeIndex].xCntInProgress := MRG414_c_xFALSE;]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[		MRG414_xCollPeCalReset := MRG414_c_xFALSE;]]>
</Line>
<Line Number="58">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[END_IF;]]>
</Line>
<Line Number="61">
<![CDATA[	]]>
</Line>
</STContent>
</Routine>
<Routine Name="RT_CollResetCounts" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © 2020 Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact MHS Holdings, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[//////////////////////////]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[// Reset the Counts for the Reservation Manager]]>
</Line>
<Line Number="13">
<![CDATA[//]]>
</Line>
<Line Number="14">
<![CDATA[//////////////////////////]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[FOR MRG414_diLanecntsResetIdx := 1 TO MRG414_stCollTrkSysCfg.diNumLanes DO]]>
</Line>
<Line Number="17">
<![CDATA[	COP(MRG414_stLaneClctrSlotResvcnt_CLR, MRG414_astLaneClctrSlotResCnts[MRG414_diLanecntsResetIdx], 1);]]>
</Line>
<Line Number="18">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[///////// END OF ROUTINE ////////]]>
</Line>
</STContent>
</Routine>
<Routine Name="RT_CollTrackHist" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[////////////////////////////////////////////////]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[// Collector Tracking Histogram]]>
</Line>
<Line Number="13">
<![CDATA[//]]>
</Line>
<Line Number="14">
<![CDATA[//	For each Lane and corresponding Collector Tracking PE]]>
</Line>
<Line Number="15">
<![CDATA[//	Determine how far ahead or behind the closest Tracking slot is to the Pe lead edge]]>
</Line>
<Line Number="16">
<![CDATA[//	The closest Tracking slot must match the lane associatted with the PE]]>
</Line>
<Line Number="17">
<![CDATA[//]]>
</Line>
<Line Number="18">
<![CDATA[////////////////////////////////////////////////]]>
</Line>
<Line Number="19">
<![CDATA[IF MRG414_xResetCollHistogram THEN]]>
</Line>
<Line Number="20">
<![CDATA[	MRG414_xResetCollHistogram  := MRG414_c_xFALSE;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[	FOR MRG414_diCollHistPeIndex := 1 TO (MRG414_stCollTrkSysCfg.diNumPE) DO]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[		COP(MRG414_stCollHistTmpZero, MRG414_astCollHist[MRG414_diCollHistPeIndex], 1);]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="27">
<![CDATA[END_IF;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[//]]>
</Line>
<Line Number="30">
<![CDATA[FOR MRG414_diCollHistPeIndex := 1 TO (MRG414_stCollTrkSysCfg.diNumPE) DO]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[	// Retreive the histogram]]>
</Line>
<Line Number="33">
<![CDATA[	COP(MRG414_astCollHist[MRG414_diCollHistPeIndex], MRG414_stCollHistTmp, 1);]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[	// get the location of the PE in the Collector Tracking Array]]>
</Line>
<Line Number="36">
<![CDATA[	MRG414_diCollHistPeLocation := MRG414_astCollPeCfg[MRG414_diCollHistPeIndex].diPlsLocation;]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[	// Sanity check that do not go over array bounds]]>
</Line>
<Line Number="39">
<![CDATA[	IF (MRG414_diCollHistPeLocation >= 20) AND (MRG414_diCollHistPeLocation < (MRG414_diCollTrkPkgArySize - 21)) THEN]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[		// get the state of the collector PE]]>
</Line>
<Line Number="42">
<![CDATA[		MRG414_stCollHistTmp.xPeState := ((MRG414_adiCollTrkArray[MRG414_diCollHistPeLocation] AND MRG414_astCollPeCfg[MRG414_diCollHistPeIndex].diValueTo_OR) > 0);]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[		// Check if at Lead Edge]]>
</Line>
<Line Number="45">
<![CDATA[		IF MRG414_stCollHistTmp.xPeState ]]>
</Line>
<Line Number="46">
<![CDATA[		  AND NOT(MRG414_stCollHistTmp.xPeStatePrev)]]>
</Line>
<Line Number="47">
<![CDATA[		  THEN]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[			MRG414_stCollHistTmp.xCollHistMatchFnd := MRG414_c_xFALSE;]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[			// Lead edge of a parcel is at Collector Tracking PE]]>
</Line>
<Line Number="52">
<![CDATA[			// Check the Track Id at the Pe location]]>
</Line>
<Line Number="53">
<![CDATA[			MRG414_stCollHistTmp.diCollHistTrackId := MRG414_adiCollTrkArray[MRG414_diCollHistPeLocation] AND 16#0000FFFF;]]>
</Line>
<Line Number="54">
<![CDATA[		 		]]>
</Line>
<Line Number="55">
<![CDATA[			// Check for lead edge of TrackId lagging behind the PE break]]>
</Line>
<Line Number="56">
<![CDATA[			IF MRG414_stCollHistTmp.diCollHistTrackId = 0 THEN]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[				// Search upstream until find a non zero track ID]]>
</Line>
<Line Number="59">
<![CDATA[				// OR search count is greater than 20]]>
</Line>
<Line Number="60">
<![CDATA[				FOR MRG414_stCollHistTmp.diCollHistSrchCnt := 1 to 20 DO]]>
</Line>
<Line Number="61">
<![CDATA[			]]>
</Line>
<Line Number="62">
<![CDATA[					// find a non-zero and see if it matches the Lane Id for this PE]]>
</Line>
<Line Number="63">
<![CDATA[					MRG414_stCollHistTmp.diCollHistTrackId := MRG414_adiCollTrkArray[MRG414_diCollHistPeLocation + MRG414_stCollHistTmp.diCollHistSrchCnt] AND 16#0000FFFF;]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[					IF (MRG414_stCollHistTmp.diCollHistTrackId / MRG414_diLaneID_Mod) = MRG414_diCollHistPeIndex THEN]]>
</Line>
<Line Number="66">
<![CDATA[]]>
</Line>
<Line Number="67">
<![CDATA[						MRG414_stCollHistTmp.xCollHistMatchFnd := MRG414_c_xTRUE; ]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[]]>
</Line>
<Line Number="70">
<![CDATA[						// End of search so exit the loop]]>
</Line>
<Line Number="71">
<![CDATA[						EXIT;]]>
</Line>
<Line Number="72">
<![CDATA[					 END_IF;]]>
</Line>
<Line Number="73">
<![CDATA[				END_FOR;]]>
</Line>
<Line Number="74">
<![CDATA[]]>
</Line>
<Line Number="75">
<![CDATA[			// Check for lead edge of TrackId is ahead of the PE break]]>
</Line>
<Line Number="76">
<![CDATA[			ELSIF ((MRG414_stCollHistTmp.diCollHistTrackId / MRG414_diLaneID_Mod) = MRG414_diCollHistPeIndex)  THEN]]>
</Line>
<Line Number="77">
<![CDATA[]]>
</Line>
<Line Number="78">
<![CDATA[				// Search Downstream counting Slots until find a slot where the track is not equal to this Lane or PE_ID]]>
</Line>
<Line Number="79">
<![CDATA[]]>
</Line>
<Line Number="80">
<![CDATA[				FOR MRG414_stCollHistTmp.diCollHistSrchCnt := -1 to - 20 BY -1 DO]]>
</Line>
<Line Number="81">
<![CDATA[			]]>
</Line>
<Line Number="82">
<![CDATA[					// find a non-zero and see if it matches the Lane Id for this PE]]>
</Line>
<Line Number="83">
<![CDATA[					MRG414_stCollHistTmp.diCollHistTrackId := MRG414_adiCollTrkArray[MRG414_diCollHistPeLocation + MRG414_stCollHistTmp.diCollHistSrchCnt] AND 16#0000FFFF;]]>
</Line>
<Line Number="84">
<![CDATA[]]>
</Line>
<Line Number="85">
<![CDATA[					IF (MRG414_stCollHistTmp.diCollHistTrackId / MRG414_diLaneID_Mod) <> MRG414_diCollHistPeIndex THEN]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[						// Found no longer matching, so record the Search Count which is the difference between actual and tracked lead edge]]>
</Line>
<Line Number="88">
<![CDATA[]]>
</Line>
<Line Number="89">
<![CDATA[						// Subtract the search count from 20 for the histogram]]>
</Line>
<Line Number="90">
<![CDATA[						MRG414_stCollHistTmp.diCollHistSrchIdx := 20 + MRG414_stCollHistTmp.diCollHistSrchCnt;]]>
</Line>
<Line Number="91">
<![CDATA[					]]>
</Line>
<Line Number="92">
<![CDATA[						// Sanity check]]>
</Line>
<Line Number="93">
<![CDATA[						IF MRG414_stCollHistTmp.diCollHistSrchIdx < 0 THEN]]>
</Line>
<Line Number="94">
<![CDATA[							MRG414_stCollHistTmp.diCollHistSrchIdx := 0;]]>
</Line>
<Line Number="95">
<![CDATA[						ELSIF MRG414_stCollHistTmp.diCollHistSrchIdx > 40 THEN]]>
</Line>
<Line Number="96">
<![CDATA[							MRG414_stCollHistTmp.diCollHistSrchIdx := 40;]]>
</Line>
<Line Number="97">
<![CDATA[						END_IF;]]>
</Line>
<Line Number="98">
<![CDATA[]]>
</Line>
<Line Number="99">
<![CDATA[						// Update the Histogram]]>
</Line>
<Line Number="100">
<![CDATA[						MRG414_stCollHistTmp.Histogram[MRG414_stCollHistTmp.diCollHistSrchIdx] := MRG414_stCollHistTmp.Histogram[MRG414_stCollHistTmp.diCollHistSrchIdx] + 1;]]>
</Line>
<Line Number="101">
<![CDATA[]]>
</Line>
<Line Number="102">
<![CDATA[						// Calculate the average]]>
</Line>
<Line Number="103">
<![CDATA[						MRG414_stCollHistTmp.diHistSampleCnt := MRG414_stCollHistTmp.diHistSampleCnt + 1;]]>
</Line>
<Line Number="104">
<![CDATA[						MRG414_stCollHistTmp.diHistSum := MRG414_stCollHistTmp.diHistSum + MRG414_stCollHistTmp.diCollHistSrchCnt;]]>
</Line>
<Line Number="105">
<![CDATA[						MRG414_stCollHistTmp.rHistAvg := MRG414_stCollHistTmp.diHistSum / MRG414_stCollHistTmp.diHistSampleCnt;]]>
</Line>
<Line Number="106">
<![CDATA[]]>
</Line>
<Line Number="107">
<![CDATA[						// End of search so exit the loop]]>
</Line>
<Line Number="108">
<![CDATA[						EXIT;]]>
</Line>
<Line Number="109">
<![CDATA[]]>
</Line>
<Line Number="110">
<![CDATA[					 END_IF;]]>
</Line>
<Line Number="111">
<![CDATA[				END_FOR;]]>
</Line>
<Line Number="112">
<![CDATA[	  		]]>
</Line>
<Line Number="113">
<![CDATA[			// Check for lead edge of TrackId is behind the PE break]]>
</Line>
<Line Number="114">
<![CDATA[			ELSE ]]>
</Line>
<Line Number="115">
<![CDATA[]]>
</Line>
<Line Number="116">
<![CDATA[				// Lane Id in the Track Id is not equal to the cfg Lane Id]]>
</Line>
<Line Number="117">
<![CDATA[				// Search upstream for a matching Lane Id or Lane Id changes]]>
</Line>
<Line Number="118">
<![CDATA[			]]>
</Line>
<Line Number="119">
<![CDATA[				MRG414_stCollHistTmp.diCollHistTrackIdInit := MRG414_stCollHistTmp.diCollHistTrackId;]]>
</Line>
<Line Number="120">
<![CDATA[]]>
</Line>
<Line Number="121">
<![CDATA[				FOR MRG414_stCollHistTmp.diCollHistSrchCnt := 1 to 20 DO]]>
</Line>
<Line Number="122">
<![CDATA[			]]>
</Line>
<Line Number="123">
<![CDATA[					// find a a change Lane Id or one that matches the Lane Id for this PE]]>
</Line>
<Line Number="124">
<![CDATA[					MRG414_stCollHistTmp.diCollHistTrackId := MRG414_adiCollTrkArray[MRG414_diCollHistPeLocation + MRG414_stCollHistTmp.diCollHistSrchCnt] AND 16#0000FFFF;]]>
</Line>
<Line Number="125">
<![CDATA[]]>
</Line>
<Line Number="126">
<![CDATA[					IF (MRG414_stCollHistTmp.diCollHistTrackId / MRG414_diLaneID_Mod) = MRG414_diCollHistPeIndex THEN]]>
</Line>
<Line Number="127">
<![CDATA[]]>
</Line>
<Line Number="128">
<![CDATA[						// Add 20 to the search count for the histogram]]>
</Line>
<Line Number="129">
<![CDATA[						MRG414_stCollHistTmp.diCollHistSrchIdx := 20 + MRG414_stCollHistTmp.diCollHistSrchCnt;]]>
</Line>
<Line Number="130">
<![CDATA[					]]>
</Line>
<Line Number="131">
<![CDATA[						// Sanity check]]>
</Line>
<Line Number="132">
<![CDATA[						IF MRG414_stCollHistTmp.diCollHistSrchIdx < 0 THEN]]>
</Line>
<Line Number="133">
<![CDATA[							MRG414_stCollHistTmp.diCollHistSrchIdx := 0;]]>
</Line>
<Line Number="134">
<![CDATA[						ELSIF MRG414_stCollHistTmp.diCollHistSrchIdx > 40 THEN]]>
</Line>
<Line Number="135">
<![CDATA[							MRG414_stCollHistTmp.diCollHistSrchIdx := 40;]]>
</Line>
<Line Number="136">
<![CDATA[						END_IF;]]>
</Line>
<Line Number="137">
<![CDATA[]]>
</Line>
<Line Number="138">
<![CDATA[						// Update the Histogram]]>
</Line>
<Line Number="139">
<![CDATA[						MRG414_stCollHistTmp.Histogram[MRG414_stCollHistTmp.diCollHistSrchIdx] := MRG414_stCollHistTmp.Histogram[MRG414_stCollHistTmp.diCollHistSrchIdx] + 1;]]>
</Line>
<Line Number="140">
<![CDATA[]]>
</Line>
<Line Number="141">
<![CDATA[						// Calculate the average]]>
</Line>
<Line Number="142">
<![CDATA[						MRG414_stCollHistTmp.diHistSampleCnt := MRG414_stCollHistTmp.diHistSampleCnt + 1;]]>
</Line>
<Line Number="143">
<![CDATA[						MRG414_stCollHistTmp.diHistSum := MRG414_stCollHistTmp.diHistSum + MRG414_stCollHistTmp.diCollHistSrchCnt;]]>
</Line>
<Line Number="144">
<![CDATA[						MRG414_stCollHistTmp.rHistAvg := MRG414_stCollHistTmp.diHistSum / MRG414_stCollHistTmp.diHistSampleCnt;]]>
</Line>
<Line Number="145">
<![CDATA[]]>
</Line>
<Line Number="146">
<![CDATA[						// End of search so exit the loop]]>
</Line>
<Line Number="147">
<![CDATA[						EXIT;]]>
</Line>
<Line Number="148">
<![CDATA[]]>
</Line>
<Line Number="149">
<![CDATA[					// Check if Track Id has changed]]>
</Line>
<Line Number="150">
<![CDATA[					ELSIF MRG414_stCollHistTmp.diCollHistTrackId <>  MRG414_stCollHistTmp.diCollHistTrackIdInit THEN]]>
</Line>
<Line Number="151">
<![CDATA[]]>
</Line>
<Line Number="152">
<![CDATA[						// Changed and not equal to the PE Index so exit]]>
</Line>
<Line Number="153">
<![CDATA[						EXIT;]]>
</Line>
<Line Number="154">
<![CDATA[]]>
</Line>
<Line Number="155">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="156">
<![CDATA[]]>
</Line>
<Line Number="157">
<![CDATA[				END_FOR;]]>
</Line>
<Line Number="158">
<![CDATA[		]]>
</Line>
<Line Number="159">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="160">
<![CDATA[]]>
</Line>
<Line Number="161">
<![CDATA[			IF MRG414_stCollHistTmp.xCollHistMatchFnd THEN]]>
</Line>
<Line Number="162">
<![CDATA[		]]>
</Line>
<Line Number="163">
<![CDATA[				// Found a match, so record the Search Count which is the difference between actual and tracked lead edge]]>
</Line>
<Line Number="164">
<![CDATA[]]>
</Line>
<Line Number="165">
<![CDATA[				// Add 20 to the search count for the histogram]]>
</Line>
<Line Number="166">
<![CDATA[				MRG414_stCollHistTmp.diCollHistSrchIdx := 20 + MRG414_stCollHistTmp.diCollHistSrchCnt;]]>
</Line>
<Line Number="167">
<![CDATA[			]]>
</Line>
<Line Number="168">
<![CDATA[				// Sanity check]]>
</Line>
<Line Number="169">
<![CDATA[				IF MRG414_stCollHistTmp.diCollHistSrchIdx < 0 THEN]]>
</Line>
<Line Number="170">
<![CDATA[					MRG414_stCollHistTmp.diCollHistSrchIdx := 0;]]>
</Line>
<Line Number="171">
<![CDATA[				ELSIF MRG414_stCollHistTmp.diCollHistSrchIdx > 40 THEN]]>
</Line>
<Line Number="172">
<![CDATA[					MRG414_stCollHistTmp.diCollHistSrchIdx := 40;]]>
</Line>
<Line Number="173">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="174">
<![CDATA[]]>
</Line>
<Line Number="175">
<![CDATA[				// Update the Histogram]]>
</Line>
<Line Number="176">
<![CDATA[				MRG414_stCollHistTmp.Histogram[MRG414_stCollHistTmp.diCollHistSrchIdx] := MRG414_stCollHistTmp.Histogram[MRG414_stCollHistTmp.diCollHistSrchIdx] + 1;]]>
</Line>
<Line Number="177">
<![CDATA[]]>
</Line>
<Line Number="178">
<![CDATA[				// Calculate the average]]>
</Line>
<Line Number="179">
<![CDATA[				MRG414_stCollHistTmp.diHistSampleCnt := MRG414_stCollHistTmp.diHistSampleCnt + 1;]]>
</Line>
<Line Number="180">
<![CDATA[				MRG414_stCollHistTmp.diHistSum := MRG414_stCollHistTmp.diHistSum + MRG414_stCollHistTmp.diCollHistSrchCnt;]]>
</Line>
<Line Number="181">
<![CDATA[				MRG414_stCollHistTmp.rHistAvg := MRG414_stCollHistTmp.diHistSum / MRG414_stCollHistTmp.diHistSampleCnt;]]>
</Line>
<Line Number="182">
<![CDATA[		]]>
</Line>
<Line Number="183">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="184">
<![CDATA[]]>
</Line>
<Line Number="185">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="186">
<![CDATA[]]>
</Line>
<Line Number="187">
<![CDATA[	ELSE]]>
</Line>
<Line Number="188">
<![CDATA[		// Increment the out of bounds count]]>
</Line>
<Line Number="189">
<![CDATA[		MRG414_diCollHistArrayErrCnt := MRG414_diCollHistArrayErrCnt + 1;]]>
</Line>
<Line Number="190">
<![CDATA[]]>
</Line>
<Line Number="191">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="192">
<![CDATA[	// update state of PE]]>
</Line>
<Line Number="193">
<![CDATA[	MRG414_stCollHistTmp.xPeStatePrev := MRG414_stCollHistTmp.xPeState;]]>
</Line>
<Line Number="194">
<![CDATA[]]>
</Line>
<Line Number="195">
<![CDATA[	// Store the histogram]]>
</Line>
<Line Number="196">
<![CDATA[	COP(MRG414_stCollHistTmp, MRG414_astCollHist[MRG414_diCollHistPeIndex], 1 );]]>
</Line>
<Line Number="197">
<![CDATA[]]>
</Line>
<Line Number="198">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="199">
<![CDATA[]]>
</Line>
<Line Number="200">
<![CDATA[]]>
</Line>
<Line Number="201">
<![CDATA[// ***** End of Routine ********]]>
</Line>
<Line Number="202">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="RT_CollTrackInit" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[///////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="1">
<![CDATA[//]]>
</Line>
<Line Number="2">
<![CDATA[//	Set the configuration items associatted with the Collector Tracking]]>
</Line>
<Line Number="3">
<![CDATA[//]]>
</Line>
<Line Number="4">
<![CDATA[/////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[//Constants]]>
</Line>
<Line Number="7">
<![CDATA[#region Constants]]>
</Line>
<Line Number="8">
<![CDATA[MRG414_c_xTRUE := 1; //DO NOT CHANGE]]>
</Line>
<Line Number="9">
<![CDATA[MRG414_c_xFALSE := 0; //DO NOT CHANGE]]>
</Line>
<Line Number="10">
<![CDATA[MRG414_diLaneID_Mod := 100; //DO NOT CHANGE]]>
</Line>
<Line Number="11">
<![CDATA[MRG414_diLanePkgSeqId_Max := 99; //DO NOT CHANGE]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[1] 		:= 16#0000_0ffc;  // Bits .2 through Bit .11 (11 is the max lane number)]]>
</Line>
<Line Number="14">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[2] 		:= 16#0000_0ff8;  // Bits .3 through Bit .11]]>
</Line>
<Line Number="15">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[3] 		:= 16#0000_0ff0;  // Bits .4 through Bit .11]]>
</Line>
<Line Number="16">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[4] 		:= 16#0000_0fe0;  // Bits .5 through Bit .11]]>
</Line>
<Line Number="17">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[5] 		:= 16#0000_0fC0;  // Bits .6 through Bit .11]]>
</Line>
<Line Number="18">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[6] 		:= 16#0000_0f80;  // Bits .7 through Bit .11]]>
</Line>
<Line Number="19">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[7] 		:= 16#0000_0f00;  // Bits .8 through Bit .11]]>
</Line>
<Line Number="20">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[8] 		:= 16#0000_0e00;  // Bits .9 through Bit .11]]>
</Line>
<Line Number="21">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[9] 		:= 16#0000_0c00;  // Bits .10 through Bit .11]]>
</Line>
<Line Number="22">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[10] 		:= 16#0000_0800;  // Only Bit .11]]>
</Line>
<Line Number="23">
<![CDATA[MRG414_stCollTrkSysCfg.adiLaneCompareMask[11] 		:= 16#0000_0000;  // No Bits]]>
</Line>
<Line Number="24">
<![CDATA[#endregion]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[// Turn off the Historize funtion]]>
</Line>
<Line Number="27">
<![CDATA[MRG414_xLaneClctrTrkHistorize := MRG414_c_xFALSE;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[// Lane Reservation Optimization functionality]]>
</Line>
<Line Number="30">
<![CDATA[MRG414_stCollTrkSysCfg.xCollOptimizeSearch 			:= 0; // Default = 0 //Optimize space reservation on collector for slugs]]>
</Line>
<Line Number="31">
<![CDATA[MRG414_stCollTrkSysCfg.diCollLaneEmptyOptPreset 	:= 2; // Not used]]>
</Line>
<Line Number="32">
<![CDATA[MRG414_stCollTrkSysCfg.diNumLanes					:= 5; // *** Max 11 lanes with current UDT structure]]>
</Line>
<Line Number="33">
<![CDATA[MRG414_stCollTrkSysCfg.xChkForCompromisedSlot		:= 0;  // Default = 0]]>
</Line>
<Line Number="34">
<![CDATA[MRG414_stCollTrkSysCfg.rClctrPsuedoEnc_IPP 	    	:= 1.0; // Tracking resolution on collector belt = inches per pulse]]>
</Line>
<Line Number="35">
<![CDATA[MRG414_stCollTrkSysCfg.rClctrRealEnc_IPP			:= 1.0; // Not used]]>
</Line>
<Line Number="36">
<![CDATA[MRG414_stCollTrkSysCfg.rSlotReserveMultiple 		:= 1.0; // Default = 1]]>
</Line>
<Line Number="37">
<![CDATA[MRG414_stCollTrkSysCfg.diPsuedoEncMaxCnt			:= 99999;]]>
</Line>
<Line Number="38">
<![CDATA[/////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="39">
<![CDATA[// Example to calculate the size of the Collector Tracking Array Size]]>
</Line>
<Line Number="40">
<![CDATA[// 940 inches from Lane 1 Location to the last PE on Collector]]>
</Line>
<Line Number="41">
<![CDATA[// Extend Tracking array, so at twice as long as measured]]>
</Line>
<Line Number="42">
<![CDATA[// 940 * 2 = 1880]]>
</Line>
<Line Number="43">
<![CDATA[// Psuedo encoder resolution of 2.0 inches]]>
</Line>
<Line Number="44">
<![CDATA[// 1880 / 2 = 940]]>
</Line>
<Line Number="45">
<![CDATA[// Add 100 pulses downstream of last PE]]>
</Line>
<Line Number="46">
<![CDATA[// 940 + 100 = 1040]]>
</Line>
<Line Number="47">
<![CDATA[// Round up to 1200 Element array]]>
</Line>
<Line Number="48">
<![CDATA[/////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[#region Config PEs on collector belt ]]>
</Line>
<Line Number="51">
<![CDATA[// Collector Tracking Array starts at the Discharge End, ]]>
</Line>
<Line Number="52">
<![CDATA[// Furthest Downstream PE and goes upstream]]>
</Line>
<Line Number="53">
<![CDATA[MRG414_stCollTrkSysCfg.diNumPE := MRG414_stCollTrkSysCfg.diNumLanes + 1;//Max = 12 // Number of Merge PEs on the collector belt (including end of line Exit PE) = (Number of Merge PEs on lanes) + (Collector Belt Exit PE) ]]>
</Line>
<Line Number="54">
<![CDATA[// NOTE: PE Index zero is not used]]>
</Line>
<Line Number="55">
<![CDATA[]]>
</Line>
<Line Number="56">
<![CDATA[diCollPeTrackExitLocation := 101; // Shifted Collector tracking by 100 pulses 1->101 to use with RT_CollLaneMergeCapture]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[// PE #12 on the Collector]]>
</Line>
<Line Number="59">
<![CDATA[MRG414_astCollPeCfg[12].diPlsLocation 	:= MRG414_astCollPeTrackCal[12].diPlsCntSave + diCollPeTrackExitLocation;  // Exit PE on the collector belt for a 11 lane setup]]>
</Line>
<Line Number="60">
<![CDATA[MRG414_astCollPeCfg[12].diValueTo_OR	:= 16#08000000;]]>
</Line>
<Line Number="61">
<![CDATA[MRG414_astCollPeCfg[12].diValueTo_AND	:= 16#0000FFFF;]]>
</Line>
<Line Number="62">
<![CDATA[MRG414_astCollPeCfg[12].diBlockedJamPre := 60;  // Pulses]]>
</Line>
<Line Number="63">
<![CDATA[//M422_SawMerge_HMI.Lane[12].LaneOffset	:= MRG422_astLanePeTrackCal[12].diPlsCntSave + diCollPeTrackExitLocation + M422_SawMerge_HMI.Lane[12].LaneOffsetCorr;]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[// PE #11 on the Collector]]>
</Line>
<Line Number="66">
<![CDATA[MRG414_astCollPeCfg[11].diPlsLocation 	:= MRG414_astCollPeTrackCal[11].diPlsCntSave + diCollPeTrackExitLocation;]]>
</Line>
<Line Number="67">
<![CDATA[MRG414_astCollPeCfg[11].diValueTo_OR	:= 16#04000000;]]>
</Line>
<Line Number="68">
<![CDATA[MRG414_astCollPeCfg[11].diValueTo_AND	:= 16#0000FFFF;]]>
</Line>
<Line Number="69">
<![CDATA[MRG414_astCollPeCfg[11].diBlockedJamPre := 60;  // Pulses]]>
</Line>
<Line Number="70">
<![CDATA[P414_SawMerge_HMI.Lane[11].LaneOffset	:= MRG414_astLanePeTrackCal[11].diPlsCntSave + diCollPeTrackExitLocation + P414_SawMerge_HMI.Lane[11].LaneOffsetCorr;]]>
</Line>
<Line Number="71">
<![CDATA[]]>
</Line>
<Line Number="72">
<![CDATA[// PE #10 on the Collector]]>
</Line>
<Line Number="73">
<![CDATA[MRG414_astCollPeCfg[10].diPlsLocation 	:= MRG414_astCollPeTrackCal[10].diPlsCntSave + diCollPeTrackExitLocation;]]>
</Line>
<Line Number="74">
<![CDATA[MRG414_astCollPeCfg[10].diValueTo_OR	:= 16#02000000;]]>
</Line>
<Line Number="75">
<![CDATA[MRG414_astCollPeCfg[10].diValueTo_AND	:= 16#0000FFFF;]]>
</Line>
<Line Number="76">
<![CDATA[MRG414_astCollPeCfg[10].diBlockedJamPre := 60;  // Pulses]]>
</Line>
<Line Number="77">
<![CDATA[P414_SawMerge_HMI.Lane[10].LaneOffset	:= MRG414_astLanePeTrackCal[10].diPlsCntSave + diCollPeTrackExitLocation + P414_SawMerge_HMI.Lane[10].LaneOffsetCorr;]]>
</Line>
<Line Number="78">
<![CDATA[]]>
</Line>
<Line Number="79">
<![CDATA[// PE #9 on the Collector]]>
</Line>
<Line Number="80">
<![CDATA[MRG414_astCollPeCfg[9].diPlsLocation 	:= MRG414_astCollPeTrackCal[9].diPlsCntSave + diCollPeTrackExitLocation;; ]]>
</Line>
<Line Number="81">
<![CDATA[MRG414_astCollPeCfg[9].diValueTo_OR	    := 16#01000000;]]>
</Line>
<Line Number="82">
<![CDATA[MRG414_astCollPeCfg[9].diValueTo_AND	:= 16#0000FFFF;]]>
</Line>
<Line Number="83">
<![CDATA[MRG414_astCollPeCfg[9].diBlockedJamPre	:= 60;  // Pulses]]>
</Line>
<Line Number="84">
<![CDATA[P414_SawMerge_HMI.Lane[9].LaneOffset	:= MRG414_astLanePeTrackCal[9].diPlsCntSave + diCollPeTrackExitLocation + P414_SawMerge_HMI.Lane[9].LaneOffsetCorr;]]>
</Line>
<Line Number="85">
<![CDATA[]]>
</Line>
<Line Number="86">
<![CDATA[// PE #8 on the Collector]]>
</Line>
<Line Number="87">
<![CDATA[MRG414_astCollPeCfg[8].diPlsLocation 	:= MRG414_astCollPeTrackCal[8].diPlsCntSave + diCollPeTrackExitLocation;;  ]]>
</Line>
<Line Number="88">
<![CDATA[MRG414_astCollPeCfg[8].diValueTo_OR	   	:= 16#00800000;]]>
</Line>
<Line Number="89">
<![CDATA[MRG414_astCollPeCfg[8].diValueTo_AND	:= 16#0000FFFF;]]>
</Line>
<Line Number="90">
<![CDATA[MRG414_astCollPeCfg[8].diBlockedJamPre	:= 60;  // Pulses]]>
</Line>
<Line Number="91">
<![CDATA[P414_SawMerge_HMI.Lane[8].LaneOffset	:= MRG414_astLanePeTrackCal[8].diPlsCntSave + diCollPeTrackExitLocation + P414_SawMerge_HMI.Lane[8].LaneOffsetCorr;]]>
</Line>
<Line Number="92">
<![CDATA[]]>
</Line>
<Line Number="93">
<![CDATA[// PE #7 on the Collector]]>
</Line>
<Line Number="94">
<![CDATA[MRG414_astCollPeCfg[7].diPlsLocation 	:= MRG414_astCollPeTrackCal[7].diPlsCntSave + diCollPeTrackExitLocation;;  ]]>
</Line>
<Line Number="95">
<![CDATA[MRG414_astCollPeCfg[7].diValueTo_OR		:= 16#00400000;]]>
</Line>
<Line Number="96">
<![CDATA[MRG414_astCollPeCfg[7].diValueTo_AND	:= 16#0000FFFF;]]>
</Line>
<Line Number="97">
<![CDATA[MRG414_astCollPeCfg[7].diBlockedJamPre	:= 60;  // Pulses]]>
</Line>
<Line Number="98">
<![CDATA[P414_SawMerge_HMI.Lane[7].LaneOffset	:= MRG414_astLanePeTrackCal[7].diPlsCntSave + diCollPeTrackExitLocation + P414_SawMerge_HMI.Lane[7].LaneOffsetCorr;]]>
</Line>
<Line Number="99">
<![CDATA[]]>
</Line>
<Line Number="100">
<![CDATA[// PE #6 on the Collector]]>
</Line>
<Line Number="101">
<![CDATA[MRG414_astCollPeCfg[6].diPlsLocation 	:= MRG414_astCollPeTrackCal[6].diPlsCntSave + diCollPeTrackExitLocation;;  ]]>
</Line>
<Line Number="102">
<![CDATA[MRG414_astCollPeCfg[6].diValueTo_OR		:= 16#00200000;]]>
</Line>
<Line Number="103">
<![CDATA[MRG414_astCollPeCfg[6].diValueTo_AND	:= 16#0000FFFF;]]>
</Line>
<Line Number="104">
<![CDATA[MRG414_astCollPeCfg[6].diBlockedJamPre	:= 60;  // Pulses]]>
</Line>
<Line Number="105">
<![CDATA[P414_SawMerge_HMI.Lane[6].LaneOffset	:= MRG414_astLanePeTrackCal[6].diPlsCntSave + diCollPeTrackExitLocation + P414_SawMerge_HMI.Lane[6].LaneOffsetCorr;]]>
</Line>
<Line Number="106">
<![CDATA[]]>
</Line>
<Line Number="107">
<![CDATA[// PE #5 on the Collector]]>
</Line>
<Line Number="108">
<![CDATA[MRG414_astCollPeCfg[5].diPlsLocation 	:=  MRG414_astCollPeTrackCal[5].diPlsCntSave + diCollPeTrackExitLocation; // Exit PE on the collector belt for this 4 lane setup]]>
</Line>
<Line Number="109">
<![CDATA[MRG414_astCollPeCfg[5].diValueTo_OR		:= 16#00100000;]]>
</Line>
<Line Number="110">
<![CDATA[MRG414_astCollPeCfg[5].diValueTo_AND	:= 16#0000FFFF;]]>
</Line>
<Line Number="111">
<![CDATA[MRG414_astCollPeCfg[5].diBlockedJamPre	:= 60;  // Pulses]]>
</Line>
<Line Number="112">
<![CDATA[P414_SawMerge_HMI.Lane[5].LaneOffset	:= MRG414_astLanePeTrackCal[5].diPlsCntSave + diCollPeTrackExitLocation + P414_SawMerge_HMI.Lane[5].LaneOffsetCorr;]]>
</Line>
<Line Number="113">
<![CDATA[]]>
</Line>
<Line Number="114">
<![CDATA[// PE #4 on the Collector]]>
</Line>
<Line Number="115">
<![CDATA[MRG414_astCollPeCfg[4].diPlsLocation 	:= MRG414_astCollPeTrackCal[4].diPlsCntSave + diCollPeTrackExitLocation;]]>
</Line>
<Line Number="116">
<![CDATA[MRG414_astCollPeCfg[4].diValueTo_AND	:= 16#0000FFFF;]]>
</Line>
<Line Number="117">
<![CDATA[MRG414_astCollPeCfg[4].diValueTo_OR		:= 16#00080000;]]>
</Line>
<Line Number="118">
<![CDATA[MRG414_astCollPeCfg[4].diBlockedJamPre	:= 60;  // Pulses]]>
</Line>
<Line Number="119">
<![CDATA[P414_SawMerge_HMI.Lane[4].LaneOffset	:= MRG414_astLanePeTrackCal[4].diPlsCntSave + diCollPeTrackExitLocation + P414_SawMerge_HMI.Lane[4].LaneOffsetCorr;]]>
</Line>
<Line Number="120">
<![CDATA[]]>
</Line>
<Line Number="121">
<![CDATA[// PE #3 on the Collector]]>
</Line>
<Line Number="122">
<![CDATA[MRG414_astCollPeCfg[3].diPlsLocation 	:= MRG414_astCollPeTrackCal[3].diPlsCntSave + diCollPeTrackExitLocation;]]>
</Line>
<Line Number="123">
