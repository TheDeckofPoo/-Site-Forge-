</Line>
<Line Number="278">
<![CDATA[MRG414_astUNL_SlugBldCfg[4].rStartupSlugLenInch			:= MRG414_astUNL_SlugBldCfg[4].rPT_StartupDistPre + MRG414_astUNL_SlugBldCfg[4].rMRG_StartupDistPre;]]>
</Line>
<Line Number="279">
<![CDATA[#endregion]]>
</Line>
<Line Number="280">
<![CDATA[]]>
</Line>
<Line Number="281">
<![CDATA[#region TRAIN BUILDING Config  for Lane 5]]>
</Line>
<Line Number="282">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].diDoorID 					:= 5; // Building Identifier for the unload door]]>
</Line>
<Line Number="283">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rQ2_ReleaseSpeed_IPS 		:= P414_SawMerge_HMI.ClctrSpeed_FPM / 5.0; // FPM converted to inch per sec]]>
</Line>
<Line Number="284">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rQ1_MatchSpeed_IPS 			:= 225 / 5.0; // ]]>
</Line>
<Line Number="285">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rQ1_ReleaseSpeed_IPS 		:= 225 / 5.0; // ]]>
</Line>
<Line Number="286">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rGPR_MatchSpeed_IPS 		:= 225 / 5.0; // ]]>
</Line>
<Line Number="287">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].diGPR_End_Loc 				:= 1; // Track out position of gapper/Q1 shift array]]>
</Line>
<Line Number="288">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].diGPR_EntrPE_Loc 			:= 40;  // Start of shift array]]>
</Line>
<Line Number="289">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].diGPR_Eval_Loc 				:= 10;  // Position to check if box will fit into Q1 slug]]>
</Line>
<Line Number="290">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rQ1_ConveyorLength			:= 300; // Conveyor length in inches]]>
</Line>
<Line Number="291">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rQ1_MaxTrainLen 			:= 1000; // 285; // Max number of inches for Q1 train to accumulate on belt]]>
</Line>
<Line Number="292">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rQ1_MaxTrainReleaseLen  	:= MRG414_astUNL_SlugBldCfg[5].rQ1_MaxTrainLen + 100;]]>
</Line>
<Line Number="293">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rQ1_MaxTrainTrailingGap 	:= 12;]]>
</Line>
<Line Number="294">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rQ2_ConveyorLength			:= 300; // Conveyor length in inches]]>
</Line>
<Line Number="295">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rQ2_MaxTrainLen				:= 1000; // Max number of inches for Q2 train to accumulate on belt]]>
</Line>
<Line Number="296">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].xMaxTrainLen_EN 			:= 1; // Set to enable Q1 max train length detection logic]]>
</Line>
<Line Number="297">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rBFR_SpeedFollowRatio		:= 1.0; // Ratio of Gapper speed that Buffer conveyor follows with]]>
</Line>
<Line Number="298">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rBFR_ExitPeClearDist		:= 8.0; // Distance from Buffer exit PE to the downstream belt junction]]>
</Line>
<Line Number="299">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].diQ1_SafetyReleaseTimerPre 	:= 30000;  // Timer preset in milliseconds]]>
</Line>
<Line Number="300">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].diQ1_TrainStrandedTimerPre 	:= 90000; // Timer preset in milliseconds]]>
</Line>
<Line Number="301">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rPT_HoldReleaseSpeedDistPre := 0; // Power turn travel in inches to hold release speed after Q2 done releasing]]>
</Line>
<Line Number="302">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rPT_StartupDistPre 			:= 0.0; // Power turn conveyor travel in inhces, to clear packages at startup]]>
</Line>
<Line Number="303">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rMRG_StartupDistPre 		:= 104; // Merge conveyor travel in inhces, to clear packages at startup]]>
</Line>
<Line Number="304">
<![CDATA[MRG414_astUNL_SlugBldCfg[5].rStartupSlugLenInch			:= MRG414_astUNL_SlugBldCfg[5].rPT_StartupDistPre + MRG414_astUNL_SlugBldCfg[5].rMRG_StartupDistPre;]]>
</Line>
<Line Number="305">
<![CDATA[#endregion]]>
</Line>
</STContent>
</Routine>
<Routine Name="RT_CollTrackMain" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="1">
<![CDATA[//]]>
</Line>
<Line Number="2">
<![CDATA[//	Main Routine for Collecgtor Tracking]]>
</Line>
<Line Number="3">
<![CDATA[//  Manage utilities and order of routine calls from here.]]>
</Line>
<Line Number="4">
<![CDATA[//]]>
</Line>
<Line Number="5">
<![CDATA[/////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[// Configure the Collector Tracking on First Scan]]>
</Line>
<Line Number="8">
<![CDATA[IF (MRG414_xSystemDrivesConfigured AND NOT MRG414_xCollTrackConfigured) THEN]]>
</Line>
<Line Number="9">
<![CDATA[	MRG414_rCollPrev_IPS := 0.0;]]>
</Line>
<Line Number="10">
<![CDATA[	MRG414_rCollSpeed_IPS := 0.0;]]>
</Line>
<Line Number="11">
<![CDATA[	MRG414_rCollDeltaDist := 0.0;]]>
</Line>
<Line Number="12">
<![CDATA[	MRG414_rCollDeltaDist_Total := 0.0;]]>
</Line>
<Line Number="13">
<![CDATA[	MRG414_rCollDeltaEncPls := 0.0;]]>
</Line>
<Line Number="14">
<![CDATA[	MRG414_rCollDeltaEncPlsTrunc := 0.0;]]>
</Line>
<Line Number="15">
<![CDATA[	MRG414_rCollDeltaDistRemain := 0.0;]]>
</Line>
<Line Number="16">
<![CDATA[	MRG414_diCollEncCntPrev := MRG414_diCollEncCntCurr;]]>
</Line>
<Line Number="17">
<![CDATA[	MRG414_rCollPrev_IPS := MRG414_rCollSpeed_IPS;]]>
</Line>
<Line Number="18">
<![CDATA[	]]>
</Line>
<Line Number="19">
<![CDATA[	MRG414_xCollTrackConfigured := 0;]]>
</Line>
<Line Number="20">
<![CDATA[	MRG414_xCollResetTracking := 1;]]>
</Line>
<Line Number="21">
<![CDATA[	MRG414_diCollEncInconsistentCnt := 0;]]>
</Line>
<Line Number="22">
<![CDATA[	JSR(RT_CollTrackInit, 0);]]>
</Line>
<Line Number="23">
<![CDATA[	MRG414_xCollTrackConfigured := 1; ]]>
</Line>
<Line Number="24">
<![CDATA[END_IF;]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[// Check for a reset of the counts]]>
</Line>
<Line Number="27">
<![CDATA[IF (MRG414_xCollResetCounts) THEN]]>
</Line>
<Line Number="28">
<![CDATA[	JSR(RT_CollResetCounts, 0);]]>
</Line>
<Line Number="29">
<![CDATA[	MRG414_xCollResetCounts := 0;  ]]>
</Line>
<Line Number="30">
<![CDATA[END_IF;]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[// Check for a reset of all of the tracked package data]]>
</Line>
<Line Number="33">
<![CDATA[IF S:FS OR MRG414_xCollResetTracking THEN]]>
</Line>
<Line Number="34">
<![CDATA[	MRG414_diCollEncCntPrev := MRG414_diCollEncCntCurr;]]>
</Line>
<Line Number="35">
<![CDATA[	MRG414_xCollResetTracking := 0;]]>
</Line>
<Line Number="36">
<![CDATA[END_IF;]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[/////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="39">
<![CDATA[// Example to calculate the size of the Collector Tracking Array Size]]>
</Line>
<Line Number="40">
<![CDATA[// 940 inches from Lane 1 Location to the last PE on Collector]]>
</Line>
<Line Number="41">
<![CDATA[// Extend Tracking array, so at twice as long as measured]]>
</Line>
<Line Number="42">
<![CDATA[// 940 * 2 = 1880]]>
</Line>
<Line Number="43">
<![CDATA[// Psuedo encoder resolution of 2.0 inches]]>
</Line>
<Line Number="44">
<![CDATA[// 1880 / 2 = 940]]>
</Line>
<Line Number="45">
<![CDATA[// Add 100 pulses downstream of last PE]]>
</Line>
<Line Number="46">
<![CDATA[// 940 + 100 = 1040]]>
</Line>
<Line Number="47">
<![CDATA[// Round up to 1200 Element array]]>
</Line>
<Line Number="48">
<![CDATA[/////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="49">
<![CDATA[SIZE(MRG414_adiCollTrkArray[0], 0, MRG414_diCollTrkPkgArySize);]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[MRG414_diCollTrkPkgAryLastIdx := MRG414_diCollTrkPkgArySize - 1;]]>
</Line>
<Line Number="52">
<![CDATA[MRG414_diCollTrkPkgShiftSize := MRG414_diCollTrkPkgAryLastIdx;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[IF MRG414_xSystemDrivesConfigured THEN]]>
</Line>
<Line Number="55">
<![CDATA[]]>
</Line>
<Line Number="56">
<![CDATA[	// Determine how many pseudo encoder pulses from distance conveyor has traveled]]>
</Line>
<Line Number="57">
<![CDATA[	MRG414_rCollPrev_IPS  := MRG414_rCollSpeed_IPS; ]]>
</Line>
<Line Number="58">
<![CDATA[	MRG414_rCollSpeed_IPS := MRG414_rCollSpdFeedback_IPS; // VFD speed mapped in IO map routine]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[	AO_CnvDeltaDist(MRG414_aoColl_01_CnvDeltaDist]]>
</Line>
<Line Number="61">
<![CDATA[						,MRG414_rCollSpeed_IPS]]>
</Line>
<Line Number="62">
<![CDATA[						,MRG414_rCollPrev_IPS]]>
</Line>
<Line Number="63">
<![CDATA[						,MRG414_rFastTaskDeltaMilliSecs]]>
</Line>
<Line Number="64">
<![CDATA[						,MRG414_rCollDeltaDist]]>
</Line>
<Line Number="65">
<![CDATA[						);]]>
</Line>
<Line Number="66">
<![CDATA[	IF MRG414_rCollDeltaDist < 0.0 then]]>
</Line>
<Line Number="67">
<![CDATA[		MRG414_rCollDeltaDist := 0;]]>
</Line>
<Line Number="68">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="69">
<![CDATA[						]]>
</Line>
<Line Number="70">
<![CDATA[ELSE]]>
</Line>
<Line Number="71">
<![CDATA[	MRG414_rCollDeltaDist := 0;]]>
</Line>
<Line Number="72">
<![CDATA[END_IF;]]>
</Line>
<Line Number="73">
<![CDATA[]]>
</Line>
<Line Number="74">
<![CDATA[// Add inremainder from last scan]]>
</Line>
<Line Number="75">
<![CDATA[MRG414_rCollDeltaDist_Total  := MRG414_rCollDeltaDist + MRG414_rCollDeltaDistRemain ;]]>
</Line>
<Line Number="76">
<![CDATA[MRG414_rCollDeltaEncPls 	 := (MRG414_rCollDeltaDist_Total /  MRG414_stCollTrkSysCfg.rClctrPsuedoEnc_IPP);]]>
</Line>
<Line Number="77">
<![CDATA[MRG414_rCollDeltaEncPlsTrunc := TRUNC (MRG414_rCollDeltaEncPls);]]>
</Line>
<Line Number="78">
<![CDATA[MRG414_rCollDeltaDistRemain  := MRG414_rCollDeltaDist_Total - (MRG414_rCollDeltaEncPlsTrunc * MRG414_stCollTrkSysCfg.rClctrPsuedoEnc_IPP);]]>
</Line>
<Line Number="79">
<![CDATA[]]>
</Line>
<Line Number="80">
<![CDATA[// Determine how many psuedo encoder pulse since last invocation (fortna) ]]>
</Line>
<Line Number="81">
<![CDATA[MRG414_diCollEncCntCurr := MRG414_diCollEncCntCurr + MRG414_rCollDeltaEncPlsTrunc;]]>
</Line>
<Line Number="82">
<![CDATA[]]>
</Line>
<Line Number="83">
<![CDATA[IF (MRG414_diCollEncCntCurr > MRG414_stCollTrkSysCfg.diPsuedoEncMaxCnt) THEN]]>
</Line>
<Line Number="84">
<![CDATA[	MRG414_diCollEncCntCurr := MRG414_diCollEncCntCurr - MRG414_stCollTrkSysCfg.diPsuedoEncMaxCnt;]]>
</Line>
<Line Number="85">
<![CDATA[END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[MRG414_diCollEncCntCopy := MRG414_diCollEncCntCurr;]]>
</Line>
<Line Number="88">
<![CDATA[MRG414_diCollDeltaEncCnt := (MRG414_diCollEncCntCopy - MRG414_diCollEncCntPrev);]]>
</Line>
<Line Number="89">
<![CDATA[IF (MRG414_diCollDeltaEncCnt < 0) THEN]]>
</Line>
<Line Number="90">
<![CDATA[	 MRG414_diCollDeltaEncCnt := MRG414_diCollDeltaEncCnt + MRG414_stCollTrkSysCfg.diPsuedoEncMaxCnt;]]>
</Line>
<Line Number="91">
<![CDATA[END_IF;]]>
</Line>
<Line Number="92">
<![CDATA[]]>
</Line>
<Line Number="93">
<![CDATA[// Debug data]]>
</Line>
<Line Number="94">
<![CDATA[IF MRG414_diCollDeltaEncCnt > MRG414_diCollDeltaEncCntMax THEN]]>
</Line>
<Line Number="95">
<![CDATA[	MRG414_diCollDeltaEncCntMax := MRG414_diCollDeltaEncCnt;]]>
</Line>
<Line Number="96">
<![CDATA[END_IF;]]>
</Line>
<Line Number="97">
<![CDATA[]]>
</Line>
<Line Number="98">
<![CDATA[// Check for delta inconsistencies]]>
</Line>
<Line Number="99">
<![CDATA[IF MRG414_diCollDeltaEncCnt > 10 THEN]]>
</Line>
<Line Number="100">
<![CDATA[	MRG414_diCollDeltaEncCnt := 10;]]>
</Line>
<Line Number="101">
<![CDATA[]]>
</Line>
<Line Number="102">
<![CDATA[	// Diagnostic - Record the number of times the encoder was inconsistent]]>
</Line>
<Line Number="103">
<![CDATA[	MRG414_diCollEncInconsistentCnt := MRG414_diCollEncInconsistentCnt + 1;]]>
</Line>
<Line Number="104">
<![CDATA[END_IF;]]>
</Line>
<Line Number="105">
<![CDATA[]]>
</Line>
<Line Number="106">
<![CDATA[MRG414_diCollEncCntPrev := MRG414_diCollEncCntCopy;]]>
</Line>
<Line Number="107">
<![CDATA[]]>
</Line>
<Line Number="108">
<![CDATA[]]>
</Line>
<Line Number="109">
<![CDATA[// ***********************************************************************]]>
</Line>
<Line Number="110">
<![CDATA[// If an encoder Pulse occurred then update tracking array]]>
</Line>
<Line Number="111">
<![CDATA[IF (MRG414_diCollDeltaEncCnt > 0) THEN]]>
</Line>
<Line Number="112">
<![CDATA[]]>
</Line>
<Line Number="113">
<![CDATA[	FOR MRG414_diCollEncShftIdx := 1 TO MRG414_diCollDeltaEncCnt DO]]>
</Line>
<Line Number="114">
<![CDATA[	]]>
</Line>
<Line Number="115">
<![CDATA[		// Shift the Track Array]]>
</Line>
<Line Number="116">
<![CDATA[		COP(MRG414_adiCollTrkArray[1], MRG414_adiCollTrkArray[0], MRG414_diCollTrkPkgShiftSize);]]>
</Line>
<Line Number="117">
<![CDATA[]]>
</Line>
<Line Number="118">
<![CDATA[		// Clear element to be shifted in]]>
</Line>
<Line Number="119">
<![CDATA[		MRG414_adiCollTrkArray[MRG414_diCollTrkPkgShiftSize] := 0;]]>
</Line>
<Line Number="120">
<![CDATA[]]>
</Line>
<Line Number="121">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="122">
<![CDATA[]]>
</Line>
<Line Number="123">
<![CDATA[	FOR MRG414_diClctrEncLane := 1 TO MRG414_stCollTrkSysCfg.diNumLanes DO  ]]>
</Line>
<Line Number="124">
<![CDATA[]]>
</Line>
<Line Number="125">
<![CDATA[		// Update each lanes's Slot Starting Location]]>
</Line>
<Line Number="126">
<![CDATA[		IF MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrEncLane].diSlotStartLoc > 0 THEN]]>
</Line>
<Line Number="127">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrEncLane].diSlotStartLoc := MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrEncLane].diSlotStartLoc - MRG414_diCollDeltaEncCnt;]]>
</Line>
<Line Number="128">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="129">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="130">
<![CDATA[]]>
</Line>
<Line Number="131">
<![CDATA[END_IF;]]>
</Line>
<Line Number="132">
<![CDATA[]]>
</Line>
<Line Number="133">
<![CDATA[// ********************************************************************************]]>
</Line>
<Line Number="134">
<![CDATA[]]>
</Line>
<Line Number="135">
<![CDATA[// Check if Photo-eyes are clear or blocked]]>
</Line>
<Line Number="136">
<![CDATA[// NOTE: PE Index zero is not used]]>
</Line>
<Line Number="137">
<![CDATA[// Only check PEs when get new encoder pulse ]]>
</Line>
<Line Number="138">
<![CDATA[IF (MRG414_diCollDeltaEncCnt > 0) THEN]]>
</Line>
<Line Number="139">
<![CDATA[]]>
</Line>
<Line Number="140">
<![CDATA[	FOR MRG414_diCollPeIndex := 1 TO MRG414_stCollTrkSysCfg.diNumPE DO]]>
</Line>
<Line Number="141">
<![CDATA[		// If the photo-eye is not by passed]]>
</Line>
<Line Number="142">
<![CDATA[		IF NOT(MRG414_astCollPe[MRG414_diCollPeIndex].xIsByPassed) THEN]]>
</Line>
<Line Number="143">
<![CDATA[			// get the location of the PE in the Collector Tracking Array]]>
</Line>
<Line Number="144">
<![CDATA[			MRG414_diCollPeLocation := MRG414_astCollPeCfg[MRG414_diCollPeIndex].diPlsLocation;]]>
</Line>
<Line Number="145">
<![CDATA[]]>
</Line>
<Line Number="146">
<![CDATA[			// Check if it is blocked]]>
</Line>
<Line Number="147">
<![CDATA[			IF MRG414_astCollPe[MRG414_diCollPeIndex].xIsBlocked THEN]]>
</Line>
<Line Number="148">
<![CDATA[]]>
</Line>
<Line Number="149">
<![CDATA[				IF (MRG414_diCollDeltaEncCnt > 0) THEN]]>
</Line>
<Line Number="150">
<![CDATA[					// update the blocked count]]>
</Line>
<Line Number="151">
<![CDATA[					MRG414_astCollPe[MRG414_diCollPeIndex].diBlockedCount := MRG414_astCollPe[MRG414_diCollPeIndex].diBlockedCount + MRG414_diCollDeltaEncCnt;]]>
</Line>
<Line Number="152">
<![CDATA[					// Reset the Clear Count]]>
</Line>
<Line Number="153">
<![CDATA[					MRG414_astCollPe[MRG414_diCollPeIndex].diClearCount := 0;]]>
</Line>
<Line Number="154">
<![CDATA[]]>
</Line>
<Line Number="155">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="156">
<![CDATA[]]>
</Line>
<Line Number="157">
<![CDATA[				// TBD -2014-08-12 May have to debounce the PE before updating the astCollTrkArray[]]]>
</Line>
<Line Number="158">
<![CDATA[				// Update the Collector Tracking array]]>
</Line>
<Line Number="159">
<![CDATA[				MRG414_adiCollTrkArray[MRG414_diCollPeLocation] := MRG414_adiCollTrkArray[MRG414_diCollPeLocation] OR MRG414_astCollPeCfg[MRG414_diCollPeIndex].diValueTo_OR;]]>
</Line>
<Line Number="160">
<![CDATA[]]>
</Line>
<Line Number="161">
<![CDATA[			ELSE]]>
</Line>
<Line Number="162">
<![CDATA[				// PE is clear]]>
</Line>
<Line Number="163">
<![CDATA[]]>
</Line>
<Line Number="164">
<![CDATA[				IF (MRG414_diCollDeltaEncCnt > 0) THEN]]>
</Line>
<Line Number="165">
<![CDATA[					// update the Clear count]]>
</Line>
<Line Number="166">
<![CDATA[					MRG414_astCollPe[MRG414_diCollPeIndex].diClearCount := MRG414_astCollPe[MRG414_diCollPeIndex].diClearCount + MRG414_diCollDeltaEncCnt;]]>
</Line>
<Line Number="167">
<![CDATA[					// Reset the Clear Count]]>
</Line>
<Line Number="168">
<![CDATA[					MRG414_astCollPe[MRG414_diCollPeIndex].diBlockedCount := 0;]]>
</Line>
<Line Number="169">
<![CDATA[]]>
</Line>
<Line Number="170">
<![CDATA[					// TBD -2014-08-12 May have to debounce the PE before updating the astCollTrkArray[]]]>
</Line>
<Line Number="171">
<![CDATA[					// Update the Collector Tracking array]]>
</Line>
<Line Number="172">
<![CDATA[					MRG414_adiCollTrkArray[MRG414_diCollPeLocation] := MRG414_adiCollTrkArray[MRG414_diCollPeLocation] AND MRG414_astCollPeCfg[MRG414_diCollPeIndex].diValueTo_AND;]]>
</Line>
<Line Number="173">
<![CDATA[]]>
</Line>
<Line Number="174">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="175">
<![CDATA[]]>
</Line>
<Line Number="176">
<![CDATA[			END_IF;	 ]]>
</Line>
<Line Number="177">
<![CDATA[	]]>
</Line>
<Line Number="178">
<![CDATA[		ELSE]]>
</Line>
<Line Number="179">
<![CDATA[			// PE is by passed so no Jam detection]]>
</Line>
<Line Number="180">
<![CDATA[			MRG414_astCollPe[MRG414_diCollPeIndex].diBlockedCount := 0;]]>
</Line>
<Line Number="181">
<![CDATA[			MRG414_astCollPe[MRG414_diCollPeIndex].diClearCount := 0;]]>
</Line>
<Line Number="182">
<![CDATA[			MRG414_astCollPe[MRG414_diCollPeIndex].xIsJammed := FALSE;]]>
</Line>
<Line Number="183">
<![CDATA[	]]>
</Line>
<Line Number="184">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="185">
<![CDATA[]]>
</Line>
<Line Number="186">
<![CDATA[		// Check for Jam]]>
</Line>
<Line Number="187">
<![CDATA[		IF MRG414_astCollPe[MRG414_diCollPeIndex].diBlockedCount >= MRG414_astCollPeCfg[MRG414_diCollPeIndex].diBlockedJamPre THEN]]>
</Line>
<Line Number="188">
<![CDATA[			 // Jammed]]>
</Line>
<Line Number="189">
<![CDATA[			 MRG414_astCollPe[MRG414_diCollPeIndex].xIsJammed := MRG414_c_xTRUE;]]>
</Line>
<Line Number="190">
<![CDATA[]]>
</Line>
<Line Number="191">
<![CDATA[			 // TBD 2014-08-12 Do we need a Jam Latch for HMI ??]]>
</Line>
<Line Number="192">
<![CDATA[]]>
</Line>
<Line Number="193">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="194">
<![CDATA[]]>
</Line>
<Line Number="195">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="196">
<![CDATA[END_IF;]]>
</Line>
<Line Number="197">
<![CDATA[]]>
</Line>
<Line Number="198">
<![CDATA[// TBD 2014-08-12 Do we need missing parcel Jam detection? If so, use Haller's algorithm]]>
</Line>
<Line Number="199">
<![CDATA[]]>
</Line>
<Line Number="200">
<![CDATA[// Debug Freeze the Track Array]]>
</Line>
<Line Number="201">
<![CDATA[IF MRG414_xLaneClctrTrkAryFreeze THEN]]>
</Line>
<Line Number="202">
<![CDATA[]]>
</Line>
<Line Number="203">
<![CDATA[	COP(MRG414_adiCollTrkArray[0], MRG414_adiCollTrkArray_Freeze[0], MRG414_diCollTrkPkgShiftSize);]]>
</Line>
<Line Number="204">
<![CDATA[	]]>
</Line>
<Line Number="205">
<![CDATA[	FOR MRG414_FreezeIdx1 := 1 TO MRG414_stCollTrkSysCfg.diNumLanes DO]]>
</Line>
<Line Number="206">
<![CDATA[		COP(MRG414_astLaneClctrSlotResvCntrl_Clr, MRG414_astLaneClctrSlotResvCntrl_Freeze[MRG414_FreezeIdx1],1); // Clear previous value]]>
</Line>
<Line Number="207">
<![CDATA[		COP(MRG414_astLaneClctrSlotResvCntrl[MRG414_FreezeIdx1], MRG414_astLaneClctrSlotResvCntrl_Freeze[MRG414_FreezeIdx1],1); // Record current value]]>
</Line>
<Line Number="208">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="209">
<![CDATA[]]>
</Line>
<Line Number="210">
<![CDATA[	// Reset the trigger]]>
</Line>
<Line Number="211">
<![CDATA[	MRG414_xLaneClctrTrkAryFreeze := MRG414_c_xFALSE;]]>
</Line>
<Line Number="212">
<![CDATA[END_IF;]]>
</Line>
<Line Number="213">
<![CDATA[]]>
</Line>
<Line Number="214">
<![CDATA[// 2015-01-22 Added routine for Collector Tracking Histogram]]>
</Line>
<Line Number="215">
<![CDATA[IF MRG414_xLaneClctrTrkHistorize THEN]]>
</Line>
<Line Number="216">
<![CDATA[	JSR(RT_CollTrackHist, 0);]]>
</Line>
<Line Number="217">
<![CDATA[END_IF;]]>
</Line>
<Line Number="218">
<![CDATA[]]>
</Line>
<Line Number="219">
<![CDATA[// Calibrate PEs on the Collector]]>
</Line>
<Line Number="220">
<![CDATA[IF MRG414_xLaneClctrPeCalibrate THEN]]>
</Line>
<Line Number="221">
<![CDATA[	JSR( RT_CollPeTrackCal, 0);]]>
</Line>
<Line Number="222">
<![CDATA[END_IF;]]>
</Line>
<Line Number="223">
<![CDATA[]]>
</Line>
<Line Number="224">
<![CDATA[// Capture the delta between Merged Packages and the Reservation Slot]]>
</Line>
<Line Number="225">
<![CDATA[IF MRG414_xCollLaneMrgCaptureArm then]]>
</Line>
<Line Number="226">
<![CDATA[	JSR(RT_CollLaneMergeCapture, 0);]]>
</Line>
<Line Number="227">
<![CDATA[END_IF;]]>
</Line>
<Line Number="228">
<![CDATA[]]>
</Line>
<Line Number="229">
<![CDATA[// Lane Offset Find]]>
</Line>
<Line Number="230">
<![CDATA[IF MRG414_xLaneOffsetFind THEN]]>
</Line>
<Line Number="231">
<![CDATA[	JSR( RT_LaneOffsetFind, 0);]]>
</Line>
<Line Number="232">
<![CDATA[END_IF;]]>
</Line>
<Line Number="233">
<![CDATA[]]>
</Line>
<Line Number="234">
<![CDATA[]]>
</Line>
<Line Number="235">
<![CDATA[]]>
</Line>
<Line Number="236">
<![CDATA[///////////////////////////////]]>
</Line>
<Line Number="237">
<![CDATA[//]]>
</Line>
<Line Number="238">
<![CDATA[// Execute the reservation manager]]>
</Line>
<Line Number="239">
<![CDATA[//]]>
</Line>
<Line Number="240">
<![CDATA[///////////////////////////////]]>
</Line>
<Line Number="241">
<![CDATA[JSR(RT_CollTrackResvMngr, 0);]]>
</Line>
<Line Number="242">
<![CDATA[]]>
</Line>
<Line Number="243">
<![CDATA[/////////////////////////////////]]>
</Line>
<Line Number="244">
<![CDATA[//]]>
</Line>
<Line Number="245">
<![CDATA[// Execute the Lane portion for Mergin onto Collector]]>
</Line>
<Line Number="246">
<![CDATA[//]]>
</Line>
<Line Number="247">
<![CDATA[//////////////////////////////////]]>
</Line>
<Line Number="248">
<![CDATA[FOR MRG414_di_LaneCntrlIdx := 1 TO MRG414_stCollTrkSysCfg.diNumLanes DO]]>
</Line>
<Line Number="249">
<![CDATA[JSR(SR_LaneCntrl,1,MRG414_di_LaneCntrlIdx); ]]>
</Line>
<Line Number="250">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="251">
<![CDATA[]]>
</Line>
<Line Number="252">
<![CDATA[/////////////// END OF ROUTINE /////////////]]>
</Line>
</STContent>
</Routine>
<Routine Name="RT_CollTrackResvMngr" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[// 	Copyright © Fortna, Inc. ]]>
</Line>
<Line Number="2">
<![CDATA[// 	All Rights Reserved.]]>
</Line>
<Line Number="3">
<![CDATA[// ]]>
</Line>
<Line Number="4">
<![CDATA[// 	Unauthorized use is strictly prohibited.]]>
</Line>
<Line Number="5">
<![CDATA[// 	Contact Fortna, Inc. for additional information. ]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//  Version: 1.0 / Author: Greg Sturm]]>
</Line>
<Line Number="8">
<![CDATA[//  Version: 1.1 - Added Search Optimization]]>
</Line>
<Line Number="9">
<![CDATA[// ************************************************************************************************************************]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[//////////////////////////////////]]>
</Line>
<Line Number="12">
<![CDATA[//]]>
</Line>
<Line Number="13">
<![CDATA[// Collector Reservation Manager]]>
</Line>
<Line Number="14">
<![CDATA[//]]>
</Line>
<Line Number="15">
<![CDATA[//		 Modes of operation for merge ]]>
</Line>
<Line Number="16">
<![CDATA[//			0 = Collector conveyor Not Running in AUTO Mode]]>
</Line>
<Line Number="17">
<![CDATA[//			1= Startup Mode, running out Collector]]>
</Line>
<Line Number="18">
<![CDATA[//			2= Startup  Mode, waiting for all lane to coplete their merge]]>
</Line>
<Line Number="19">
<![CDATA[//			3= Normal Mode]]>
</Line>
<Line Number="20">
<![CDATA[//]]>
</Line>
<Line Number="21">
<![CDATA[////////////////////////////////]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[// Find the size of reservation priority array. //RJ added.]]>
</Line>
<Line Number="24">
<![CDATA[SIZE(MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[0], 0, MRG414_diResvRqstOrderArySize);]]>
</Line>
<Line Number="25">
<![CDATA[MRG414_diResvRqstAryIdx := MRG414_diResvRqstOrderArySize - 1;]]>
</Line>
<Line Number="26">
<![CDATA[MRG414_diClctrSlotOrdIdxLim := MRG414_diResvRqstAryIdx - 1;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[// Debug scan counter]]>
</Line>
<Line Number="29">
<![CDATA[MRG414_diCollResvMngrScanCnt := MRG414_diCollResvMngrScanCnt + 1; ]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[// Record previous state of Collector Running in Auto Mode]]>
</Line>
<Line Number="32">
<![CDATA[MRG414_stCollStatus.xClctrRunningPrev := MRG414_stCollStatus.xClctrRunning;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[MRG414_stCollStatus.diClctrModePrev := MRG414_stCollStatus.diClctrMode;]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[// Determine the running state of the Collector]]>
</Line>
<Line Number="37">
<![CDATA[MRG414_stCollStatus.xClctrRunning := MRG414_stCollStatus.xClctrRunningAtSpeed; ]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[// Determine Mode of operation for Collector Merging process]]>
</Line>
<Line Number="40">
<![CDATA[IF NOT(MRG414_stCollStatus.xClctrRunning) THEN]]>
</Line>
<Line Number="41">
<![CDATA[	MRG414_stCollStatus.diClctrMode := 0; // Stopped]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[ELSIF NOT(MRG414_stCollStatus.xClctrRunningPrev) AND MRG414_stCollStatus.xClctrRunning THEN]]>
</Line>
<Line Number="44">
<![CDATA[	MRG414_stCollStatus.diClctrMode := 1; // Satrt-Up]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[END_IF;]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[IF (MRG414_stCollStatus.diClctrMode <> 2) THEN]]>
</Line>
<Line Number="49">
<![CDATA[	MRG414_stCollStatus.diClctrStrtSaftyTMR.TimerEnable := 0; // FALSE]]>
</Line>
<Line Number="50">
<![CDATA[END_IF;]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[// Saftey check on Mode]]>
</Line>
<Line Number="53">
<![CDATA[IF (MRG414_stCollStatus.diClctrMode < 0) OR  (MRG414_stCollStatus.diClctrMode > 3) THEN]]>
</Line>
<Line Number="54">
<![CDATA[	MRG414_stCollStatus.diClctrMode := 0;]]>
</Line>
<Line Number="55">
<![CDATA[END_IF;]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[/////////////////////////////////////////]]>
</Line>
<Line Number="58">
<![CDATA[//]]>
</Line>
<Line Number="59">
<![CDATA[// Stopped Mode]]>
</Line>
<Line Number="60">
<![CDATA[//]]>
</Line>
<Line Number="61">
<![CDATA[/////////////////////////////////////////]]>
</Line>
<Line Number="62">
<![CDATA[IF MRG414_stCollStatus.diClctrMode = 0 THEN]]>
</Line>
<Line Number="63">
<![CDATA[	// Stopped Mode]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[	// Must revoked and remove all reservation]]>
</Line>
<Line Number="66">
<![CDATA[	FOR MRG414_diClctrResvMngIdx := MRG414_stCollTrkSysCfg.diNumLanes TO 1 BY -1  DO]]>
</Line>
<Line Number="67">
<![CDATA[//	FOR diClctrResvMngIdx := 1 TO stCollTrkSysCfg.diNumLanes DO           ]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[		IF MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xLaneWaitingForslot]]>
</Line>
<Line Number="70">
<![CDATA[		  OR MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xLaneWaitingForResv]]>
</Line>
<Line Number="71">
<![CDATA[		  THEN]]>
</Line>
<Line Number="72">
<![CDATA[]]>
</Line>
<Line Number="73">
<![CDATA[			MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xSearchForSlot		:= 1; // TRUE]]>
</Line>
<Line Number="74">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="75">
<![CDATA[]]>
</Line>
<Line Number="76">
<![CDATA[		MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xLaneWaitingForslot	:= 0; // FALSE]]>
</Line>
<Line Number="77">
<![CDATA[		MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xLaneWaitingForResv	:= 0; // FALSE]]>
</Line>
<Line Number="78">
<![CDATA[]]>
</Line>
<Line Number="79">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xOkToReleaseLane	:= 0; // FALSE]]>
</Line>
<Line Number="80">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSearchForSlotAck	:= 0; // FALSE]]>
</Line>
<Line Number="81">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotFound			:= 0; // FALSE]]>
</Line>
<Line Number="82">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotReserved		:= 0; // FALSE]]>
</Line>
<Line Number="83">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotResvRevoked	:= 0; // FALSE]]>
</Line>
<Line Number="84">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotCompromised	:= 0; // FALSE]]>
</Line>
<Line Number="85">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotAtMergePoint	:= 0; // FALSE]]>
</Line>
<Line Number="86">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotPastMergePoint := 0; // FALSE]]>
</Line>
<Line Number="87">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotResvRevoked	:= 1; // TRUE]]>
</Line>
<Line Number="88">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="89">
<![CDATA[]]>
</Line>
<Line Number="90">
<![CDATA[	// Clear reservation queues]]>
</Line>
<Line Number="91">
<![CDATA[	FOR MRG414_diClctrSlotOrdIdx  := 0 to MRG414_diResvRqstAryIdx DO]]>
</Line>
<Line Number="92">
<![CDATA[]]>
</Line>
<Line Number="93">
<![CDATA[		MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrSlotOrdIdx] := 0;]]>
</Line>
<Line Number="94">
<![CDATA[		MRG414_stLaneClctrSlotResMngr.adiResvRqstGrant[MRG414_diClctrSlotOrdIdx] := 0;]]>
</Line>
<Line Number="95">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="96">
<![CDATA[				]]>
</Line>
<Line Number="97">
<![CDATA[	// Reset Collector Run-Out Counter]]>
</Line>
<Line Number="98">
<![CDATA[	MRG414_stCollStatus.diClctRunoutAccum :=  0.0;]]>
</Line>
<Line Number="99">
<![CDATA[END_IF;]]>
</Line>
<Line Number="100">
<![CDATA[]]>
</Line>
<Line Number="101">
<![CDATA[/////////////////////////////////////////]]>
</Line>
<Line Number="102">
<![CDATA[//]]>
</Line>
<Line Number="103">
<![CDATA[// Startup Mode - Running out Collector]]>
</Line>
<Line Number="104">
<![CDATA[//]]>
</Line>
<Line Number="105">
<![CDATA[/////////////////////////////////////////]]>
</Line>
<Line Number="106">
<![CDATA[IF MRG414_stCollStatus.diClctrMode = 1 THEN]]>
</Line>
<Line Number="107">
<![CDATA[	// Startup Mode]]>
</Line>
<Line Number="108">
<![CDATA[	]]>
</Line>
<Line Number="109">
<![CDATA[	// Check if the Run-out counter has exceeded configured value]]>
</Line>
<Line Number="110">
<![CDATA[	IF MRG414_stCollStatus.diClctRunoutAccum > MRG414_stCollTrkSysCfg.diClctrRunoutDist THEN]]>
</Line>
<Line Number="111">
<![CDATA[]]>
</Line>
<Line Number="112">
<![CDATA[		FOR MRG414_diClctrResvMngIdx := MRG414_stCollTrkSysCfg.diNumLanes TO 1 BY -1 DO ]]>
</Line>
<Line Number="113">
<![CDATA[]]>
</Line>
<Line Number="114">
<![CDATA[			IF MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xLaneWaitingForslot]]>
</Line>
<Line Number="115">
<![CDATA[			  OR MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xLaneWaitingForResv]]>
</Line>
<Line Number="116">
<![CDATA[			  THEN]]>
</Line>
<Line Number="117">
<![CDATA[]]>
</Line>
<Line Number="118">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xSearchForSlot		:= 1; // TRUE]]>
</Line>
<Line Number="119">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="120">
<![CDATA[]]>
</Line>
<Line Number="121">
<![CDATA[			MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xLaneWaitingForslot	:= 0; // FALSE]]>
</Line>
<Line Number="122">
<![CDATA[			MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngIdx].xLaneWaitingForResv	:= 0; // FALSE]]>
</Line>
<Line Number="123">
<![CDATA[]]>
</Line>
<Line Number="124">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xOkToReleaseLane	:= 0; // FALSE]]>
</Line>
<Line Number="125">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSearchForSlotAck	:= 0; // FALSE]]>
</Line>
<Line Number="126">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotFound			:= 0; // FALSE]]>
</Line>
<Line Number="127">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotReserved		:= 0; // FALSE]]>
</Line>
<Line Number="128">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotResvRevoked	:= 0; // FALSE]]>
</Line>
<Line Number="129">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotCompromised	:= 0; // FALSE]]>
</Line>
<Line Number="130">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotAtMergePoint	:= 0; // FALSE]]>
</Line>
<Line Number="131">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngIdx].xSlotPastMergePoint := 0; // FALSE]]>
</Line>
<Line Number="132">
<![CDATA[		END_FOR;]]>
</Line>
<Line Number="133">
<![CDATA[]]>
</Line>
<Line Number="134">
<![CDATA[		// Clear reservation queues]]>
</Line>
<Line Number="135">
<![CDATA[		FOR MRG414_diClctrSlotOrdIdx  := 0 to MRG414_diResvRqstAryIdx DO]]>
</Line>
<Line Number="136">
<![CDATA[]]>
</Line>
<Line Number="137">
<![CDATA[			MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrSlotOrdIdx] := 0;]]>
</Line>
<Line Number="138">
<![CDATA[			MRG414_stLaneClctrSlotResMngr.adiResvRqstGrant[MRG414_diClctrSlotOrdIdx] := 0;]]>
</Line>
<Line Number="139">
<![CDATA[		END_FOR;]]>
</Line>
<Line Number="140">
<![CDATA[]]>
</Line>
<Line Number="141">
<![CDATA[]]>
</Line>
<Line Number="142">
<![CDATA[		// Go to Startup Mode - Waiting for all lanes to complete Merge]]>
</Line>
<Line Number="143">
<![CDATA[		MRG414_stCollStatus.diClctrMode := 2;]]>
</Line>
<Line Number="144">
<![CDATA[]]>
</Line>
<Line Number="145">
<![CDATA[		// Reset Startup mode safety timer]]>
</Line>
<Line Number="146">
<![CDATA[		MRG414_stCollStatus.diClctrStrtSaftyTMR.PRE := MRG414_stCollTrkSysCfg.diClctrSrtSafteyTmrPreset;]]>
</Line>
<Line Number="147">
<![CDATA[]]>
</Line>
<Line Number="148">
<![CDATA[	ELSE]]>
</Line>
<Line Number="149">
<![CDATA[		// Continue to increment the runout counter]]>
</Line>
<Line Number="150">
<![CDATA[		MRG414_stCollStatus.diClctRunoutAccum := MRG414_stCollStatus.diClctRunoutAccum + MRG414_diCollDeltaEncCnt;]]>
</Line>
<Line Number="151">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="152">
<![CDATA[]]>
</Line>
<Line Number="153">
<![CDATA[	// Check if any Collector PE is blocked and then reset run-out accumulator - TBD]]>
</Line>
<Line Number="154">
<![CDATA[]]>
</Line>
<Line Number="155">
<![CDATA[END_IF;]]>
</Line>
<Line Number="156">
<![CDATA[]]>
</Line>
<Line Number="157">
<![CDATA[/////////////////////////////////////////]]>
</Line>
<Line Number="158">
<![CDATA[//]]>
</Line>
<Line Number="159">
<![CDATA[// Startup Mode - Waiting for all lanes to complete Merge]]>
</Line>
<Line Number="160">
<![CDATA[//]]>
</Line>
<Line Number="161">
<![CDATA[/////////////////////////////////////////]]>
</Line>
<Line Number="162">
<![CDATA[]]>
</Line>
<Line Number="163">
<![CDATA[//Run Safety Timer]]>
</Line>
<Line Number="164">
<![CDATA[TONR (MRG414_stCollStatus.diClctrStrtSaftyTMR);]]>
</Line>
<Line Number="165">
<![CDATA[]]>
</Line>
<Line Number="166">
<![CDATA[]]>
</Line>
<Line Number="167">
<![CDATA[IF (MRG414_stCollStatus.diClctrMode = 2) THEN]]>
</Line>
<Line Number="168">
<![CDATA[	// Startup Mode - Waiting to complete all lane merges]]>
</Line>
<Line Number="169">
<![CDATA[	]]>
</Line>
<Line Number="170">
<![CDATA[	MRG414_stCollStatus.diClctrStrtSaftyTMR.TimerEnable := 1; // TRUE]]>
</Line>
<Line Number="171">
<![CDATA[]]>
</Line>
<Line Number="172">
<![CDATA[	// Let all lanes know it is OK to run the lane]]>
</Line>
<Line Number="173">
<![CDATA[	// in case a previously started Package Train merge needs to complete]]>
</Line>
<Line Number="174">
<![CDATA[]]>
</Line>
<Line Number="175">
<![CDATA[	// Check if all lanes have completed merging]]>
</Line>
<Line Number="176">
<![CDATA[	// Default to complete]]>
</Line>
<Line Number="177">
<![CDATA[	MRG414_stCollStatus.xClctrAllLanesMrgCmpt  := 1; // TRUE]]>
</Line>
<Line Number="178">
<![CDATA[]]>
</Line>
<Line Number="179">
<![CDATA[	FOR MRG414_diClctrResvMngStrtIdx := MRG414_stCollTrkSysCfg.diNumLanes  TO 1 BY -1 DO ]]>
</Line>
<Line Number="180">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngStrtIdx].xOkToReleaseLane := 1; // TRUE]]>
</Line>
<Line Number="181">
<![CDATA[]]>
</Line>
<Line Number="182">
<![CDATA[		IF MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngStrtIdx].xLaneMerging THEN]]>
</Line>
<Line Number="183">
<![CDATA[			MRG414_stCollStatus.xClctrAllLanesMrgCmpt  := 0; // FALSE]]>
</Line>
<Line Number="184">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="185">
<![CDATA[]]>
</Line>
<Line Number="186">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="187">
<![CDATA[]]>
</Line>
<Line Number="188">
<![CDATA[	IF MRG414_stCollStatus.xClctrAllLanesMrgCmpt OR MRG414_stCollStatus.diClctrStrtSaftyTMR.DN THEN]]>
</Line>
<Line Number="189">
<![CDATA[]]>
</Line>
<Line Number="190">
<![CDATA[		// Go to Normal Mode]]>
</Line>
<Line Number="191">
<![CDATA[		MRG414_stCollStatus.diClctrMode := 3;]]>
</Line>
<Line Number="192">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="193">
<![CDATA[]]>
</Line>
<Line Number="194">
<![CDATA[	// Otherwise continue to wait]]>
</Line>
<Line Number="195">
<![CDATA[	]]>
</Line>
<Line Number="196">
<![CDATA[END_IF;]]>
</Line>
<Line Number="197">
<![CDATA[]]>
</Line>
<Line Number="198">
<![CDATA[]]>
</Line>
<Line Number="199">
<![CDATA[/////////////////////////////////////////]]>
</Line>
<Line Number="200">
<![CDATA[//]]>
</Line>
<Line Number="201">
<![CDATA[// Normal Mode]]>
</Line>
<Line Number="202">
<![CDATA[//]]>
</Line>
<Line Number="203">
<![CDATA[/////////////////////////////////////////]]>
</Line>
<Line Number="204">
<![CDATA[IF MRG414_stCollStatus.diClctrMode = 3 THEN]]>
</Line>
<Line Number="205">
<![CDATA[]]>
</Line>
<Line Number="206">
<![CDATA[	// Handle Reservation Requests]]>
</Line>
<Line Number="207">
<![CDATA[]]>
</Line>
<Line Number="208">
<![CDATA[	FOR MRG414_diClctrResvMngLaneIdx := MRG414_stCollTrkSysCfg.diNumLanes TO 1 BY -1 DO ]]>
</Line>
<Line Number="209">
<![CDATA[		]]>
</Line>
<Line Number="210">
<![CDATA[		MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].xOkToReleaseLane := 1; // TRUE]]>
</Line>
<Line Number="211">
<![CDATA[]]>
</Line>
<Line Number="212">
<![CDATA[		// Check if a request and if already on Queue]]>
</Line>
<Line Number="213">
<![CDATA[		IF 	MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngLaneIdx].xSearchForSlot ]]>
</Line>
<Line Number="214">
<![CDATA[		  AND NOT(MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].xSearchForSlotAck)]]>
</Line>
<Line Number="215">
<![CDATA[		  AND NOT(MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].xSlotFound)]]>
</Line>
<Line Number="216">
<![CDATA[		  AND NOT(MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].xSlotReserved)]]>
</Line>
<Line Number="217">
<![CDATA[		  AND NOT(MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngLaneIdx].xLaneWaitingForslot)]]>
</Line>
<Line Number="218">
<![CDATA[		  AND NOT(MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngLaneIdx].xLaneWaitingForResv)]]>
</Line>
<Line Number="219">
<![CDATA[		  THEN]]>
</Line>
<Line Number="220">
<![CDATA[]]>
</Line>
<Line Number="221">
<![CDATA[			// Check that it is not already on the Queue]]>
</Line>
<Line Number="222">
<![CDATA[			MRG414_xLaneClctrSlotResvFnd := 0;  // Default False]]>
</Line>
<Line Number="223">
<![CDATA[			FOR MRG414_diClctrSlotOrdIdx  := 0 to MRG414_diResvRqstAryIdx DO]]>
</Line>
<Line Number="224">
<![CDATA[				IF 	MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrSlotOrdIdx] = MRG414_diClctrResvMngLaneIdx THEN]]>
</Line>
<Line Number="225">
<![CDATA[					MRG414_xLaneClctrSlotResvFnd := 1; // TRUE]]>
</Line>
<Line Number="226">
<![CDATA[					EXIT;]]>
</Line>
<Line Number="227">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="228">
<![CDATA[				]]>
</Line>
<Line Number="229">
<![CDATA[				// Find first availble empty spot]]>
</Line>
<Line Number="230">
<![CDATA[				IF 	MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrSlotOrdIdx] <= 0 THEN]]>
</Line>
<Line Number="231">
<![CDATA[					MRG414_diClctrSlotInsert := MRG414_diClctrSlotOrdIdx;]]>
</Line>
<Line Number="232">
<![CDATA[					EXIT;]]>
</Line>
<Line Number="233">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="234">
<![CDATA[]]>
</Line>
<Line Number="235">
<![CDATA[			END_FOR;]]>
</Line>
<Line Number="236">
<![CDATA[]]>
</Line>
<Line Number="237">
<![CDATA[			IF NOT(MRG414_xLaneClctrSlotResvFnd) THEN]]>
</Line>
<Line Number="238">
<![CDATA[]]>
</Line>
<Line Number="239">
<![CDATA[				// Make sure enough room in the Queue]]>
</Line>
<Line Number="240">
<![CDATA[				IF MRG414_diClctrSlotOrdIdx < MRG414_stCollTrkSysCfg.diNumLanes THEN ]]>
</Line>
<Line Number="241">
<![CDATA[]]>
</Line>
<Line Number="242">
<![CDATA[		  			// Insert the request on the tail end of the Queue]]>
</Line>
<Line Number="243">
<![CDATA[					MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrSlotInsert] := MRG414_diClctrResvMngLaneIdx;]]>
</Line>
<Line Number="244">
<![CDATA[]]>
</Line>
<Line Number="245">
<![CDATA[					IF MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngLaneIdx].diLaneMode = 1 THEN ]]>
</Line>
<Line Number="246">
<![CDATA[						// Startup Mode]]>
</Line>
<Line Number="247">
<![CDATA[						// Record Size of the Slot Request]]>
</Line>
<Line Number="248">
<![CDATA[						MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].diSlotSizePls := MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngLaneIdx].rStartupSlotSizeInch / MRG414_stCollTrkSysCfg.rClctrPsuedoEnc_IPP;]]>
</Line>
<Line Number="249">
<![CDATA[						// Record the Merge Location]]>
</Line>
<Line Number="250">
<![CDATA[						MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].diResvLaneLoc := MRG414_stCollTrkSysCfg.adiStartupLaneLoc[MRG414_diClctrResvMngLaneIdx];]]>
</Line>
<Line Number="251">
<![CDATA[					ELSE ]]>
</Line>
<Line Number="252">
<![CDATA[						// Not startup Mode]]>
</Line>
<Line Number="253">
<![CDATA[						// Record Size of the Slot Request]]>
</Line>
<Line Number="254">
<![CDATA[						MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].diSlotSizePls := MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvMngLaneIdx].rSlotSizeInch / MRG414_stCollTrkSysCfg.rClctrPsuedoEnc_IPP;]]>
</Line>
<Line Number="255">
<![CDATA[						// Record the Merge Location]]>
</Line>
<Line Number="256">
<![CDATA[						MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].diResvLaneLoc := MRG414_stCollTrkSysCfg.adiLaneLoc[MRG414_diClctrResvMngLaneIdx];]]>
</Line>
<Line Number="257">
<![CDATA[					END_IF;					]]>
</Line>
<Line Number="258">
<![CDATA[						]]>
</Line>
<Line Number="259">
<![CDATA[					// Acknowledge the reservation since already in the Queue]]>
</Line>
<Line Number="260">
<![CDATA[					MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].xSearchForSlotAck := 1; // TRUE]]>
</Line>
<Line Number="261">
<![CDATA[]]>
</Line>
<Line Number="262">
<![CDATA[					// Clearout the Slot Starting Location]]>
</Line>
<Line Number="263">
<![CDATA[					MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].diSlotStartLoc := 0;]]>
</Line>
<Line Number="264">
<![CDATA[]]>
</Line>
<Line Number="265">
<![CDATA[					// Handle the Lane Waiting Mask - TBD]]>
</Line>
<Line Number="266">
<![CDATA[]]>
</Line>
<Line Number="267">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="268">
<![CDATA[]]>
</Line>
<Line Number="269">
<![CDATA[			ELSE]]>
</Line>
<Line Number="270">
<![CDATA[				// Acknowledge the reservation since already in the Queue]]>
</Line>
<Line Number="271">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].xSearchForSlotAck := 1; // TRUE]]>
</Line>
<Line Number="272">
<![CDATA[]]>
</Line>
<Line Number="273">
<![CDATA[				// Clearout the Slot Starting Location]]>
</Line>
<Line Number="274">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvMngLaneIdx].diSlotStartLoc := 0;]]>
</Line>
<Line Number="275">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="276">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="277">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="278">
<![CDATA[]]>
</Line>
<Line Number="279">
<![CDATA[	///////////////]]>
</Line>
<Line Number="280">
<![CDATA[	// Loop to Check if a Reservation Request can be Granted]]>
</Line>
<Line Number="281">
<![CDATA[	///////////////]]>
</Line>
<Line Number="282">
<![CDATA[	]]>
</Line>
<Line Number="283">
<![CDATA[	MRG414_diClctrSlotOrdIdx  := 0;]]>
</Line>
<Line Number="284">
<![CDATA[	FOR MRG414_diClctrSlotSrchNum  := 0 to MRG414_diResvRqstAryIdx DO]]>
</Line>
<Line Number="285">
<![CDATA[]]>
</Line>
<Line Number="286">
<![CDATA[		// EXIt Loop When all Reservation requests have been checked]]>
</Line>
<Line Number="287">
<![CDATA[		IF (MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrSlotOrdIdx] <= 0)]]>
</Line>
<Line Number="288">
<![CDATA[		  OR (MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrSlotOrdIdx] > MRG414_stCollTrkSysCfg.diNumLanes)]]>
</Line>
<Line Number="289">
<![CDATA[		  THEN]]>
</Line>
<Line Number="290">
<![CDATA[			EXIT;]]>
</Line>
<Line Number="291">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="292">
<![CDATA[]]>
</Line>
<Line Number="293">
<![CDATA[		MRG414_diClctrSchLane := MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrSlotOrdIdx];]]>
</Line>
<Line Number="294">
<![CDATA[]]>
</Line>
<Line Number="295">
<![CDATA[		// Check First Slot AKA Highest Priority]]>
</Line>
<Line Number="296">
<![CDATA[		IF MRG414_diClctrSlotOrdIdx = 0 THEN]]>
</Line>
<Line Number="297">
<![CDATA[			]]>
</Line>
<Line Number="298">
<![CDATA[			// Search For a Reservation]]>
</Line>
<Line Number="299">
<![CDATA[			]]>
</Line>
<Line Number="300">
<![CDATA[			// reset the slot found indicator]]>
</Line>
<Line Number="301">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].xSlotFound := 0; // False]]>
</Line>
<Line Number="302">
<![CDATA[]]>
</Line>
<Line Number="303">
<![CDATA[			// Increment counts]]>
</Line>
<Line Number="304">
<![CDATA[			MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSchLane].diSearchForSlotCnt := MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSchLane].diSearchForSlotCnt + 1;]]>
</Line>
<Line Number="305">
<![CDATA[]]>
</Line>
<Line Number="306">
<![CDATA[		(****** 2021-09-21 Add Load Balancing later if needed]]>
</Line>
<Line Number="307">
<![CDATA[			diCollLaneAndMask				:= stCollLaneMrgCfg_L1.diLaneAndMask;]]>
</Line>
<Line Number="308">
<![CDATA[			xCollLoadBalanceEn				:= stCollLaneMrgCfg_L1.xLoadBalanceEn;]]>
</Line>
<Line Number="309">
<![CDATA[			diCollResvFarUpStrmDist			:= stCollLaneMrgCfg_L1.diResvFarUpStrmDist;]]>
</Line>
<Line Number="310">
<![CDATA[			diCollSlotSizeForLbPls			:= stCollLaneMrgCfg_L1.diCollSlotSizeForLB / stCollector_EncSts.stCfg.rIPP;]]>
</Line>
<Line Number="311">
<![CDATA[		********)]]>
</Line>
<Line Number="312">
<![CDATA[]]>
</Line>
<Line Number="313">
<![CDATA[			// COP(adiLaneClctrSlotResCnts[diClctrSchLane], stCollLaneMrgCnts, 1);]]>
</Line>
<Line Number="314">
<![CDATA[			MRG414_diCollLaneCompareMask 			:= MRG414_stCollTrkSysCfg.adiLaneCompareMask[MRG414_diClctrSchLane];]]>
</Line>
<Line Number="315">
<![CDATA[			MRG414_diCollUpStrmFreeSearchLimitPls 	:= MRG414_stCollTrkSysCfg.adiOptUpStrmSearchLimit[MRG414_diClctrSchLane] / MRG414_stCollTrkSysCfg.rClctrPsuedoEnc_IPP;]]>
</Line>
<Line Number="316">
<![CDATA[			MRG414_diCollDnStrmFreeSearchLimitPls 	:= MRG414_stCollTrkSysCfg.adiOptDnStrmSearchLimit[MRG414_diClctrSchLane] / MRG414_stCollTrkSysCfg.rClctrPsuedoEnc_IPP;]]>
</Line>
<Line Number="317">
<![CDATA[			MRG414_diCollAvgSlotSizePls				:= MRG414_stCollTrkSysCfg.adiCollAvgSlotSize[MRG414_diClctrSchLane] / MRG414_stCollTrkSysCfg.rClctrPsuedoEnc_IPP;]]>
</Line>
<Line Number="318">
<![CDATA[			]]>
</Line>
<Line Number="319">
<![CDATA[			// search for a slot on the Collector]]>
</Line>
<Line Number="320">
<![CDATA[			JSR(	SR_CollTrackSrchSlot]]>
</Line>
<Line Number="321">
<![CDATA[					,2]]>
</Line>
<Line Number="322">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].diResvLaneLoc // stCollTrkSysCfg.adiLaneLoc[diClctrSchLane]   // stL1_LaneClctrSlotRes.diSlotStartSearchPls  	// i_diSrchStartIdx]]>
</Line>
<Line Number="323">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].diSlotSizePls     //stL1_LaneClctrSlotRes.diSlotSizePls			// i_diSrchSlotSizeReq]]>
</Line>
<Line Number="324">
<![CDATA[	//				,// o_xCollSlotFnd]]>
</Line>
<Line Number="325">
<![CDATA[	//				,// o_diFndSlotLoc]]>
</Line>
<Line Number="326">
<![CDATA[					);  ]]>
</Line>
<Line Number="327">
<![CDATA[]]>
</Line>
<Line Number="328">
<![CDATA[			// 2014-12-01 Do not use returned values]]>
</Line>
<Line Number="329">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].xSlotFound := MRG414_o_xCollSlotFnd;]]>
</Line>
<Line Number="330">
<![CDATA[]]>
</Line>
<Line Number="331">
<![CDATA[			// COP(stCollLaneMrgCnts, adiLaneClctrSlotResCnts[diClctrSchLane], 1);]]>
</Line>
<Line Number="332">
<![CDATA[]]>
</Line>
<Line Number="333">
<![CDATA[			IF MRG414_o_xCollSlotFnd THEN]]>
</Line>
<Line Number="334">
<![CDATA[]]>
</Line>
<Line Number="335">
<![CDATA[				MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSchLane].diSlotFndCnt := MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSchLane].diSlotFndCnt + 1;]]>
</Line>
<Line Number="336">
<![CDATA[]]>
</Line>
<Line Number="337">
<![CDATA[				//2014-12-03 Moved statement here]]>
</Line>
<Line Number="338">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].diSlotStartLoc := MRG414_o_diCollFndSlotLoc;]]>
</Line>
<Line Number="339">
<![CDATA[]]>
</Line>
<Line Number="340">
<![CDATA[				// 2016-01-04 Check if this reservation was far upstream]]>
</Line>
<Line Number="341">
<![CDATA[				(***** 2016-09-21 Optimize Later]]>
</Line>
<Line Number="342">
<![CDATA[				IF ((stL1_LaneClctrSlotRes.diSlotStartLoc - stL1_LaneClctrSlotRes.diSlotStartSearchPls) > (stCollLaneMrgCfg_L1.diResvFarUpStrmDist / stCollector_EncSts.stCfg.rIPP) ) THEN]]>
</Line>
<Line Number="343">
<![CDATA[					diLaneResvFarUpstream_Status := (diLaneResvFarUpstream_Status OR stCollLaneMrgCfg_L1.diLaneOrMask);]]>
</Line>
<Line Number="344">
<![CDATA[					stCollLaneMrgCnts_L1.diFarUpstreamResvCnt := stCollLaneMrgCnts_L1.diFarUpstreamResvCnt + 1;]]>
</Line>
<Line Number="345">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="346">
<![CDATA[				***********)]]>
</Line>
<Line Number="347">
<![CDATA[]]>
</Line>
<Line Number="348">
<![CDATA[				// 2014-12-01 Added]]>
</Line>
<Line Number="349">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrSchLane].xSearchForSlot := MRG414_c_xFALSE;]]>
</Line>
<Line Number="350">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].xSearchForSlotAck  := MRG414_c_xFALSE;]]>
</Line>
<Line Number="351">
<![CDATA[]]>
</Line>
<Line Number="352">
<![CDATA[				// If a slot was found then reserve it for this parcel]]>
</Line>
<Line Number="353">
<![CDATA[				JSR(	SR_CollTrackRsrvSlot]]>
</Line>
<Line Number="354">
<![CDATA[						,4]]>
</Line>
<Line Number="355">
<![CDATA[						,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].diSlotStartLoc]]>
</Line>
<Line Number="356">
<![CDATA[						,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].diSlotSizePls]]>
</Line>
<Line Number="357">
<![CDATA[						,MRG414_astLaneClctrSlotResvStat[MRG414_diClctrSchLane].diLanePkgSeqId]]>
</Line>
<Line Number="358">
<![CDATA[						,MRG414_diClctrSchLane  // LaneId]]>
</Line>
<Line Number="359">
<![CDATA[						);]]>
</Line>
<Line Number="360">
<![CDATA[	]]>
</Line>
<Line Number="361">
<![CDATA[				// Mark the slot as found and reserved]]>
</Line>
<Line Number="362">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].xSlotFound := 1; // TRUE]]>
</Line>
<Line Number="363">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSchLane].xSlotReserved := 1;  // TRUE]]>
</Line>
<Line Number="364">
<![CDATA[]]>
</Line>
<Line Number="365">
<![CDATA[				MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSchLane].diSlotResevedCnt := MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSchLane].diSlotResevedCnt + 1;]]>
</Line>
<Line Number="366">
<![CDATA[			]]>
</Line>
<Line Number="367">
<![CDATA[				// Remove the reservation from the Reservation request Queue and add to the tail end of reservation granted queue]]>
</Line>
<Line Number="368">
<![CDATA[				For MRG414_diClctrShiftIdx := MRG414_diClctrSlotOrdIdx TO MRG414_diClctrSlotOrdIdxLim DO]]>
</Line>
<Line Number="369">
<![CDATA[					// shift remaining up by one]]>
</Line>
<Line Number="370">
<![CDATA[					MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrShiftIdx] := MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrShiftIdx+1];]]>
</Line>
<Line Number="371">
<![CDATA[				END_FOR;]]>
</Line>
<Line Number="372">
<![CDATA[				]]>
</Line>
<Line Number="373">
<![CDATA[				// Since removed from the queue Decrement the queue search index]]>
</Line>
<Line Number="374">
<![CDATA[				/// diClctrSlotOrdIdx := diClctrSlotOrdIdx - 1;]]>
</Line>
<Line Number="375">
<![CDATA[]]>
</Line>
<Line Number="376">
<![CDATA[			ELSE]]>
</Line>
<Line Number="377">
<![CDATA[				//  Lane sets this adiLaneClctrSlotResvStat[diClctrSchLane].xLaneWaitingForResv := 1; // TRUE]]>
</Line>
<Line Number="378">
<![CDATA[				;]]>
</Line>
<Line Number="379">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="380">
<![CDATA[]]>
</Line>
<Line Number="381">
<![CDATA[		ELSE]]>
</Line>
<Line Number="382">
<![CDATA[			// Check all lower priorities requests]]>
</Line>
<Line Number="383">
<![CDATA[			// See if the requested Lane Location plus the size requested is downstream of all the higher priority requests ]]>
</Line>
<Line Number="384">
<![CDATA[			;   // 2019-09-21 TBD : To be added later]]>
</Line>
<Line Number="385">
<![CDATA[]]>
</Line>
<Line Number="386">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="387">
<![CDATA[]]>
</Line>
<Line Number="388">
<![CDATA[		// Increment the queue search index]]>
</Line>
<Line Number="389">
<![CDATA[		MRG414_diClctrSlotOrdIdx := MRG414_diClctrSlotOrdIdx + 1;]]>
</Line>
<Line Number="390">
<![CDATA[]]>
</Line>
<Line Number="391">
<![CDATA[	END_FOR;   // End of Slot Reservation Request loop]]>
</Line>
<Line Number="392">
<![CDATA[	]]>
</Line>
<Line Number="393">
<![CDATA[]]>
</Line>
<Line Number="394">
<![CDATA[	///////////////]]>
</Line>
<Line Number="395">
<![CDATA[	// Loop to Check if a Lane is faulted and the Reservation needs to be revoked.]]>
</Line>
<Line Number="396">
<![CDATA[	///////////////]]>
</Line>
<Line Number="397">
<![CDATA[	FOR MRG414_diClctrFltLaneIdx := MRG414_stCollTrkSysCfg.diNumLanes TO 1 BY -1 DO ]]>
</Line>
<Line Number="398">
<![CDATA[		]]>
</Line>
<Line Number="399">
<![CDATA[		// Check if a lane is Faulted]]>
</Line>
<Line Number="400">
<![CDATA[		IF MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xLaneFaulted THEN]]>
</Line>
<Line Number="401">
<![CDATA[]]>
</Line>
<Line Number="402">
<![CDATA[			// Remove Reservation From Request Queue]]>
</Line>
<Line Number="403">
<![CDATA[			For MRG414_diClctrShiftIdx := MRG414_diClctrSlotOrdIdx TO MRG414_diClctrSlotOrdIdxLim DO]]>
</Line>
<Line Number="404">
<![CDATA[]]>
</Line>
<Line Number="405">
<![CDATA[				IF MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrShiftIdx] = MRG414_diClctrFltLaneIdx THEN]]>
</Line>
<Line Number="406">
<![CDATA[					// shift remaining up by one]]>
</Line>
<Line Number="407">
<![CDATA[					COP (MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrShiftIdx+1], MRG414_stLaneClctrSlotResMngr.adiResvRqstOrder[MRG414_diClctrShiftIdx], 1);]]>
</Line>
<Line Number="408">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="409">
<![CDATA[				]]>
</Line>
<Line Number="410">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xSearchForSlot := 0;]]>
</Line>
<Line Number="411">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xSearchForSlotPrev := 0;]]>
</Line>
<Line Number="412">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].xSearchForSlotAck := 0;]]>
</Line>
<Line Number="413">
<![CDATA[]]>
</Line>
<Line Number="414">
<![CDATA[			END_FOR;]]>
</Line>
<Line Number="415">
<![CDATA[			]]>
</Line>
<Line Number="416">
<![CDATA[			// If reservation was Granted then ]]>
</Line>
<Line Number="417">
<![CDATA[			IF (MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].xSlotFound ]]>
</Line>
<Line Number="418">
<![CDATA[			    OR MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].xSlotReserved]]>
</Line>
<Line Number="419">
<![CDATA[				OR MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xLaneWaitingForslot)]]>
</Line>
<Line Number="420">
<![CDATA[				AND NOT(MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xLaneMerging)]]>
</Line>
<Line Number="421">
<![CDATA[			  THEN]]>
</Line>
<Line Number="422">
<![CDATA[]]>
</Line>
<Line Number="423">
<![CDATA[				// Remove reservation from Collector]]>
</Line>
<Line Number="424">
<![CDATA[				JSR( SR_CollTrackClrSlot]]>
</Line>
<Line Number="425">
<![CDATA[					,4			]]>
</Line>
<Line Number="426">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].diSlotStartLoc 	// i_diCollClrStartIdx]]>
</Line>
<Line Number="427">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].diSlotSizePls 		// i_diCollClrSlotSize]]>
</Line>
<Line Number="428">
<![CDATA[					,MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].diLanePkgSeqId		// i_diCollClrTrkId]]>
</Line>
<Line Number="429">
<![CDATA[					,MRG414_diClctrResvAtSlotLaneIdx												// i_diCollClrLaneId ]]>
</Line>
<Line Number="430">
<![CDATA[					);]]>
</Line>
<Line Number="431">
<![CDATA[]]>
</Line>
<Line Number="432">
<![CDATA[				// Set the Lanes reservation revoked bit]]>
</Line>
<Line Number="433">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].xSlotResvRevoked := 1; //Fixed the array index by RJ //astLaneClctrSlotResvCntrl[diClctrFltLaneIdx].xSlotResvRevoked := 1;]]>
</Line>
<Line Number="434">
<![CDATA[]]>
</Line>
<Line Number="435">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="436">
<![CDATA[]]>
</Line>
<Line Number="437">
<![CDATA[				// Reset the Lanes Slot At Merge Bit]]>
</Line>
<Line Number="438">
<![CDATA[				// Reset the Lanes Slot past Merge Bit]]>
</Line>
<Line Number="439">
<![CDATA[]]>
</Line>
<Line Number="440">
<![CDATA[				// Clear the Lanes other bits ???]]>
</Line>
<Line Number="441">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xSearchForSlot			:= 0;]]>
</Line>
<Line Number="442">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xSearchForSlotPrev		:= 0;]]>
</Line>
<Line Number="443">
<![CDATA[				// adiLaneClctrSlotResvStat[diClctrFltLaneIdx].rSlotSizeInch			:= 0;]]>
</Line>
<Line Number="444">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].diLanePkgSeqId			:= 0;]]>
</Line>
<Line Number="445">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xLaneWaitingForResv		:= 0;]]>
</Line>
<Line Number="446">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xLaneWaitingForslot		:= 0;]]>
</Line>
<Line Number="447">
<![CDATA[				MRG414_astLaneClctrSlotResvStat[MRG414_diClctrFltLaneIdx].xLaneMerging			:= 0;]]>
</Line>
<Line Number="448">
<![CDATA[]]>
</Line>
<Line Number="449">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].xSlotFound				:= 0;]]>
</Line>
<Line Number="450">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].xSlotReserved			:= 0;]]>
</Line>
<Line Number="451">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].xSlotCompromised		:= 0;]]>
</Line>
<Line Number="452">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].xSlotAtMergePoint		:= 0;]]>
</Line>
<Line Number="453">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].xSlotPastMergePoint 	:= 0;]]>
</Line>
<Line Number="454">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].diSlotSizePls			:= 0;]]>
</Line>
<Line Number="455">
<![CDATA[				MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrFltLaneIdx].diSlotStartLoc			:= 0;]]>
</Line>
<Line Number="456">
<![CDATA[]]>
</Line>
<Line Number="457">
<![CDATA[				// TBD adiLaneClctrSlotResvCntrl[diClctrFltLaneIdx].diLaneWaitingMask]]>
</Line>
<Line Number="458">
<![CDATA[]]>
</Line>
<Line Number="459">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="460">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="461">
<![CDATA[]]>
</Line>
<Line Number="462">
<![CDATA[	///////////////]]>
</Line>
<Line Number="463">
<![CDATA[	// Loop to Check if a Lane Waiting for the Reserved Slot can Merge.]]>
</Line>
<Line Number="464">
<![CDATA[	///////////////]]>
</Line>
<Line Number="465">
<![CDATA[	FOR MRG414_diClctrResvAtSlotLaneIdx := MRG414_stCollTrkSysCfg.diNumLanes TO 1 BY -1 DO ]]>
</Line>
<Line Number="466">
<![CDATA[		]]>
</Line>
<Line Number="467">
<![CDATA[		// Check if a lane is waiting for its reserved slot]]>
</Line>
<Line Number="468">
<![CDATA[		IF MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvAtSlotLaneIdx].xLaneWaitingForslot THEN]]>
</Line>
<Line Number="469">
<![CDATA[]]>
</Line>
<Line Number="470">
<![CDATA[			// Check if reservation is at or beyond Merge Point]]>
</Line>
<Line Number="471">
<![CDATA[]]>
</Line>
<Line Number="472">
<![CDATA[			// Check if the slot is at the Merge Location]]>
</Line>
<Line Number="473">
<![CDATA[			JSR(	SR_CollTrackSlotAtMrgPnt]]>
</Line>
<Line Number="474">
<![CDATA[					,5]]>
</Line>
<Line Number="475">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvAtSlotLaneIdx].diSlotStartLoc 			// i_diCollMrgStartIdx 		]]>
</Line>
<Line Number="476">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvAtSlotLaneIdx].diResvLaneLoc // stCollTrkSysCfg.adiLaneLoc[diClctrResvAtSlotLaneIdx]	// i_diCollMrgStartOffset  ]]>
</Line>
<Line Number="477">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvAtSlotLaneIdx].diSlotSizePls				// i_diCollMrgSlotSize   ]]>
</Line>
<Line Number="478">
<![CDATA[					,MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvAtSlotLaneIdx].diLanePkgSeqId				// i_diCollMrgTrkId		]]>
</Line>
<Line Number="479">
<![CDATA[					,MRG414_diClctrResvAtSlotLaneIdx														// i_diCollMrgLaneId	]]>
</Line>
<Line Number="480">
<![CDATA[		//			,									// o_xCollSlotAtMrg]]>
</Line>
<Line Number="481">
<![CDATA[		//			,									// o_xCollSlotPastMrg]]>
</Line>
<Line Number="482">
<![CDATA[					);]]>
</Line>
<Line Number="483">
<![CDATA[]]>
</Line>
<Line Number="484">
<![CDATA[			// 2014-12-01 Do not use RET instead populate after routine completes]]>
</Line>
<Line Number="485">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvAtSlotLaneIdx].xSlotAtMergePoint := MRG414_o_xCollSlotAtMrg;]]>
</Line>
<Line Number="486">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvAtSlotLaneIdx].xSlotPastMergePoint := MRG414_o_xCollSlotPastMrg;]]>
</Line>
<Line Number="487">
<![CDATA[]]>
</Line>
<Line Number="488">
<![CDATA[]]>
</Line>
<Line Number="489">
<![CDATA[			IF MRG414_o_xCollSlotAtMrg THEN]]>
</Line>
<Line Number="490">
<![CDATA[				MRG414_astLaneClctrSlotResCnts[MRG414_diClctrResvAtSlotLaneIdx].diSlotAtMergeFndCnt := MRG414_astLaneClctrSlotResCnts[MRG414_diClctrResvAtSlotLaneIdx].diSlotAtMergeFndCnt + 1;]]>
</Line>
<Line Number="491">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="492">
<![CDATA[]]>
</Line>
<Line Number="493">
<![CDATA[				// IF the Slot is past the merge point then clear the slot]]>
</Line>
<Line Number="494">
<![CDATA[			IF MRG414_o_xCollSlotPastMrg THEN]]>
</Line>
<Line Number="495">
<![CDATA[]]>
</Line>
<Line Number="496">
<![CDATA[				MRG414_astLaneClctrSlotResCnts[MRG414_diClctrResvAtSlotLaneIdx].diSlotPastMergeCnt :=  MRG414_astLaneClctrSlotResCnts[MRG414_diClctrResvAtSlotLaneIdx].diSlotPastMergeCnt + 1;]]>
</Line>
<Line Number="497">
<![CDATA[]]>
</Line>
<Line Number="498">
<![CDATA[				// Clear the slot of this reservation]]>
</Line>
<Line Number="499">
<![CDATA[				JSR( SR_CollTrackClrSlot]]>
</Line>
<Line Number="500">
<![CDATA[					,4			]]>
</Line>
<Line Number="501">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvAtSlotLaneIdx].diSlotStartLoc 	// i_diCollClrStartIdx]]>
</Line>
<Line Number="502">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvAtSlotLaneIdx].diSlotSizePls 		// i_diCollClrSlotSize]]>
</Line>
<Line Number="503">
<![CDATA[					,MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvAtSlotLaneIdx].diLanePkgSeqId		// i_diCollClrTrkId]]>
</Line>
<Line Number="504">
<![CDATA[					,MRG414_diClctrResvAtSlotLaneIdx												// i_diCollClrLaneId ]]>
</Line>
<Line Number="505">
<![CDATA[					);]]>
</Line>
<Line Number="506">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="507">
<![CDATA[]]>
</Line>
<Line Number="508">
<![CDATA[		(***** 2016-09-21  TBD Do Later]]>
</Line>
<Line Number="509">
<![CDATA[			// 2016-01-04 Check if should clear the Far Reservation flag]]>
</Line>
<Line Number="510">
<![CDATA[			IF stL1_LaneClctrSlotRes.xSlotAtMergePoint ]]>
</Line>
<Line Number="511">
<![CDATA[			  OR stL1_LaneClctrSlotRes.xSlotPastMergePoint ]]>
</Line>
<Line Number="512">
<![CDATA[			  THEN]]>
</Line>
<Line Number="513">
<![CDATA[				diLaneResvFarUpstream_Status := (diLaneResvFarUpstream_Status AND stCollLaneMrgCfg_L1.diLaneAndMask);]]>
</Line>
<Line Number="514">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="515">
<![CDATA[		***********)]]>
</Line>
<Line Number="516">
<![CDATA[]]>
</Line>
<Line Number="517">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="518">
<![CDATA[]]>
</Line>
<Line Number="519">
<![CDATA[	END_FOR; // End of Slot At Merge Poiint loop]]>
</Line>
<Line Number="520">
<![CDATA[]]>
</Line>
<Line Number="521">
<![CDATA[]]>
</Line>
<Line Number="522">
<![CDATA[	// Check if the slot is compromised]]>
</Line>
<Line Number="523">
<![CDATA[	FOR MRG414_diClctrSlotCmpsdLaneIdx := MRG414_stCollTrkSysCfg.diNumLanes  TO 1 BY -1 DO ]]>
</Line>
<Line Number="524">
<![CDATA[		]]>
</Line>
<Line Number="525">
<![CDATA[		// Check if a lane is waiting for its reserved slot]]>
</Line>
<Line Number="526">
<![CDATA[		IF MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSlotCmpsdLaneIdx].xSlotReserved ]]>
</Line>
<Line Number="527">
<![CDATA[  		  AND NOT(MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSlotCmpsdLaneIdx].xSlotAtMergePoint)]]>
</Line>
<Line Number="528">
<![CDATA[		  AND MRG414_stCollTrkSysCfg.xChkForCompromisedSlot]]>
</Line>
<Line Number="529">
<![CDATA[		  THEN]]>
</Line>
<Line Number="530">
<![CDATA[]]>
</Line>
<Line Number="531">
<![CDATA[			MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSlotCmpsdLaneIdx].diSChklotCnt := MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSlotCmpsdLaneIdx].diSChklotCnt  + 1;]]>
</Line>
<Line Number="532">
<![CDATA[]]>
</Line>
<Line Number="533">
<![CDATA[			// Check the Slot]]>
</Line>
<Line Number="534">
<![CDATA[]]>
</Line>
<Line Number="535">
<![CDATA[]]>
</Line>
<Line Number="536">
<![CDATA[			JSR(	SR_CollTrackChkSlot]]>
</Line>
<Line Number="537">
<![CDATA[					,4]]>
</Line>
<Line Number="538">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSlotCmpsdLaneIdx].diSlotStartLoc]]>
</Line>
<Line Number="539">
<![CDATA[					,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSlotCmpsdLaneIdx].diSlotSizePls ]]>
</Line>
<Line Number="540">
<![CDATA[					,MRG414_astLaneClctrSlotResvStat[MRG414_diClctrSlotCmpsdLaneIdx].diLanePkgSeqId]]>
</Line>
<Line Number="541">
<![CDATA[					,MRG414_diClctrSlotCmpsdLaneIdx]]>
</Line>
<Line Number="542">
<![CDATA[		//			,						// o_xCollChkSlotCmpsd]]>
</Line>
<Line Number="543">
<![CDATA[					);]]>
</Line>
<Line Number="544">
<![CDATA[]]>
</Line>
<Line Number="545">
<![CDATA[			// 2014-12-03 Do not use RET statement]]>
</Line>
<Line Number="546">
<![CDATA[			MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrSlotCmpsdLaneIdx].xSlotCompromised := MRG414_o_xCollChkSlotCmpsd;]]>
</Line>
<Line Number="547">
<![CDATA[]]>
</Line>
<Line Number="548">
<![CDATA[]]>
</Line>
<Line Number="549">
<![CDATA[			// IF the Slot is compromised then clear the slot]]>
</Line>
<Line Number="550">
<![CDATA[			IF MRG414_o_xCollChkSlotCmpsd THEN]]>
</Line>
<Line Number="551">
<![CDATA[]]>
</Line>
<Line Number="552">
<![CDATA[			// Clear the slot of this reservation]]>
</Line>
<Line Number="553">
<![CDATA[					// Clear the slot of this reservation]]>
</Line>
<Line Number="554">
<![CDATA[					JSR( SR_CollTrackClrSlot]]>
</Line>
<Line Number="555">
<![CDATA[						,4			]]>
</Line>
<Line Number="556">
<![CDATA[						,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvAtSlotLaneIdx].diSlotStartLoc 	// i_diCollClrStartIdx]]>
</Line>
<Line Number="557">
<![CDATA[						,MRG414_astLaneClctrSlotResvCntrl[MRG414_diClctrResvAtSlotLaneIdx].diSlotSizePls 		// i_diCollClrSlotSize]]>
</Line>
<Line Number="558">
<![CDATA[						,MRG414_astLaneClctrSlotResvStat[MRG414_diClctrResvAtSlotLaneIdx].diLanePkgSeqId		// i_diCollClrTrkId]]>
</Line>
<Line Number="559">
<![CDATA[						,MRG414_diClctrResvAtSlotLaneIdx												// i_diCollClrLaneId ]]>
</Line>
<Line Number="560">
<![CDATA[						);]]>
</Line>
<Line Number="561">
<![CDATA[]]>
</Line>
<Line Number="562">
<![CDATA[				MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSlotCmpsdLaneIdx].diSlotCompromisedCnt := MRG414_astLaneClctrSlotResCnts[MRG414_diClctrSlotCmpsdLaneIdx].diSlotCompromisedCnt + 1;]]>
</Line>
<Line Number="563">
<![CDATA[]]>
</Line>
<Line Number="564">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="565">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="566">
<![CDATA[]]>
</Line>
<Line Number="567">
<![CDATA[	END_FOR; // End of Slot Compromised loop]]>
</Line>
<Line Number="568">
<![CDATA[]]>
</Line>
<Line Number="569">
<![CDATA[]]>
</Line>
<Line Number="570">
<![CDATA[// If not searching for a Slot then Turn off bit in the Global Lane Waiting Status Mask]]>
</Line>
<Line Number="571">
<![CDATA[// Bitwise-AND the Global Waiting Status with our configured AND mask]]>
</Line>
<Line Number="572">
<![CDATA[// TBD diLanesWaitingBitStatus := diLanesWaitingBitStatus AND stL1_LaneCfg.diLaneWaitingMask_AND;]]>
</Line>
<Line Number="573">
<![CDATA[]]>
</Line>
<Line Number="574">
<![CDATA[END_IF;]]>
</Line>
<Line Number="575">
<![CDATA[]]>
</Line>
<Line Number="576">
<![CDATA[// ************ End of Routine ********************]]>
</Line>
<Line Number="577">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="RT_DeltaDist_NoGapStore" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[// *********************************************]]>
</Line>
<Line Number="2">
<![CDATA[//]]>
</Line>
<Line Number="3">
<![CDATA[// Calculation of the distance the Lane conveyors have traveled this scan.]]>
</Line>
<Line Number="4">
<![CDATA[// The current speed for each conveyor is derived from the drive feedback]]>
</Line>
<Line Number="5">
<![CDATA[//]]>
</Line>
<Line Number="6">
<![CDATA[// *********************************************]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[// *********************************************]]>
</Line>
<Line Number="9">
<![CDATA[// Lane 1: Delta Dstance Calculation ]]>
</Line>
<Line Number="10">
<![CDATA[// *********************************************]]>
</Line>
<Line Number="11">
<![CDATA[#region Delta Distance]]>
</Line>
<Line Number="12">
<![CDATA[// Inject Merge Conveyor ]]>
</Line>
<Line Number="13">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[1].rPrevSpd := MRG414_astUNL_MRG_CnvCtrl[1].rCurrSpd;]]>
</Line>
<Line Number="14">
<![CDATA[MRG414_astUNL_MRG_CnvCtrl[1].rCurrSpd := 225/5; ]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[AO_CnvDeltaDist(MRG414_aoUNL_MRG_CnvDeltaDist[1], ]]>
</Line>
<Line Number="17">
