<Routine Name="Scanner" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[/********************************]]>
</Line>
<Line Number="2">
<![CDATA[P504 Scanner]]>
</Line>
<Line Number="3">
<![CDATA[********************************/]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[P504_SCN504.Offset := 19; //6; //2;//  5; //10;  // Data transmit point from conveyor induct PE]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[P504_SCN504.Enable_Token_Expire := 1; //Enable logic to discard Token number after certain conveyor travel distance]]>
</Line>
<Line Number="8">
<![CDATA[P504_SCN504.Token_Expire_Limit := 5; //5;//Token Number will be discarded after this conveyor travel distance + package length (max = 50)]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[P504_SCN504.Enable_ScanData_Expire := 1; //Enable logic to discard scanner data after certain conveyor travel distance]]>
</Line>
<Line Number="11">
<![CDATA[P504_SCN504.ScanData_Expire_Limit := 5; //5; //Scanner data will be discarded after this conveyor travel distance (max = 50)]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[P504_SCN504.ConsecNoRead_Limit := 10; //10; //rigger "Consective NoRead" alarm bit after this many no-read messages (max =50)]]>
</Line>
<Line Number="14">
